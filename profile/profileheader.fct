# ProfileHeader — the block above a profile's timeline: the 3 : 1 banner, the
# oversized avatar overlapping its bottom edge with the follow action opposite,
# then the display name, handle and bio, a "Joined …" line with a calendar
# mark, and the following / followers counts. Sized like a header rather than
# like a feed row, which is what tells you the page changed.
#
#     use ProfileHeader(p.name, p.handle, p.verified, p.bio,
#                       exists(f in Follow where f.follower == actor && f.followee == handle),
#                       p.banner, "March 2024",
#                       count(f in Follow where f.follower == handle),
#                       count(f in Follow where f.followee == handle))
#
# ── EVERYTHING AFTER `following` IS OPTIONAL BY VALUE ─────────────────────────
#
# `banner` "" draws no banner and the avatar sits at the top of the block
# instead of overlapping one (`:has()` is what moves it: the avatar's negative
# margin exists only when there is a banner above it to overlap). `joined` ""
# draws no joined line. The counts are the host's aggregates — the library
# cannot know what a follow is — and a host with no Follow entity passes 0 and
# gets "0 Following · 0 Followers", which is the truth about that host.
#
# `joined` is TEXT, not a timestamp: "March 2024" is a phrase and the host owns
# the phrasing (`content/datestamp.fct` spells a date; a profile wants a month).
#
# The Posts / Replies / Media tabs are not here. They hold the host's lists,
# so they are the host's `tabs`, rendered directly under this block.
import "../ui/avatar.fct"
import "../ui/verifiedbadge.fct"
import "../ui/icon.fct"
import "../social/followbutton.fct"
app FacetProfile:
    css:
        [data-fa-mount] .x-profile { padding: 0 0 12px; border-bottom: 1px solid var(--x-line, #2f3336); }
        [data-fa-mount] .x-profile-banner { display: block; width: 100%; height: auto; aspect-ratio: 3 / 1;
                            object-fit: cover; border-radius: 0; }
        [data-fa-mount] .x-profile-top { display: flex; align-items: flex-end; justify-content: space-between;
                         padding: 12px 16px 0; border: none; background: none; }
        # The avatar is named by the row it sits in, not by `.x-profile`, so the
        # rule cannot reach the banner, which is also an image.
        [data-fa-mount] .x-profile-top .fa-image { width: 133px; height: 133px;
                         border: 4px solid var(--fa-bg); box-sizing: border-box; }
        [data-fa-mount] .x-profile:has(.x-profile-banner) .x-profile-top .fa-image { margin-top: -66px; }
        [data-fa-mount] .x-profile-body { padding: 8px 16px 0; }
        [data-fa-mount] .x-profile-body > div:empty:not([class]) { display: none; }
        [data-fa-mount] .x-display { font-size: 20px; font-weight: 800; }
        [data-fa-mount] .x-bio { font-size: 15px; margin-top: 12px; }
        [data-fa-mount] .x-profile-meta { display: flex; align-items: center; gap: 6px; margin-top: 12px;
                          color: var(--fa-muted); font-size: 15px; }
        [data-fa-mount] .x-profile-stats { display: flex; gap: 20px; margin-top: 12px;
                           color: var(--fa-muted); font-size: 15px; }
        [data-fa-mount] .x-profile-stats > .fa-row { gap: 4px; align-items: baseline; }
        [data-fa-mount] .x-profile-stat-n { color: var(--fa-fg); font-weight: 700; }
    component ProfileHeader(name: text, handle: text, verified: bool, bio: text, following: bool, banner: text, joined: text, follows: int, followers: int):
        box class "x-profile":
            if banner != "":
                image "{banner}" class "x-profile-banner"
            row class "x-profile-top":
                use Avatar(name)
                use FollowButton(handle, following)
            box class "x-profile-body":
                row class "x-identity":
                    text "{name}" class "x-display"
                    use VerifiedBadge(verified)
                text "@{handle}" class "x-handle"
                text "{bio}" class "x-bio"
                if joined != "":
                    row class "x-profile-meta":
                        icon "calendar"
                        text "Joined {joined}"
                row class "x-profile-stats":
                    row:
                        text "{commas(follows)}" class "x-profile-stat-n"
                        text "Following"
                    row:
                        text "{commas(followers)}" class "x-profile-stat-n"
                        text "Followers"
