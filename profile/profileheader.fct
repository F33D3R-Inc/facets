# ProfileHeader — the block above a profile's timeline: a large avatar with the
# follow action opposite it, then the display name, handle and bio. Sized like a
# header rather than like a feed row, which is what tells you the page changed.
import "../ui/avatar.fct"
import "../ui/verifiedbadge.fct"
import "../social/followbutton.fct"
app FacetProfile:
    css:
        [data-fa-mount] .x-profile { padding: 16px; border-bottom: 1px solid var(--x-line, #2f3336); }
        [data-fa-mount] .x-profile-top { display: flex; align-items: flex-start; justify-content: space-between; }
        [data-fa-mount] .x-profile .fa-image { width: 133px; height: 133px; }
        [data-fa-mount] .x-display { font-size: 20px; font-weight: 800; }
        [data-fa-mount] .x-bio { font-size: 15px; margin-top: 12px; }
    component ProfileHeader(name: text, handle: text, verified: bool, bio: text, following: bool):
        box class "x-profile":
            row class "x-profile-top":
                use Avatar(name)
                use FollowButton(handle, following)
            row class "x-identity":
                text "{name}" class "x-display"
                use VerifiedBadge(verified)
            text "@{handle}" class "x-handle"
            text "{bio}" class "x-bio"
