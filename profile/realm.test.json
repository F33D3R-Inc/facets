    {
      "name": "XP is awarded only through the @internal actions, onto the product's Account and XpEvent rows: per-action amounts, post and follower milestones once each as Achievement rows, realm achievements at Adept and Guardian; a grant is an operator's floor; the founder role floors at Guardian",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada",
                "xp": 0,
                "realm": 1,
                "platform_role": ""
              },
              {
                "handle": "zed",
                "xp": 0,
                "realm": 1,
                "platform_role": "founder"
              }
            ]
          }
        },
        {
          "run": "awardXP",
          "args": [
            1,
            "post",
            "w1"
          ]
        },
        {
          "run": "checkMilestones",
          "args": [
            1,
            1,
            0
          ]
        },
        {
          "expect": "Account(1).xp",
          "equals": 100
        },
        {
          "expect": "xpOf(1)",
          "equals": 100
        },
        {
          "expect": "hasAchievement(1, \"first_post\")",
          "equals": true
        },
        {
          "expect": "count(e in Achievement where e.slug == \"first_post\" && e.name == \"First Steps\" && e.rarity == \"bronze\")",
          "equals": 1
        },
        {
          "run": "awardXP",
          "args": [
            1,
            "post",
            "w2"
          ]
        },
        {
          "run": "checkMilestones",
          "args": [
            1,
            2,
            0
          ]
        },
        {
          "expect": "count(e in Achievement where e.slug == \"first_post\")",
          "equals": 1
        },
        {
          "run": "awardXP",
          "args": [
            1,
            "like",
            "w9"
          ]
        },
        {
          "run": "awardXP",
          "args": [
            1,
            "reply",
            "w9"
          ]
        },
        {
          "run": "checkMilestones",
          "args": [
            1,
            2,
            1
          ]
        },
        {
          "expect": "Account(1).xp",
          "equals": 240
        },
        {
          "expect": "hasAchievement(1, \"first_follower\")",
          "equals": true
        },
        {
          "run": "checkMilestones",
          "args": [
            1,
            10,
            10
          ]
        },
        {
          "expect": "hasAchievement(1, \"post_10\") && hasAchievement(1, \"followers_10\")",
          "equals": true
        },
        {
          "run": "awardXP",
          "args": [
            1,
            "nonsense",
            ""
          ]
        },
        {
          "expect": "Account(1).xp",
          "equals": 240
        },
        {
          "expect": "count(XpEvent)",
          "equals": 4
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setRealmGrant",
          "args": [
            "ada",
            5
          ],
          "fails": "only an operator"
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "setRealmGrant",
          "args": [
            "ada",
            4
          ]
        },
        {
          "expect": "Account(1).realm",
          "equals": 4
        },
        {
          "expect": "hasAchievement(1, \"realm_adept\")",
          "equals": true
        },
        {
          "expect": "hasAchievement(1, \"realm_guardian\")",
          "equals": false
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "setRealmGrant",
          "args": [
            "ada",
            0
          ]
        },
        {
          "expect": "Account(1).realm",
          "equals": 1
        },
        {
          "run": "awardXP",
          "args": [
            2,
            "like",
            ""
          ]
        },
        {
          "expect": "Account(2).realm",
          "equals": 5
        },
        {
          "expect": "hasAchievement(2, \"realm_guardian\")",
          "equals": true
        }
      ]
    }
  ]
}