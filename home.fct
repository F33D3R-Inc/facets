# f33d3r home (plain-app composition track) — assembles the reusable component
# atoms (Avatar/VerifiedBadge/UserChip/PostCard/ComposeBox/FollowButton/Trend/
# ProfileHeader/EngagementBar/NotificationItem/UnreadBadge) into a whole site:
# home, profile, post detail, notifications and search, all sharing one `Shell`
# layout. Demonstrates the *component* facet type, vs the typed-brick stack in
# f33d3r.fct (playground/wireframe/ui/data).
#
# The SAME component atoms also compose into the LAYERED (playground) build via the
# data facet — one atom set, both tracks (v1.17.0 closed the shareable-component gap).
#
#   facet dev library/home.fct
import "social/postcard.fct"
import "social/composebox.fct"
import "social/whotofollow.fct"
import "social/followbutton.fct"
import "social/engagementbar.fct"
import "forms/searchbox.fct"
import "profile/profileheader.fct"
import "notify/notificationitem.fct"
import "notify/unreadbadge.fct"
import "ui/userchip.fct"
# The rail's four marks. `icon "home"` places a span and the runtime draws nothing
# into it; `ui/icon.fct` is the set that fills it, so the import is what makes the
# nav rail visible at all.
import "ui/icon.fct"
import "ui/trend.fct"

app F33D3RHome:
    auth
    theme:
        bg "#15202b"
        fg "#f7f9f9"
        muted "#8b98a5"
        accent "#1d9bf0"
        border "#38444d"
        card-border "#38444d"
        radius "16px"
        maxwidth "1100px"

    # ── the look ────────────────────────────────────────────────────────────────
    # The default stylesheet the runtime ships is deliberately plain: it makes every
    # box a bordered card so that ANY app renders legibly with no design work at all.
    # That is the right default and the wrong finish — a timeline of bordered cards
    # floating in a column is not what a social feed looks like. So this is the one
    # place F33D3R states its own visual language, and every class below is applied
    # by a facet, not by the runtime.
    #
    # Every selector is anchored on `[data-fa-mount]`, the app root, for a reason
    # that is specificity and not taste. The rule being overridden is
    # `.fa-box .fa-box` — two classes — so a bare `.x-post` (one class) loses to it
    # no matter what order the stylesheets are in, and the cards stay. The anchor is
    # an attribute selector, worth the same as a class, so every rule here is worth
    # two and the later stylesheet wins. It cannot be `#fa-root`: `#` opens a
    # comment in this language, and a `#`-anchored rule is silently dropped rather
    # than rejected — which is exactly how the first version of this block was
    # written and why every post still had a border.
    #
    # Two rules do the heavy lifting:
    #   * boxes stop being cards. The default nested-box border is turned off and
    #     re-applied only where something really is a panel.
    #
    # What is NOT here: every rule for a class an *atom* applies. Those ship with
    # the atom, in its own `css:` block, because a facet that renders a grid and
    # leaves the grid rule in one host app is not distributable — the layered
    # track (`f33d3r.fct`) composes the same atoms and got `css: null`, so every
    # one of them rendered unstyled there.
    #   * the shell is a grid, not three flexed columns. A feed has a fixed readable
    #     width; the rails do not grow to fill a wide monitor.
    css:
        :root { --x-line: #2f3336; --x-panel: #16181c; --x-hover: rgba(239,243,244,.06); }
        body { margin: 0; max-width: none; padding: 0; background: var(--fa-bg); }

        [data-fa-mount] .fa-box { border: none; border-radius: 0; padding: 0; gap: 0; background: none; }
        [data-fa-mount] .fa-row { gap: 0; }
        [data-fa-mount] button { border: none; background: none; color: inherit; padding: 0; border-radius: 9999px; }
        [data-fa-mount] button:hover { color: inherit; }

        # The three columns. `minmax(0,600px)` is what stops a long unbroken word in
        # a post from widening the whole feed and pushing the rails off screen.
        [data-fa-mount] .x-shell { display: grid; grid-template-columns: 275px minmax(0,600px) 350px;
                   justify-content: center; align-items: start; gap: 0; min-height: 100vh; }

        # Left rail. Sticky, because a nav that scrolls away is a nav you cannot use.
        [data-fa-mount] .x-nav { position: sticky; top: 0; height: 100vh; padding: 4px 8px 12px;
                 display: flex; flex-direction: column; align-items: stretch; }
        [data-fa-mount] .x-brand { font-size: 26px; padding: 12px; }
        [data-fa-mount] .x-navlink { display: flex; align-items: center; gap: 18px; padding: 12px;
                     border-radius: 9999px; font-size: 20px; width: fit-content; }
        [data-fa-mount] .x-navlink:hover { background: var(--x-hover); }
        [data-fa-mount] .x-navlink .fa-link { color: var(--fa-fg); text-decoration: none; }
        [data-fa-mount] .x-post-btn button { background: var(--fa-accent); color: #fff; font-weight: 700;
                             font-size: 17px; padding: 15px 0; width: 90%; margin: 12px 0;
                             border-radius: 9999px; }
        [data-fa-mount] .x-post-btn button:hover { filter: brightness(1.08); }
        [data-fa-mount] .x-whoami { margin-top: auto; padding: 12px; color: var(--fa-muted); font-size: 14px; }
        [data-fa-mount] .x-whoami button { color: var(--fa-muted); font-size: 14px; }
        [data-fa-mount] .x-whoami button:hover { color: var(--fa-fg); }

        # Centre column: hairlines on both sides, and posts divided rather than boxed.
        [data-fa-mount] .x-feed { border-inline: 1px solid var(--x-line); min-height: 100vh; }

        # Tabs across the top of the feed, full width and equal.
        [data-fa-mount] .x-tabs .fa-tabstrip { border-bottom: 1px solid var(--x-line); }
        [data-fa-mount] .x-tabs .fa-tab { flex: 1; padding: 16px 0; font-size: 15px; font-weight: 600; }
        [data-fa-mount] .x-tabs .fa-tab[aria-selected=true] { border-bottom-width: 4px; }

        # Right rail: panels, sticky, and a heading that is actually a heading.
        [data-fa-mount] .x-aside { position: sticky; top: 0; padding: 12px 0 12px 28px; }
        [data-fa-mount] .x-panel { background: var(--x-panel); border-radius: 16px; margin-bottom: 16px;
                   overflow: hidden; }
        [data-fa-mount] .x-panel-title { font-size: 20px; font-weight: 800; padding: 12px 16px; }
        # Section headings and empty states, which belong to the page rather
        # than to any atom.
        [data-fa-mount] .x-section { font-size: 20px; font-weight: 800; padding: 16px; }
        [data-fa-mount] .x-empty { color: var(--fa-muted); padding: 32px 16px; text-align: center; }

        # Narrow viewports. The rails are laid out for a desktop three-column page;
        # below 1100px the right one goes, and below 700px the shell becomes a single
        # column. The nav does NOT go with it — a phone with no way to reach
        # notifications, search or log out is not a smaller version of the app, it is
        # a broken one — so it un-sticks and lays itself out as a horizontal bar
        # above the feed.
        @media (max-width: 1100px) {
            [data-fa-mount] .x-shell { grid-template-columns: minmax(0,600px) 350px; }
            [data-fa-mount] .x-nav { display: none; }
        }
        @media (max-width: 820px) {
            [data-fa-mount] .x-shell { grid-template-columns: minmax(0,1fr); }
            [data-fa-mount] .x-aside { display: none; }
            [data-fa-mount] .x-nav { display: flex; flex-direction: row; flex-wrap: wrap;
                       align-items: center; gap: 4px; position: static; height: auto;
                       border-bottom: 1px solid var(--x-line); }
            [data-fa-mount] .x-nav .x-brand { font-size: 20px; padding: 8px 12px; }
            [data-fa-mount] .x-navlink { font-size: 15px; padding: 8px 10px; gap: 8px; }
            [data-fa-mount] .x-post-btn { margin-left: auto; }
            [data-fa-mount] .x-post-btn button { width: auto; padding: 8px 18px; margin: 0 8px; font-size: 15px; }
            [data-fa-mount] .x-whoami { margin-top: 0; }
        }

    enum Kind: text, richtext, video

    entity Tweet:
        id: int
        author: text
        handle: text
        verified: bool
        kind: Kind
        body: text
        media: text
        created: int
    entity Like:
        id: int
        tweet: Tweet
        user: text
    entity Repost:
        id: int
        tweet: Tweet
        user: text
    entity Bookmark:
        id: int
        tweet: Tweet
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text
    # Reply — a post's conversation. It is what makes /post/:id more than a second
    # rendering of the feed row, and it gives the EngagementBar a real reply count
    # instead of the 0 the home feed used to pass.
    entity Reply:
        id: int
        tweet: Tweet
        author: text
        body: text
        created: int
    # Profile — the durable half of a user identity (display name, bio, check). The
    # handle is the key the /profile/:handle route matches on; a user with no row
    # yet still has a profile page, rendered from the route parameter alone.
    entity Profile:
        id: int
        handle: text
        name: text
        bio: text
        verified: bool
    # Notification — one row of "someone did something to you". Written by the same
    # actions that cause it (like/repost/follow/reply each fan one out), read back
    # by /notifications through the notify/ atoms.
    entity Notification:
        id: int
        user: text
        who: text
        verb: text
        subject: text
        read: bool
        created: int

    state draft: text = "" @client
    state feedTab: text = "foryou" @client
    state q: text = "" @client
    state shown: int = 20 @client
    state replyDraft: text = "" @client
    state bioDraft: text = "" @client
    state nameDraft: text = "" @client

    policy member:
        actor != "guest"

    # A row-level policy: the argument is the row being acted on, so the check is
    # about *this* notification rather than about the caller in general. Without
    # it `markRead(id)` matched on id alone and any member could silently mark
    # another member's notification read.
    policy ownsNotification(id: int):
        Notification(id).user == actor

    # The nav's Post button lives in the layout, so it renders on pages that have
    # no composer and therefore no `draft` — this refuses that click instead of
    # appending an empty post to the timeline.
    action post(body: text):
        requires member
        check body != "" "say something"
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", created: now() }
    action like(id: int):
        requires member
        add Like { tweet: id, user: actor }
        add Notification { user: Tweet(id).author, who: actor, verb: "liked your post", subject: Tweet(id).body, read: false, created: now() }
    action repost(id: int):
        requires member
        add Repost { tweet: id, user: actor }
        add Notification { user: Tweet(id).author, who: actor, verb: "reposted", subject: Tweet(id).body, read: false, created: now() }
    action bookmark(id: int):
        requires member
        add Bookmark { tweet: id, user: actor }
    action follow(handle: text):
        requires member
        add Follow { follower: actor, followee: handle }
        add Notification { user: handle, who: actor, verb: "followed you", subject: "", read: false, created: now() }
    action unfollow(handle: text):
        requires member
        remove f in Follow where f.follower == actor && f.followee == handle
    action reply(id: int, body: text):
        requires member
        check body != "" "say something"
        add Reply { tweet: id, author: actor, body: body, created: now() }
        add Notification { user: Tweet(id).author, who: actor, verb: "replied to your post", subject: body, read: false, created: now() }
    # saveProfile is an upsert spelled in two statements: drop the actor's old row,
    # write the new one. The handle is always the actor's — you edit your own card.
    # The two `check`s are load-bearing, not politeness. `nameDraft`/`bioDraft` are
    # @client cells that start empty and are not seeded from the saved row, so the
    # form renders blank over an existing profile — and without these, clicking
    # Save with an untouched form wrote `name: ""`, `bio: ""` and blanked it.
    #
    # `verified` is carried across the upsert rather than re-stated, because
    # re-stating it as `false` meant editing a bio permanently removed a check
    # mark that nothing in the app can restore.
    action saveProfile(name: text, bio: text):
        requires member
        check name != "" "a display name is required"
        check bio != "" "a bio is required"
        remove p in Profile where p.handle == actor
        add Profile { handle: actor, name: name, bio: bio, verified: exists(p in Profile where p.handle == actor && p.verified) }
    action markRead(id: int):
        requires ownsNotification(id)
        set Notification(id).read = true
    action clearNotifications:
        requires member
        remove n in Notification where n.user == actor

    # Shell — the chrome every screen shares: the left nav rail (which is what makes
    # notifications and search reachable by a click from anywhere) and the right
    # "what's happening" rail. Each view drops into the `slot`.
    layout Shell:
        row class "x-shell":
            box class "x-nav":
                text "𝕏" class "x-brand"
                row class "x-navlink":
                    icon "home"
                    link "Home" -> "/"
                row class "x-navlink":
                    icon "search"
                    link "Explore" -> "/search"
                row class "x-navlink":
                    icon "bell"
                    link "Notifications" -> "/notifications"
                    use UnreadBadge(count(n in Notification where n.user == actor && !n.read))
                box class "x-post-btn":
                    button "Post" -> post(draft)
                row class "x-navlink":
                    icon "user"
                    link "Profile" -> "/profile/{actor}"
                box class "x-whoami":
                    text "signed in as {actor}"
                    button "log out" -> logout
            box class "x-feed":
                slot
            box class "x-aside":
                use SearchBox()
                box class "x-panel":
                    text "What's happening" class "x-panel-title"
                    use Trend("Tech", "#FacetLang", "1,234 posts")
                    use Trend("News", "#Facet", "987 posts")
                box class "x-panel":
                    text "Who to follow" class "x-panel-title"
                    use WhoToFollow("Grace Hopper", "grace", true, exists(f in Follow where f.follower == actor && f.followee == "grace"))
                    use WhoToFollow("Alan Turing", "alan", false, exists(f in Follow where f.follower == actor && f.followee == "alan"))

    view Home at "/" in Shell:
        meta title "Home / F33D3R"
        meta description "What's happening, newest first."
        box:
            use ComposeBox()
            tabs bind feedTab class "x-tabs":
                tab "For you" -> "foryou":
                    for t in Tweet where contains(lower(t.body), lower(q)) by created desc limit shown:
                        use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, count(l in Like where l.tweet == t.id), count(r in Reply where r.tweet == t.id), count(r in Repost where r.tweet == t.id))
                tab "Following" -> "following":
                    for t in Tweet where exists(f in Follow where f.follower == actor && f.followee == t.author) by created desc limit shown:
                        use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, count(l in Like where l.tweet == t.id), count(r in Reply where r.tweet == t.id), count(r in Repost where r.tweet == t.id))

    # Profile — the ProfileHeader atom over that user's posts. A user who has saved
    # a Profile row renders from it; one who has not still gets a page, rendered
    # from the `:handle` route parameter alone, so no profile link is ever a 404.
    view Profile at "/profile/:handle" in Shell:
        meta title "{handle} (@{handle}) / F33D3R"
        meta description "Posts by @{handle}."
        box:
            for p in Profile where p.handle == handle by id desc limit 1:
                use ProfileHeader(p.name, p.handle, p.verified, p.bio, exists(f in Follow where f.follower == actor && f.followee == handle))
            if !exists(p in Profile where p.handle == handle):
                use ProfileHeader(handle, handle, false, "No bio yet.", exists(f in Follow where f.follower == actor && f.followee == handle))
            if handle == actor:
                box:
                    input bind nameDraft placeholder "display name"
                    input bind bioDraft placeholder "bio"
                    button "Save profile" -> saveProfile(nameDraft, bioDraft)
            text "Posts" class "x-section"
            for t in Tweet where t.author == handle by created desc limit shown:
                use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, count(l in Like where l.tweet == t.id), count(r in Reply where r.tweet == t.id), count(r in Repost where r.tweet == t.id))

    # Post detail — one post opened on its own, with the EngagementBar over real
    # counts and the conversation under it. The post is matched by row rather than
    # read with `Tweet(id)` so that `t.id` — a real int — is what reaches the
    # engagement actions; the `:id` route parameter itself is text.
    view PostDetail at "/post/:id" in Shell:
        meta title "{Tweet(id).author} on F33D3R"
        meta description "{Tweet(id).body}"
        box:
            for t in Tweet where t.id == id by id desc limit 1:
                box:
                    use UserChip(t.author, t.handle, t.verified)
                    match t.kind:
                        case "richtext":
                            richtext "{t.body}"
                        case "video":
                            video "{t.media}"
                        else:
                            text "{t.body}"
                    use EngagementBar(t.id, count(l in Like where l.tweet == t.id), count(r in Reply where r.tweet == t.id), count(r in Repost where r.tweet == t.id))
                    row:
                        input bind replyDraft placeholder "Post your reply"
                        button "Reply" -> reply(t.id, replyDraft)
            if !exists(t in Tweet where t.id == id):
                text "This post no longer exists." class "x-empty"
            text "Replies" class "x-section"
            for r in Reply where r.tweet == id by created desc limit 50:
                box:
                    use UserChip(r.author, r.author, false)
                    text "{r.body}"

    # Notifications — the notify/ atoms over the rows the like/repost/follow/reply
    # actions fanned out. The ✓ marks one read; "Clear all" empties the inbox.
    view Notifications at "/notifications" in Shell:
        meta title "Notifications / F33D3R"
        box:
            row:
                text "Notifications"
                use UnreadBadge(count(n in Notification where n.user == actor && !n.read))
                button "Clear all" -> clearNotifications
            for n in Notification where n.user == actor by created desc limit 50:
                row:
                    use NotificationItem(n.who, n.verb, n.subject, !n.read)
                    if !n.read:
                        button "✓" -> markRead(n.id)

    # Search — the same SearchBox atom the home feed binds, given its own screen so
    # the nav can point at it. Posts and people, both filtered by the `q` cell.
    # No SearchBox here: the layout's right rail already renders one bound to `q`.
    # Two inputs on one cell visibly disagree while typing, because the client
    # only syncs the value of the input that is not focused.
    view Search at "/search" in Shell:
        meta title "Search / F33D3R"
        box:
            text "Posts matching \"{q}\"" class "x-section"
            for t in Tweet where contains(lower(t.body), lower(q)) by created desc limit shown:
                use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, count(l in Like where l.tweet == t.id), count(r in Reply where r.tweet == t.id), count(r in Repost where r.tweet == t.id))
            text "People" class "x-section"
            for p in Profile where contains(lower(p.handle), lower(q)) by id desc limit 10:
                use WhoToFollow(p.name, p.handle, p.verified, exists(f in Follow where f.follower == actor && f.followee == p.handle))
