{
  "tests": [
    {
      "name": "liveplayer: the row shape it expects seeds and reads",
      "steps": [
        {
          "seed": {
            "Stream": [
              {
                "hls": "x",
                "live": true,
                "startedAt": 1,
                "thumb": "x",
                "title": "x",
                "viewers": 1
              }
            ]
          }
        },
        {
          "expect": "count(Stream)",
          "equals": 1
        },
        {
          "expect": "Stream(1).hls",
          "equals": "x"
        }
      ]
    }
  ]
}
