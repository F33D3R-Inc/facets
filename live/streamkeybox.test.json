{
  "tests": [
    {
      "name": "streamkeybox: the row shape it expects seeds and reads",
      "steps": [
        {
          "seed": {
            "StreamKey": [
              {
                "key": "x",
                "owner": "x"
              }
            ]
          }
        },
        {
          "expect": "count(StreamKey)",
          "equals": 1
        },
        {
          "expect": "StreamKey(1).key",
          "equals": "x"
        }
      ]
    }
  ]
}
