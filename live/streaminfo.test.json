{
  "tests": [
    {
      "name": "streaminfo: the row shape it expects seeds and reads; the actions it expects are invocable with the declared signature",
      "steps": [
        {
          "seed": {
            "Stream": [
              {
                "category": "x",
                "owner": "x",
                "tags": "x",
                "title": "x",
                "verified": true
              }
            ]
          }
        },
        {
          "expect": "count(Stream)",
          "equals": 1
        },
        {
          "expect": "Stream(1).category",
          "equals": "x"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unfollow",
          "args": [
            "x"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "x"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unsubscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "subscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unsubscribeTier",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "subscribeTier",
          "args": [
            1,
            1
          ]
        }
      ]
    }
  ]
}
