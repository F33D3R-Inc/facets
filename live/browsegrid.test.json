{
  "tests": [
    {
      "name": "browsegrid: the row shape it expects seeds and reads",
      "steps": [
        {
          "seed": {
            "Stream": [
              {
                "category": "x",
                "live": true
              }
            ]
          }
        },
        {
          "expect": "count(Stream)",
          "equals": 1
        },
        {
          "expect": "Stream(1).category",
          "equals": "x"
        }
      ]
    }
  ]
}
