# Sheet — a panel that rises from the BOTTOM edge of the viewport: a share
# panel, a gift/emote picker, a comment composer opened from a feed row — the
# mobile-native answer to a dialog that `ui/modal.fct` already gives the desktop
# one. Built on the exact `toggle` + `overlay bind` pair every dialog in this
# library is: the toggle is the only writer of the cell, the overlay is a
# reader, and there is no second source of truth to get out of step.
#
#     state shareOpen: bool = false @client
#
#     use ToggleButton("Share", shareOpen)
#     use Sheet("Share this post", shareOpen):
#         use SheetRow():
#             button "Copy link" -> copyLink(id)
#         use SheetRow():
#             button "Send in a message" -> openDM(id)
#         use SheetClose("Cancel", shareOpen)
#
# ── WHY THIS IS NOT `Drawer` WITH A DIFFERENT EDGE ────────────────────────────
#
# `ui/drawer.fct` already proves an edge panel is expressible without an anchor
# measurement — `overlay` has no idea where its trigger sits, so every panel this
# library draws is positioned relative to the VIEWPORT, never to a control. A
# drawer commits to that full-height: it is a navigation pane or a filter rail,
# and content inside it is expected to fill the edge it came from. A sheet is
# shorter on purpose — it holds a handful of choices, not a page — so it sizes to
# its content, caps at a fraction of the viewport, and scrolls its OWN inside
# rather than stretching to the bottom of the screen the way a drawer does. Two
# different objects sharing one technique, which is exactly the relationship
# `Drawer`'s own file describes for `Modal`.
#
# THE GRAB HANDLE IS DECORATION, NOT A CONTROL. There is no drag gesture this
# language can express — no pointer events, no threshold, nothing but `toggle`
# and `overlay` — so the small bar at the top is the universal signifier for
# "this can be a sheet" and nothing more; dismissal is still the backdrop, or any
# `ToggleButton`/`SheetClose` on the same cell, exactly as `Modal` documents.
import "togglebutton.fct"
app FacetUI:
    css:
        [data-fa-mount] .x-sheet-ov .fa-overlay-backdrop { align-items: flex-end;
                      justify-content: center; padding: 0; }
        [data-fa-mount] .x-sheet-ov .fa-overlay-panel { display: flex; flex-direction: column;
                      gap: 4px; box-sizing: border-box; width: 100%; max-width: 560px;
                      max-height: 80vh; overflow-y: auto; padding: 8px 4px calc(20px + env(safe-area-inset-bottom, 0px));
                      border-radius: 20px 20px 0 0; border: none;
                      border-top: 1px solid var(--x-line, #2f3336);
                      background: var(--fa-bg); color: var(--fa-fg);
                      box-shadow: 0 -12px 40px rgba(0,0,0,.45); }
        [data-fa-mount] .x-sheet-handle { width: 36px; height: 4px; margin: 6px auto 4px;
                      border-radius: 9999px; background: var(--x-line, #2f3336); }
        [data-fa-mount] .x-sheet-title { display: block; padding: 4px 16px 8px;
                       font-size: 17px; font-weight: 800; text-align: center; }
        [data-fa-mount] .x-sheet-row { display: flex; align-items: center; gap: 12px;
                      padding: 14px 16px; border-radius: 12px; font-size: 16px;
                      border: none; background: none; }
        [data-fa-mount] .x-sheet-row:hover { background: var(--x-hover, rgba(239,243,244,.06)); }
        [data-fa-mount] .x-sheet-row button { width: 100%; text-align: left; font: inherit;
                      color: inherit; }
        [data-fa-mount] .x-sheet-close { margin-top: 8px; padding: 14px 16px 4px;
                       border-top: 1px solid var(--x-line, #2f3336); }
        [data-fa-mount] .x-sheet-close .fa-toggle { display: flex; justify-content: center;
                       width: 100%; padding: 10px; border-radius: 9999px; font-weight: 700;
                       background: var(--x-hover, rgba(239,243,244,.06)); cursor: pointer; }
        [data-fa-mount] .x-sheet-close .fa-toggle input { position: absolute; width: 1px;
                       height: 1px; opacity: 0; margin: 0; }
        # An `if`/`use` region that rendered nothing must not cost a gap between
        # the handle, the title and the first row.
        [data-fa-mount] .x-sheet-ov .fa-overlay-panel > div:empty:not([class]) { display: none; }
    component Sheet(title: text, open: cell bool):
        overlay bind open class "x-sheet-ov":
            box class "x-sheet-handle"
            if title != "":
                text "{title}" class "x-sheet-title"
            slot
    # One choice in the sheet — a button, full-width, left-aligned, no border of
    # its own. The slot rather than a `label: text` parameter because a share
    # sheet's row wants an icon in front of the words as often as it wants plain
    # text, and this file has no opinion about which.
    component SheetRow():
        row class "x-sheet-row":
            slot
    component SheetClose(label: text, open: cell bool):
        box class "x-sheet-close":
            toggle bind open label "{label}"
