# Icon — the set of marks the `icon` node draws, and the technique that draws
# them.
#
#     use Icon("search")
#     use SidebarItem("home", "Home", "/")
#     use FeatureItem("lock", "Encrypted at rest", "Every field, every backup.")
#
# ── WHY THIS FILE EXISTS AT ALL ───────────────────────────────────────────────
#
# `icon "search"` compiles to `<span class="fa-icon" data-fa-icon="search">`, and
# the runtime's own rule for it is `background: var(--fa-icon-bg, none)`. That is
# the language shipping the NODE and no set, deliberately — a set baked into a
# compiler is a set every app then fights — and it is the right call for a
# compiler. It is the wrong place for a component library to stop: with no set
# defined anywhere, `FeatureItem`, `SidebarItem` and `Nav` each accept a glyph
# name, place an element for it, and draw NOTHING. A component library whose
# `icon` node is invisible is not a component library, so the set lives here, one
# level above the language and one level below the app, where a host can override
# a single name without forking a compiler.
#
# ── THE GLYPH IS A MASK, NOT A BACKGROUND IMAGE ───────────────────────────────
#
# A data-URI SVG used as `background-image` has its colour baked in at author
# time. That means one copy per theme, and a mark that can never be the accent,
# never follow `currentColor` into a hover state, and never match the text it sits
# beside. `mask` uses only the image's ALPHA and paints `currentColor` through it,
# so ONE definition per glyph is correct in light, in dark, in an accent-coloured
# feature grid, and inside any rule that sets a colour — `.x-feature .fa-icon`
# already does exactly that.
#
# `-webkit-mask` is written beside `mask` because the unprefixed property is still
# newer than the browsers people actually have.
#
# ── THE DEFAULT IS AN EMPTY SVG, NOT `none` ───────────────────────────────────
#
# An unset custom property makes the whole `mask` declaration invalid, and an
# element with `background: currentColor` and no mask is a SOLID BLOCK of text
# colour — an unknown glyph name would draw a filled square where a mark was
# meant to be, which is worse than drawing nothing. So `--x-icon` defaults to a
# valid, empty SVG: an unknown name masks to nothing, on purpose. `icon ""` never
# reaches this rule at all, because the two facets that take a glyph both guard it
# with `if glyph != ""`.
#
# ── WHAT IS IN THE SET, AND WHAT IS NOT ───────────────────────────────────────
#
# Fifty-four marks: getting around, doing something, being told something,
# people, files and media, and the social set — reply, repost, heart, bookmark,
# chart, pin, and the rest of what an engagement bar and an app rail draw. They
# are the marks a settings page, a rail, a table toolbar, a feature grid and a
# timeline need, and they are drawn on one 24-unit grid with one stroke weight so
# a row of them reads as one family.
#
# ── THE SAME MARK ON A BUTTON OR A LINK ───────────────────────────────────────
#
# A `button` and a `link` render their label and nothing else: no child nodes, so
# no `icon` inside one. That is the whole engagement bar — a heart with a count
# on it is a BUTTON, and a button cannot hold an icon node. So every name below
# is also a class: `button "12" -> like(id) class "x-glyph-heart"` draws the heart
# in a `::before` ahead of the label, from the same rule the node uses, in
# `currentColor` like the node does. Colour the button and the mark follows,
# which is how a bar turns a heart pink on hover without a second glyph. A
# button with an empty label is just the mark.
#
# The default mask is set on the ELEMENT, not on the `::before`, on purpose: a
# custom property declared on the pseudo-element would beat the one inherited
# from `.x-glyph-heart`, and every glyph button would mask to nothing.
#
# THERE ARE NO BRAND LOGOS AND THERE WILL NOT BE. A logo is someone else's
# trademark on a licence this library does not hold, it dates the moment the brand
# rebrands, and it is never general — an app that needs one ships it itself, with
# a rule of exactly the same shape as the ones below.
#
# The site-specific marks f33d3r.com draws (`compute`, `disk`, `binary`, `tree`)
# stay in the site. A mark that names a product concept belongs to the product.
#
# ── ADDING ONE ────────────────────────────────────────────────────────────────
#
# One rule, setting `--x-icon` to a data-URI SVG, whose selector names BOTH
# forms — `[data-fa-icon="NAME"], .x-glyph-NAME` — so the class works for the new
# mark too. Keep `viewBox='0 0 24 24'`,
# `fill='none'`, `stroke='black'` (the colour is discarded — only alpha is read),
# `stroke-width='1.7'` and round caps and joins, or the new mark will not sit with
# the others. Use SINGLE quotes inside the URL and no `#` anywhere: `#` opens a
# comment in this language and would silently truncate the rule.
app FacetUI:
    css:
        # The technique. Sizing is restated rather than inherited from the
        # runtime's default rule, so the set stays correct in a host that has
        # reset `.fa-icon` for its own reasons.
        #
        # `flex: 0 0 auto` because an icon's whole job is to be one fixed square
        # beside some text: in a `row` — a sidebar item, a toolbar, an engagement
        # bar — a flex item with `min-width: 0` and no basis is an item that gets
        # squeezed to nothing by the label next to it.
        [data-fa-mount] .fa-icon { display: inline-block; flex: 0 0 auto;
                     width: 1.15em; height: 1.15em; vertical-align: -.18em;
                     background: currentColor;
                     --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'></svg>");
                     -webkit-mask: var(--x-icon) center/contain no-repeat;
                     mask: var(--x-icon) center/contain no-repeat; }
        # The class form. The element carries the default (see the note above),
        # the pseudo-element paints. `margin-right` is the gap to the label, and
        # `:empty` is a button whose label is "", which wants no gap at all.
        [data-fa-mount] [class*="x-glyph-"] { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'></svg>"); }
        [data-fa-mount] [class*="x-glyph-"]::before { content: ""; display: inline-block; flex: 0 0 auto;
                     width: 1.15em; height: 1.15em; vertical-align: -.18em; margin-right: .35em;
                     background: currentColor;
                     -webkit-mask: var(--x-icon) center/contain no-repeat;
                     mask: var(--x-icon) center/contain no-repeat; }
        [data-fa-mount] [class*="x-glyph-"]:empty::before { margin-right: 0; }

        # ── getting around ──────────────────────────────────────────────────
        [data-fa-mount] [data-fa-icon="home"], [data-fa-mount] .x-glyph-home { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3.5 10.5L12 3.5l8.5 7'/><path d='M5.5 9.6V20h13V9.6'/><path d='M9.8 20v-5.4h4.4V20'/></svg>"); }
        [data-fa-mount] [data-fa-icon="search"], [data-fa-mount] .x-glyph-search { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='6.6'/><path d='M15.8 15.8L21 21'/></svg>"); }
        [data-fa-mount] [data-fa-icon="menu"], [data-fa-mount] .x-glyph-menu { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3.5 6.5h17M3.5 12h17M3.5 17.5h17'/></svg>"); }
        [data-fa-mount] [data-fa-icon="close"], [data-fa-mount] .x-glyph-close { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M5.5 5.5l13 13M18.5 5.5l-13 13'/></svg>"); }
        [data-fa-mount] [data-fa-icon="chevron-left"], [data-fa-mount] .x-glyph-chevron-left { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M14.5 5.5L8 12l6.5 6.5'/></svg>"); }
        [data-fa-mount] [data-fa-icon="chevron-right"], [data-fa-mount] .x-glyph-chevron-right { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9.5 5.5L16 12l-6.5 6.5'/></svg>"); }
        [data-fa-mount] [data-fa-icon="chevron-up"], [data-fa-mount] .x-glyph-chevron-up { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M5.5 14.5L12 8l6.5 6.5'/></svg>"); }
        [data-fa-mount] [data-fa-icon="chevron-down"], [data-fa-mount] .x-glyph-chevron-down { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M5.5 9.5L12 16l6.5-6.5'/></svg>"); }
        [data-fa-mount] [data-fa-icon="arrow-left"], [data-fa-mount] .x-glyph-arrow-left { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M20 12H4'/><path d='M10 6l-6 6 6 6'/></svg>"); }
        [data-fa-mount] [data-fa-icon="arrow-right"], [data-fa-mount] .x-glyph-arrow-right { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 12h16'/><path d='M14 6l6 6-6 6'/></svg>"); }
        [data-fa-mount] [data-fa-icon="external"], [data-fa-mount] .x-glyph-external { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M14 4.5h5.5V10'/><path d='M19.5 4.5L11 13'/><path d='M18 14.5v4a1.9 1.9 0 0 1-1.9 1.9H5.4a1.9 1.9 0 0 1-1.9-1.9V7.8a1.9 1.9 0 0 1 1.9-1.9h4'/></svg>"); }

        # ── doing something ─────────────────────────────────────────────────
        [data-fa-mount] [data-fa-icon="plus"], [data-fa-mount] .x-glyph-plus { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 4.5v15M4.5 12h15'/></svg>"); }
        [data-fa-mount] [data-fa-icon="edit"], [data-fa-mount] .x-glyph-edit { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 20h4.2L19 9.2a2.1 2.1 0 0 0 0-3l-1.2-1.2a2.1 2.1 0 0 0-3 0L4 15.8V20z'/><path d='M13.6 6.2l4.2 4.2'/></svg>"); }
        [data-fa-mount] [data-fa-icon="trash"], [data-fa-mount] .x-glyph-trash { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 6.5h16'/><path d='M9.5 6.5V4.6h5v1.9'/><path d='M6.2 6.5l.9 12.2a1.6 1.6 0 0 0 1.6 1.5h6.6a1.6 1.6 0 0 0 1.6-1.5l.9-12.2'/><path d='M10.2 10v6.4M13.8 10v6.4'/></svg>"); }
        [data-fa-mount] [data-fa-icon="copy"], [data-fa-mount] .x-glyph-copy { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='8.5' y='8.5' width='11.5' height='11.5' rx='2.2'/><path d='M15.5 5.5a2 2 0 0 0-2-2H6a2.5 2.5 0 0 0-2.5 2.5V14a2 2 0 0 0 2 2'/></svg>"); }
        [data-fa-mount] [data-fa-icon="download"], [data-fa-mount] .x-glyph-download { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3.8v11'/><path d='M7.5 10.5l4.5 4.5 4.5-4.5'/><path d='M4.5 19.5h15'/></svg>"); }
        [data-fa-mount] [data-fa-icon="upload"], [data-fa-mount] .x-glyph-upload { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20V9'/><path d='M7.5 13.5L12 9l4.5 4.5'/><path d='M4.5 4.5h15'/></svg>"); }
        [data-fa-mount] [data-fa-icon="share"], [data-fa-mount] .x-glyph-share { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='5.5' r='2.6'/><circle cx='6' cy='12' r='2.6'/><circle cx='18' cy='18.5' r='2.6'/><path d='M8.3 10.8l7.4-4M8.3 13.2l7.4 4'/></svg>"); }
        [data-fa-mount] [data-fa-icon="filter"], [data-fa-mount] .x-glyph-filter { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3.5 5.5h17l-6.6 7.8v5.9l-3.8 2v-7.9L3.5 5.5z'/></svg>"); }
        [data-fa-mount] [data-fa-icon="settings"], [data-fa-mount] .x-glyph-settings { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3.2'/><path d='M12 2.8v2.6M12 18.6v2.6M4.5 12H2M22 12h-2.5M6.7 6.7L4.9 4.9M19.1 19.1l-1.8-1.8M17.3 6.7l1.8-1.8M4.9 19.1l1.8-1.8'/></svg>"); }
        [data-fa-mount] [data-fa-icon="refresh"], [data-fa-mount] .x-glyph-refresh { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M20 12a8 8 0 1 1-2.6-5.9'/><path d='M20.3 3.6v5h-5'/></svg>"); }

        # ── being told something ────────────────────────────────────────────
        # These four are the same four tones `ui/alert.fct` names. A `Callout`
        # that wants a mark uses `check`/`info`/`warning`/`error` and reads
        # correctly next to an `Alert` on the same page.
        [data-fa-mount] [data-fa-icon="check"], [data-fa-mount] .x-glyph-check { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4.5 12.6l5 5 10-11'/></svg>"); }
        [data-fa-mount] [data-fa-icon="info"], [data-fa-mount] .x-glyph-info { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.8'/><path d='M12 11v6'/><path d='M12 7.3v.2'/></svg>"); }
        [data-fa-mount] [data-fa-icon="warning"], [data-fa-mount] .x-glyph-warning { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3.4l9 15.8H3l9-15.8z'/><path d='M12 9.4v4.6'/><path d='M12 17v.2'/></svg>"); }
        [data-fa-mount] [data-fa-icon="error"], [data-fa-mount] .x-glyph-error { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.8'/><path d='M9 9l6 6M15 9l-6 6'/></svg>"); }
        [data-fa-mount] [data-fa-icon="help"], [data-fa-mount] .x-glyph-help { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.8'/><path d='M9.5 9.6a2.6 2.6 0 1 1 3.3 2.5c-.5.2-.8.7-.8 1.2v.8'/><path d='M12 17v.2'/></svg>"); }
        [data-fa-mount] [data-fa-icon="star"], [data-fa-mount] .x-glyph-star { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3.6l2.7 5.5 6 .9-4.35 4.2 1.03 6L12 17.4l-5.38 2.8 1.03-6L3.3 10l6-.9L12 3.6z'/></svg>"); }
        [data-fa-mount] [data-fa-icon="bell"], [data-fa-mount] .x-glyph-bell { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9.5a6 6 0 0 1 12 0c0 4 1.4 5.6 2.1 6.4H3.9C4.6 15.1 6 13.5 6 9.5z'/><path d='M10 19a2.2 2.2 0 0 0 4 0'/></svg>"); }
        [data-fa-mount] [data-fa-icon="lock"], [data-fa-mount] .x-glyph-lock { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='10' width='16' height='11' rx='2.5'/><path d='M8 10V7a4 4 0 0 1 8 0v3'/></svg>"); }

        # ── people ──────────────────────────────────────────────────────────
        [data-fa-mount] [data-fa-icon="user"], [data-fa-mount] .x-glyph-user { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='4'/><path d='M4.5 20.5a7.5 7.5 0 0 1 15 0'/></svg>"); }
        [data-fa-mount] [data-fa-icon="users"], [data-fa-mount] .x-glyph-users { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='9.2' cy='8.2' r='3.6'/><path d='M2.6 20a6.6 6.6 0 0 1 13.2 0'/><path d='M16.2 5a3.6 3.6 0 0 1 0 6.6'/><path d='M18 14.2a6.6 6.6 0 0 1 3.4 5.8'/></svg>"); }
        [data-fa-mount] [data-fa-icon="mail"], [data-fa-mount] .x-glyph-mail { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2.5'/><path d='M3.6 6.8l8.4 6 8.4-6'/></svg>"); }
        [data-fa-mount] [data-fa-icon="calendar"], [data-fa-mount] .x-glyph-calendar { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='5' width='17' height='15.5' rx='2.5'/><path d='M3.5 10h17'/><path d='M8 3v4M16 3v4'/></svg>"); }
        [data-fa-mount] [data-fa-icon="clock"], [data-fa-mount] .x-glyph-clock { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='8.8'/><path d='M12 6.6v5.7l3.6 2.1'/></svg>"); }

        # ── files and media ─────────────────────────────────────────────────
        [data-fa-mount] [data-fa-icon="play"], [data-fa-mount] .x-glyph-play { --x-icon: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M8 5.2l10 6.8-10 6.8V5.2z'/></svg>"); }
