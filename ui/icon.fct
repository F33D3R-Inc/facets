    # The node, as a component, so a host can write `use Icon("search")` in a
    # slot without reaching for the raw node — and so the set has an entry point
    # that shows up in the library's component list. An unknown name renders an
    # empty square of nothing, which is the same thing the raw node does.
    component Icon(name: text):
        icon "{name}"
