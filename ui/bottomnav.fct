# BottomNav — the 5-tab mobile bar every TikTok/Instagram/X-app phone screen
# wears at the bottom: icon over a small label, one of them a "+" that opens a
# composer instead of a route. It is the tab-bar answer to the same breakpoint
# `layout/vocabulary.fct` already lays the three-column rail down for
# (`x-l-app3` becomes a horizontal bar under 820px) — this is for an app that
# wants Home / Discover / Post / Inbox / Me instead of the rail's list of links,
# and it is hidden above 820px on the assumption that a rail is already on
# screen there.
#
#     use BottomNav():
#         use BottomNavItem("home", "Home", "/")
#         use BottomNavItem("search", "Discover", "/discover")
#         use BottomNavAction("plus", "Post", openComposer)
#         use BottomNavItem("mail", "Inbox", "/inbox")
#         use BottomNavItem("user", "Me", "/profile/" + actor)
#
# ── THE ACTIVE STATE IS A MARKER ELEMENT, NOT A BRANCH ────────────────────────
#
# The same technique `navigation/sidebaritem.fct` documents at length, and for
# the same reason: a component has at most one `slot`, so an item that rendered
# two different trees for "current" and "not current" would need two. Instead
# the row is drawn once, an invisible marker renders inside it when
# `route == href`, and the container reads the marker's presence with `:has()`.
#
# ── AN ICON ABOVE A LABEL IS ONE ELEMENT, NOT TWO ─────────────────────────────
#
# `link` and `button` render their label and nothing else — no child `icon`
# node fits inside either — so the glyph is the `x-glyph-*` class technique
# `ui/icon.fct` documents: a mask painted into the element's own `::before`.
# Stacking it over the label is exactly the `flex-direction: column` a normal
# icon-then-text button already uses turned 90 degrees: the pseudo-element is
# the first flex item, the label text is the second, and `align-items: center`
# centers both.
#
# `BottomNavAction` is the middle "+"/compose control. It takes a client action
# rather than a destination, because "new post" opens a composer or a sheet, not
# a page — and it is drawn as a filled accent disc rather than a fifth muted
# glyph, since posting is the one thing on this bar that is not a place to go.
import "../navigation/link.fct"
import "icon.fct"
app FacetUI:
    css:
        [data-fa-mount] .x-bottomnav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
                       display: none; flex-direction: row; align-items: stretch; gap: 0;
                       border: none; border-top: 1px solid var(--x-line, #2f3336);
                       border-radius: 0; background: var(--fa-bg);
                       background: color-mix(in srgb, var(--fa-bg) 92%, transparent);
                       -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
                       padding: 0 0 env(safe-area-inset-bottom, 0px); }
        @media (max-width: 820px) {
            [data-fa-mount] .x-bottomnav { display: flex; }
        }
        [data-fa-mount] .x-bottomnav-item { flex: 1; display: flex; border: none;
                          background: none; padding: 0; border-radius: 0; }
        # The glyph-and-label control itself: one element, stacked, centred.
        # `.35em` of right margin is `ui/icon.fct`'s default gap to a label beside
        # the mark, which is the wrong axis here and is zeroed.
        [data-fa-mount] .x-bottomnav-link { display: flex; flex-direction: column;
                          align-items: center; justify-content: center; gap: 3px;
                          width: 100%; padding: 7px 0 6px; border-radius: 0;
                          font-size: 11px; font-weight: 600; line-height: 1;
                          color: var(--fa-muted); text-decoration: none; }
        [data-fa-mount] .x-bottomnav-link::before { margin-right: 0; }
        [data-fa-mount] .x-bottomnav-link:hover { color: var(--fa-fg); }
        # The marker never paints; the row reads its presence.
        [data-fa-mount] .x-bottomnav-on { display: none; }
        [data-fa-mount] .x-bottomnav-item:has(.x-bottomnav-on) .x-bottomnav-link {
                       color: var(--fa-fg); }
        [data-fa-mount] .x-bottomnav-item:has(.x-bottomnav-on) .x-bottomnav-link::before {
                       background: var(--fa-fg); }
        # The middle compose control: a filled accent pill, row-not-column, so it
        # reads as the one ACTION on a bar of destinations rather than as a sixth,
        # oddly-coloured tab.
        [data-fa-mount] .x-bottomnav-cta { flex-direction: row; align-self: center;
                       width: auto; margin: 0 10px; padding: 9px 16px; gap: 6px;
                       border-radius: 9999px; background: var(--fa-accent); color: #fff;
                       font-size: 13px; }
        [data-fa-mount] .x-bottomnav-cta::before { background: #fff; margin-right: 0; }
        [data-fa-mount] .x-bottomnav-cta:hover { filter: brightness(1.08); color: #fff; }
        [data-fa-mount] .x-bottomnav-item:has(.x-bottomnav-cta) { flex: 0 0 auto;
                       align-items: center; justify-content: center; }
    component BottomNav():
        row class "x-bottomnav":
            slot
    component BottomNavItem(glyph: text, label: text, href: text):
        box class "x-bottomnav-item":
            link "{label}" -> "{href}" class "x-bottomnav-link x-glyph-{glyph}"
            if route == href:
                box class "x-bottomnav-on"
    component BottomNavAction(glyph: text, label: text, a: action):
        box class "x-bottomnav-item":
            button "{label}" -> a class "x-bottomnav-link x-bottomnav-cta x-glyph-{glyph}"
