# Menu — a button that opens a panel, and the facet this library said could not
# exist. The README's "what navigation still cannot do" paragraph named it:
#
#   > There is no `Menu`, because nothing can write a `@client` cell except a
#   > control bound to it — `overlay bind v` shows and hides on `v`, and no view
#   > node or action statement can flip it, so a dropdown has no way to open.
#
# The diagnosis was right and the missing piece was not a statement that assigns
# state — it was a CONTROL, because a control bound to a bool cell is by definition
# a thing that flips it. `toggle` landed, and a `toggle` and an `overlay` bound to
# the SAME cell are a menu: the toggle is the only writer, the overlay is a reader,
# and there is no second source of truth to get out of step. One cell, one writer,
# open and closed.
#
#     state menuOpen: bool = false @client
#
#     use Menu("Menu", menuOpen):
#         use MenuItem("Docs", "/docs")
#         use MenuItem("Request access", "/access")
#
# WHAT OPENS IS A SHEET, NOT AN ANCHORED DROPDOWN, and the name of this facet is
# the more honest of the two words for that reason. `overlay` renders a fixed
# backdrop over the viewport with a centred panel inside it; there is no anchor,
# no positioning relative to the control, and no way to express one — the language
# has no measurement of where a node landed. So this is the modal-sheet shape: on
# a phone it is what a menu should have been anyway, and on a desktop it is a
# command palette rather than a hover menu. A hover menu is still not expressible
# and is not faked here.
#
# CLOSING IS ALREADY HANDLED, in two places and neither of them is this file. The
# runtime tags the backdrop with the bound cell, so a click outside closes; and the
# toggle is still on screen underneath, so a second click on it closes. A `Close`
# button inside the panel would need to WRITE the cell, which only a control can
# do — so it would be a second toggle, which is what `MenuClose` is.
#
# `Disclosure` is the same idea without the overlay: the panel renders in place,
# under the control, inside the flow. It is the right one for an FAQ answer, a
# "show advanced" block or a filter drawer — anything the reader should be able to
# scroll past rather than dismiss.
import "../navigation/link.fct"
app FacetUI:
    css:
        [data-fa-mount] .x-menu { position: relative; border: none; background: none;
                padding: 0; }
        # A MENU BUTTON IS A BUTTON, and the runtime renders a `toggle` as a switch:
        # a checkbox with `role="switch"` and the words after it. That is right for a
        # setting and wrong here — nobody reads "Menu" with a switch beside it as
        # something to press — so the input is taken out of the paint (not out of the
        # DOM: it is still the focusable, keyboard-operable control, and the label is
        # still its click target) and the label is dressed as the button it acts as.
        [data-fa-mount] .x-menu .fa-toggle { display: inline-flex; align-items: center;
                gap: 0; padding: 9px 16px; border-radius: 9999px;
                border: 1px solid var(--x-line, #2f3336); font-weight: 600; font-size: 15px;
                cursor: pointer; }
        [data-fa-mount] .x-menu .fa-toggle input { position: absolute; width: 1px; height: 1px;
                opacity: 0; margin: 0; }
        [data-fa-mount] .x-menu .fa-toggle:hover { background: var(--x-hover, rgba(239,243,244,.06)); }
        # The open state, read off the control's own checked state rather than off a
        # second cell. `:has()` is what makes that reachable from the container.
        [data-fa-mount] .x-menu .fa-toggle:has(input:checked) { background: var(--x-hover, rgba(239,243,244,.06));
                border-color: var(--fa-accent); }
        # Keyboard focus must survive the input being invisible, or the menu becomes
        # unreachable for anyone not using a pointer.
        [data-fa-mount] .x-menu .fa-toggle:has(input:focus-visible) { outline: 2px solid var(--fa-accent);
                outline-offset: 2px; }
        # The panel. A column of items with the overlay's own padding, sized to the
        # content and capped so a long menu scrolls instead of running off the top
        # and bottom of the screen.
        [data-fa-mount] .x-menu-panel { display: flex; flex-direction: column; gap: 2px;
                min-width: 220px; max-height: 70vh; overflow-y: auto;
                border: none; background: none; padding: 0; }
        [data-fa-mount] .x-menu-item { display: flex; align-items: center; padding: 10px 14px;
                border-radius: 10px; border: none; background: none; font-size: 16px; }
        [data-fa-mount] .x-menu-item:hover { background: var(--x-hover, rgba(239,243,244,.06)); }
        [data-fa-mount] .x-menu-item a.x-link { color: var(--fa-fg); }
        [data-fa-mount] .x-menu-sep { height: 1px; margin: 6px 4px;
                background: var(--x-line, #2f3336); border: none; padding: 0; }
        # In-flow disclosure: the same control, no overlay, the panel indented under
        # it so the relationship is visible without a chevron this library would have
        # to animate.
        [data-fa-mount] .x-disclosure { border: none; background: none; padding: 0; }
        [data-fa-mount] .x-disclosure-panel { padding: 8px 0 8px 14px;
                border-left: 2px solid var(--x-line, #2f3336); margin: 6px 0 6px 2px;
                border-radius: 0; background: none; }
    component Menu(label: text, open: cell bool):
        box class "x-menu":
            toggle bind open label "{label}"
            overlay bind open:
                box class "x-menu-panel":
                    slot
    component MenuItem(label: text, href: text):
        box class "x-menu-item":
            use Link(label, href)
    component MenuSeparator():
        box class "x-menu-sep"
    # The in-panel close. It is a toggle on the same cell — the only kind of node
    # that may write one — so it is the menu's own button rendered a second time,
    # inside the panel, with whatever word the caller wants on it.
    component MenuClose(label: text, open: cell bool):
        box class "x-menu-item":
            toggle bind open label "{label}"
    component Disclosure(label: text, open: cell bool):
        box class "x-disclosure":
            toggle bind open label "{label}"
            if open:
                box class "x-disclosure-panel":
                    slot
