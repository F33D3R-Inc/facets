# Look — the f33d3r look, as one importable facet. Import it and every atom in
# this library renders like the screenshots with no CSS of your own.
#
# It carries two things: the palette (a `theme:` block, so a host can still
# override any variable) and the `x-` vocabulary the rail, the sign-in surfaces
# and the chat / graph / live atoms use — pill buttons, cards, text roles (muted
# / strong / small / clamped), the theater grid, the chat column, the inbox. A
# host may use the same classes on its own nodes.
#
# WHAT IS NOT HERE ANY MORE. The post, the engagement bar, the quote, the media
# frame, the profile header, the top bar and the fixed CTA bar each ship their
# rules in their own file now (`social/`, `ui/mediacard.fct`, `profile/`,
# `layout/topbar.fct`, `marketing/ctabar.fct`), and the three-column shell is
# `layout/vocabulary.fct`'s `x-l-app3`. An atom that only renders correctly when
# the look was also imported is not a self-contained atom, so the look keeps only
# what no atom owns.
#
# Rules are anchored on `[data-fa-mount]` (the app root) so they outrank the
# runtime's defaults without `!important`.
app FacetUI:
    theme:
        bg "#000000"
        fg "#e7e9ea"
        muted "#71767b"
        accent "#1d9bf0"
        border "#2f3336"
        card-border "#2f3336"
        radius "16px"
        maxwidth "1280px"
    css:
        body { margin: 0; padding: 0; max-width: none; }
        [data-fa-mount] { max-width: var(--fa-maxwidth); margin: 0 auto; }
        [data-fa-mount] .fa-box .fa-box { border: none; border-radius: 0; padding: 0; }
        [data-fa-mount] .fa-link { text-decoration: none; }
        [data-fa-mount] .fa-link:hover { text-decoration: underline; }
        [data-fa-mount] .fa-more { border: none; color: var(--fa-accent); }

        [data-fa-mount] .x-logo { font-size: 26px; font-weight: 800; padding: 8px 12px 12px; }
        # The rail is `x-l-app3-nav`, a flex column; `NavRail` is a `use` inside it,
        # so its wrapper has to be the column for `.x-account`'s `margin-top: auto`
        # to reach the bottom.
        [data-fa-mount] .x-l-app3-nav > .fa-use { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; gap: 4px; }
        [data-fa-mount] .x-nav-item { align-items: center; gap: 16px; padding: 10px 12px; border-radius: 999px;
                                      width: fit-content; cursor: pointer; }
        [data-fa-mount] .x-nav-item:hover { background: rgba(231, 233, 234, .1); }
        [data-fa-mount] .x-nav-item .fa-icon { width: 26px; height: 26px; }
        [data-fa-mount] .x-nav-item .fa-link { color: var(--fa-fg); font-size: 20px; }
        [data-fa-mount] .x-nav-item .fa-link:hover { text-decoration: none; }
        [data-fa-mount] .x-post-btn { margin: 12px 0; padding: 14px 0; font-size: 17px; text-align: center; width: 90%; }
        [data-fa-mount] .x-account { margin-top: auto; padding: 12px; border-radius: 999px; align-items: center; }
        [data-fa-mount] .x-account:hover { background: rgba(231, 233, 234, .1); }

        # The "Pinned" line a host renders ABOVE a `PostCard`, indented to the
        # card's text column.
        [data-fa-mount] .x-pinned { align-items: center; gap: 8px; color: var(--fa-muted); font-size: 13px; font-weight: 700; padding: 10px 16px 0 52px; }
        [data-fa-mount] .x-pinned .fa-icon { width: 16px; height: 16px; }
        # The tabs under a profile header, full width and equal.
        [data-fa-mount] .x-profile-tabs .fa-tabstrip { border-bottom: none; }
        [data-fa-mount] .x-profile-tabs .fa-tab { flex: 1 1 0; padding: 16px 0; }
        [data-fa-mount] .x-author { align-items: center; gap: 4px; flex-wrap: nowrap; min-width: 0; }
        [data-fa-mount] .x-author .fa-icon { color: var(--fa-accent); width: 19px; height: 19px; }
        [data-fa-mount] .x-author .x-strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        [data-fa-mount] .x-avatar-sm { width: 24px; height: 24px; }

        [data-fa-mount] .x-card { border: 1px solid var(--fa-border); border-radius: var(--fa-radius); padding: 12px 16px; gap: 12px; }
        [data-fa-mount] .x-card .fa-heading { font-size: 20px; font-weight: 800; }
        [data-fa-mount] .x-fine { font-size: 13px; }
        [data-fa-mount] .x-fine p { margin: 0; }
        [data-fa-mount] .x-fine, [data-fa-mount] .x-fine a { color: var(--fa-muted); }
        [data-fa-mount] .x-fine a { color: var(--fa-accent); }
        [data-fa-mount] .x-footer { gap: 4px 12px; }
        [data-fa-mount] .x-footer .fa-link { color: var(--fa-muted); font-size: 13px; }

        [data-fa-mount] .x-float-br { position: fixed; right: 24px; bottom: 96px; z-index: 20; }

        [data-fa-mount] .x-pill { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
                                  border-radius: 999px; padding: 8px 16px; font-weight: 700; font-size: 15px;
                                  border: 1px solid var(--fa-border); background: transparent; color: var(--fa-fg);
                                  text-decoration: none; cursor: pointer; align-self: auto; box-sizing: border-box; }
        [data-fa-mount] .x-pill:hover { text-decoration: none; background: rgba(231, 233, 234, .1); }
        [data-fa-mount] .x-primary { background: var(--fa-accent); border-color: var(--fa-accent); color: rgb(255, 255, 255); }
        [data-fa-mount] .x-primary:hover { background: rgb(26, 140, 216); }
        [data-fa-mount] .x-light { background: rgb(239, 243, 244); border-color: rgb(239, 243, 244); color: rgb(15, 20, 25); }
        [data-fa-mount] .x-light:hover { background: rgb(215, 219, 220); }
        [data-fa-mount] .x-wide { width: 100%; }
        [data-fa-mount] .x-right { margin-left: auto; }

        [data-fa-mount] .x-theater { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 0; align-items: start; min-height: 100vh; }
        [data-fa-mount] .x-theater > .fa-box { width: auto; flex: none; }
        [data-fa-mount] .x-stagecol { gap: 12px; padding: 0 0 24px; }
        [data-fa-mount] .x-chatcol { position: sticky; top: 0; height: 100vh; border-left: 1px solid var(--fa-border); }
        @media (max-width: 900px) { [data-fa-mount] .x-theater { grid-template-columns: minmax(0, 1fr); }
                                    [data-fa-mount] .x-chatcol { position: static; height: 60vh; border-left: none; border-top: 1px solid var(--fa-border); } }
        [data-fa-mount] .x-stage { margin-top: 0; border-radius: 0; border: none; }
        [data-fa-mount] .x-streaminfo { padding: 12px 16px; gap: 12px; align-items: flex-start; flex-wrap: nowrap; }
        [data-fa-mount] .x-streaminfo-body { gap: 4px; }
        [data-fa-mount] .x-streaminfo-body .fa-heading { font-size: 18px; font-weight: 700; }
        [data-fa-mount] .x-streaminfo-actions { flex: none; gap: 8px; align-items: center; flex-wrap: nowrap; }
        [data-fa-mount] .x-streamchips { gap: 8px; align-items: center; }
        [data-fa-mount] .x-chip-pill { display: inline-flex; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600;
                                       background: rgba(29, 155, 240, .15); color: var(--fa-accent); text-decoration: none; }
        [data-fa-mount] .x-chip-pill:hover { background: rgba(29, 155, 240, .3); text-decoration: none; }
        [data-fa-mount] .x-goal { padding: 0 16px; gap: 6px; }
        [data-fa-mount] .x-goal-head { align-items: baseline; }
        [data-fa-mount] .x-goal-track { height: 10px; border-radius: 999px; background: rgba(255, 255, 255, .1); overflow: hidden; }
        [data-fa-mount] .x-goal-fill { height: 100%; background: var(--fa-accent); border-radius: 999px; transition: width .4s; }
        [data-fa-mount] .x-w0 { width: 0; } [data-fa-mount] .x-w5 { width: 5%; } [data-fa-mount] .x-w10 { width: 10%; } [data-fa-mount] .x-w15 { width: 15%; }
        [data-fa-mount] .x-w20 { width: 20%; } [data-fa-mount] .x-w25 { width: 25%; } [data-fa-mount] .x-w30 { width: 30%; } [data-fa-mount] .x-w35 { width: 35%; }
        [data-fa-mount] .x-w40 { width: 40%; } [data-fa-mount] .x-w45 { width: 45%; } [data-fa-mount] .x-w50 { width: 50%; } [data-fa-mount] .x-w55 { width: 55%; }
        [data-fa-mount] .x-w60 { width: 60%; } [data-fa-mount] .x-w65 { width: 65%; } [data-fa-mount] .x-w70 { width: 70%; } [data-fa-mount] .x-w75 { width: 75%; }
        [data-fa-mount] .x-w80 { width: 80%; } [data-fa-mount] .x-w85 { width: 85%; } [data-fa-mount] .x-w90 { width: 90%; } [data-fa-mount] .x-w95 { width: 95%; }
        [data-fa-mount] .x-w100 { width: 100%; }
        [data-fa-mount] .x-sheet { gap: 12px; min-width: 320px; }
        [data-fa-mount] .x-presets { gap: 8px; flex-wrap: wrap; }
        [data-fa-mount] .x-tips { padding: 0 16px; gap: 6px; }
        [data-fa-mount] .x-tipline { align-items: center; gap: 8px; font-size: 14px; }
        [data-fa-mount] .x-tipline .fa-icon { color: rgb(255, 193, 7); }
        [data-fa-mount] .x-chat { height: 100vh; gap: 0; }
        [data-fa-mount] .x-chat-head { align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--fa-border); flex-wrap: nowrap; }
        [data-fa-mount] .x-chat-head .fa-heading { font-size: 15px; font-weight: 700; }
        [data-fa-mount] .x-chat-pinned { align-items: center; gap: 8px; padding: 8px 16px; background: rgba(29, 155, 240, .12); }
        [data-fa-mount] .x-chat-list { flex: 1 1 auto; overflow-y: auto; padding: 8px 12px; gap: 6px; display: flex; flex-direction: column-reverse; }
        [data-fa-mount] .x-chatline { align-items: baseline; gap: 6px; font-size: 14px; flex-wrap: nowrap; }
        [data-fa-mount] .x-chatline .x-role { width: 16px; height: 16px; color: var(--fa-accent); flex: none; }
        [data-fa-mount] .x-chat-name { color: rgb(145, 71, 255); white-space: nowrap; }
        [data-fa-mount] .x-chat-body { line-height: 1.4; min-width: 0; overflow-wrap: anywhere; }
        [data-fa-mount] .x-chat-body p { margin: 0; }
        [data-fa-mount] .x-modtools { margin-left: auto; gap: 2px; flex-wrap: nowrap; opacity: .5; }
        [data-fa-mount] .x-modtools:hover { opacity: 1; }
        [data-fa-mount] .x-modtools > button { padding: 2px; }
        [data-fa-mount] .x-chat-gate { padding: 16px; text-align: center; border-top: 1px solid var(--fa-border); }
        [data-fa-mount] .x-chat .fa-form { padding: 12px; border-top: 1px solid var(--fa-border); flex-direction: row; }
        [data-fa-mount] .x-chat .fa-form input { flex: 1 1 auto; }
        [data-fa-mount] .x-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 16px; }
        [data-fa-mount] .x-streamcard { gap: 8px; }
        [data-fa-mount] .x-streamcard .x-media { margin-top: 0; }
        [data-fa-mount] .x-streamcard-row { gap: 10px; align-items: flex-start; flex-wrap: nowrap; }
        [data-fa-mount] .x-streamcard-row > .fa-box { gap: 0; }
        [data-fa-mount] .x-streamcard-title { color: var(--fa-fg); }
        [data-fa-mount] .x-console { gap: 16px; padding: 0 16px 24px; }
        [data-fa-mount] .x-console-row { align-items: center; gap: 12px; }
        [data-fa-mount] .x-console-row input { flex: 1 1 auto; }
        [data-fa-mount] .x-mono { font-family: ui-monospace, monospace; }
        [data-fa-mount] .x-agegate { max-width: 420px; margin: 15vh auto; }

        [data-fa-mount] .x-thread { gap: 0; min-height: 70vh; }
        [data-fa-mount] .x-thread-list { flex: 1 1 auto; display: flex; flex-direction: column-reverse; gap: 6px; padding: 12px 16px; overflow-y: auto; max-height: 70vh; }
        [data-fa-mount] .x-msg { align-items: flex-end; gap: 8px; flex-wrap: nowrap; }
        [data-fa-mount] .x-mine-true { flex-direction: row-reverse; }
        [data-fa-mount] .x-msg-col { gap: 2px; max-width: 70%; flex: 0 1 auto; }
        [data-fa-mount] .x-mine-true .x-msg-col { align-items: flex-end; }
        [data-fa-mount] .x-bubble { display: inline-block; padding: 8px 14px; border-radius: 18px; background: rgb(47, 51, 54); color: var(--fa-fg);
                                    overflow-wrap: anywhere; white-space: pre-wrap; }
        [data-fa-mount] .x-mine-true .x-bubble { background: var(--fa-accent); color: rgb(255, 255, 255); }
        [data-fa-mount] .x-msg-meta { gap: 8px; }
        [data-fa-mount] .x-composer { padding: 12px 16px; border-top: 1px solid var(--fa-border); align-items: center; gap: 8px; flex-wrap: nowrap; }
        [data-fa-mount] .x-composer .fa-form { flex: 1 1 auto; flex-direction: row; }
        [data-fa-mount] .x-composer .fa-form input { flex: 1 1 auto; border-radius: 999px; }
        [data-fa-mount] .x-composer .x-small { font-size: 13px; padding: 6px 12px; }
        [data-fa-mount] .x-inbox { gap: 0; }
        [data-fa-mount] .x-inbox-item { padding: 12px 16px; gap: 12px; align-items: center; flex-wrap: nowrap; border-bottom: 1px solid var(--fa-border); }
        [data-fa-mount] .x-inbox-item:hover { background: rgba(255, 255, 255, .03); }
        [data-fa-mount] .x-inbox-body { gap: 2px; min-width: 0; }
        [data-fa-mount] .x-inbox-title { color: var(--fa-fg); }
        [data-fa-mount] .x-preview { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        [data-fa-mount] .x-newchat { padding: 12px 16px; gap: 8px; align-items: center; flex-wrap: nowrap; border-bottom: 1px solid var(--fa-border); }
        [data-fa-mount] .x-newchat input { flex: 1 1 auto; border-radius: 999px; }
        [data-fa-mount] .x-contact { padding: 12px 16px; gap: 12px; align-items: center; flex-wrap: nowrap; border-bottom: 1px solid var(--fa-border); }
        [data-fa-mount] .x-contact-body { gap: 0; min-width: 0; flex: 1 1 100px; }
        [data-fa-mount] .x-contact-body .fa-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        [data-fa-mount] .x-card .x-contact { padding: 8px 0; }
        [data-fa-mount] .x-card .x-contact:last-child { border-bottom: none; }
        [data-fa-mount] .x-pad { padding: 12px 16px 4px; }
        [data-fa-mount] .x-contact-actions { flex: none; gap: 8px; align-items: center; flex-wrap: nowrap; }
        [data-fa-mount] .x-iconbtn { padding: 6px; border-radius: 50%; }
        [data-fa-mount] .x-usermenu { min-width: 300px; gap: 8px; }
        [data-fa-mount] .x-usermenu-item { width: 100%; text-align: left; padding: 12px 16px; border: none; border-radius: 12px; background: transparent; color: var(--fa-fg); font-weight: 600; }
        [data-fa-mount] .x-usermenu-item:hover { background: rgba(231, 233, 234, .1); }
        [data-fa-mount] .x-danger { color: rgb(244, 33, 46); }

        [data-fa-mount] .x-muted { color: var(--fa-muted); }
        [data-fa-mount] .x-strong { font-weight: 700; }
        [data-fa-mount] .x-small { font-size: 13px; }
        [data-fa-mount] .x-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        [data-fa-mount] .x-heading { font-size: 20px; font-weight: 800; }
