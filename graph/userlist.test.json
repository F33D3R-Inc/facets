        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "removeFromList",
          "args": [
            1,
            "x"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "addToList",
          "args": [
            1,
            "x"
          ]
        }
      ]
    }
  ]
}
