import "entities.fct"
import "core.fct"

# POST /events — the mutation lane: one event_type per call, as a JSON object
# or a form. Every variant is the golden contract's (its wire name, fields,
# their descriptions, aliases and closed values, and the reply its action
# answers); each names the action it runs. The route itself is declared at the
# bottom of this module.
app F33D3RMutations:
    message Mutation tag "event_type":
        | account_delete -> accountDelete since "2026-09-06" "Delete the account.":
            reason: text? "Why, up to 500 characters."
        | block -> block since "2026-09-06" "Block a person.":
            target_handle: text "Handle without the @."
        | bookmark_folder_create -> bookmarkFolderCreate since "2026-09-06" "Create a bookmark folder, optionally saving a work into it.":
            name: text "Name."
            work_id: text? "A work to save into the new folder."
            filter: text? "Media filter the chips are drawn for (web only)."
        | bookmark_folder_delete -> bookmarkFolderDelete since "2026-09-06" "Delete a bookmark folder; its saves stay.":
            folder_id: text "Folder id."
            filter: text? "Media filter the chips are drawn for (web only)."
        | bookmark_folder_rename -> bookmarkFolderRename since "2026-09-06" "Rename a bookmark folder.":
            folder_id: text "Folder id."
            name: text "New name."
            filter: text? "Media filter the chips are drawn for (web only)."
        | brand_deal_accept -> brandDealAccept since "2026-09-06" "Creator-only: accept a pending sponsorship proposal.":
            deal_id: text "The brand deal."
        | brand_deal_cancel -> brandDealCancel since "2026-09-06" "Brand-only: withdraw a proposal the creator hasn't answered yet.":
            deal_id: text "The brand deal."
        | brand_deal_decline -> brandDealDecline since "2026-09-06" "Creator-only: decline a pending sponsorship proposal.":
            deal_id: text "The brand deal."
        | brand_deal_link_work -> brandDealLinkWork since "2026-09-06" "Creator-only: tag one of your own works as the sponsored post for an accepted deal. Non-reversible: the disclosure this adds cannot be removed.":
            deal_id: text "The brand deal."
            work_id: text "The work to disclose as sponsored."
        | brand_deal_mark_paid -> brandDealMarkPaid since "2026-09-06" "Brand-only: release payment for a live (linked) deal through the wallet.":
            deal_id: text "The brand deal."
        | brand_deal_propose -> brandDealPropose since "2026-09-06" "Brand-only: propose a sponsorship to a creator.":
            target_handle: text "The creator's handle."
            amount: number "AET, e.g. 500."
            terms: text? "Free-text terms of the sponsorship."
        | circle_add -> circleAdd since "2026-09-06" "Add a person to the caller's circle.":
            target_handle: text "Handle without the @."
        | circle_remove -> circleRemove since "2026-09-06" "Remove a person from the caller's circle.":
            target_handle: text "Handle without the @."
        | community_accept_invite as "community.accept_invite" -> communityAcceptInvite since "2026-09-06" "Accept an invite.":
            community_id: text "Community id; `id` is accepted too." also id
            invite_id: text "Invite id."
        | community_approve_join_request as "community.approve_join_request" -> communityApproveJoinRequest since "2026-09-06" "Approve a join request.":
            community_id: text "Community id; `id` is accepted too." also id
            request_id: text "Join request id."
        | community_ban_member as "community.ban_member" -> communityBanMember since "2026-09-06" "Ban a member.":
            community_id: text "Community id; `id` is accepted too." also id
            reason: text? "Why, up to 500 characters."
            target_pial: text? "The member, by PIAL."
            target_handle: text? "The member, by handle; `handle` is accepted too." also handle
        | community_create as "community.create" -> communityCreate since "2026-09-06" "Create a community.":
            handle: text "The community's handle."
            name: text? "Display name."
            description: text? "Description."
            membership_policy: text? "Who may join."
            avatar_url: text? "Avatar image URL."
            banner_url: text? "Banner image URL."
        | community_decline_invite as "community.decline_invite" -> communityDeclineInvite since "2026-09-06" "Decline an invite.":
            community_id: text "Community id; `id` is accepted too." also id
            invite_id: text "Invite id."
        | community_decline_join_request as "community.decline_join_request" -> communityDeclineJoinRequest since "2026-09-06" "Decline a join request.":
            community_id: text "Community id; `id` is accepted too." also id
            request_id: text "Join request id."
        | community_invite as "community.invite" -> communityInvite since "2026-09-06" "Invite a person.":
            community_id: text "Community id; `id` is accepted too." also id
            invitee_handle: text "Who to invite; `invitee` is accepted too." also invitee
        | community_join as "community.join" -> communityJoin since "2026-09-06" "Join an open community.":
            community_id: text "Community id; `id` is accepted too." also id
        | community_leave as "community.leave" -> communityLeave since "2026-09-06" "Leave a community.":
            community_id: text "Community id; `id` is accepted too." also id
        | community_moderate_post as "community.moderate_post" -> communityModeratePost since "2026-09-06" "Act on a report.":
            community_id: text "Community id; `id` is accepted too." also id
            report_id: text "The report."
            action: text "What to do."
            reason: text? "Why, up to 500 characters."
        | community_remove_member as "community.remove_member" -> communityRemoveMember since "2026-09-06" "Remove a member.":
            community_id: text "Community id; `id` is accepted too." also id
            target_pial: text? "The member, by PIAL."
            target_handle: text? "The member, by handle; `handle` is accepted too." also handle
        | community_report_post as "community.report_post" -> communityReportPost since "2026-09-06" "Report a work posted into the community.":
            community_id: text "Community id; `id` is accepted too." also id
            work_id: text "The work."
            reason: text "Why."
            rule_id: text? "The rule broken."
            detail: text? "Detail, up to 500 characters."
        | community_request_join as "community.request_join" -> communityRequestJoin since "2026-09-06" "Ask to join a community that approves members.":
            community_id: text "Community id; `id` is accepted too." also id
            message: text? "A note to the moderators, up to 300 characters."
        | community_set_member_role as "community.set_member_role" -> communitySetMemberRole since "2026-09-06" "Change a member's role.":
            community_id: text "Community id; `id` is accepted too." also id
            role: text "The new role."
            target_pial: text? "The member, by PIAL."
            target_handle: text? "The member, by handle; `handle` is accepted too." also handle
        | community_unban_member as "community.unban_member" -> communityUnbanMember since "2026-09-06" "Lift a ban.":
            community_id: text "Community id; `id` is accepted too." also id
            target_pial: text? "The member, by PIAL."
            target_handle: text? "The member, by handle; `handle` is accepted too." also handle
        | community_update_rules as "community.update_rules" -> communityUpdateRules since "2026-09-06" "Replace a community's rules.":
            community_id: text "Community id; `id` is accepted too." also id
            rules: text "JSON array of rule bodies, in order."
        | community_update_settings as "community.update_settings" -> communityUpdateSettings since "2026-09-06" "Change a community's name, description, images or membership policy.":
            community_id: text "Community id; `id` is accepted too." also id
            name: text? "Display name."
            description: text? "Description."
            membership_policy: text? "Who may join."
            avatar_url: text? "Avatar image URL."
            banner_url: text? "Banner image URL."
        | contact_decide -> contactDecide since "2026-09-06" "Accept or decline a contact request.":
            request_id: text "The request."
            decision: text "The decision." one of "accept", "decline"
        | contact_policy -> contactPolicy since "2026-09-06" "Change who may reach the caller by handle.":
            policy: text "The handle policy; `handle_policy` is accepted too." also handle_policy
        | content_reveal as "content.reveal" -> contentReveal since "2026-09-06" "Reserved. Answers 404 not implemented."
        | create_list -> createList since "2026-09-06" "Create a list.":
            name: text "Name."
            description: text? "Description."
            is_public: bool? "Public unless false; `is_private` true also makes it private."
        | creator_plan_create as "creator.plan.create" -> creatorPlanCreate since "2026-09-06" "Create a subscription plan.":
            name: text "Plan name."
            price_aet: number "Monthly price in AET."
            description: text? "Description."
        | creator_plan_delete as "creator.plan.delete" -> creatorPlanDelete since "2026-09-06" "Delete a subscription plan.":
            plan_id: text "Plan id."
        | creator_plan_update as "creator.plan.update" -> creatorPlanUpdate since "2026-09-06" "Change a subscription plan.":
            plan_id: text "Plan id."
            name: text "Plan name."
            price_aet: number "Monthly price in AET."
            description: text? "Description."
        | creator_setup_complete as "creator.setup.complete" -> creatorSetupComplete since "2026-09-06" "Finish creator onboarding.":
            display_name: text? "Display name."
            bio: text? "Bio."
            is_adult: bool? "Adult creator."
            btc_address: text? "BTC payout address."
            subscription_price_aet: number? "Subscription price in AET."
        | deactivate_account -> deactivateAccount since "2026-09-06" "Deactivate the account; signing in reactivates it.":
            reason: text? "Why, optional."
        | delete_list -> deleteList since "2026-09-06" "Delete a list.":
            list_id: text "List id."
        | follow -> follow since "2026-09-06" "Follow a person.":
            target_handle: text? "Who, by handle."
            target_pial: text? "Who, by PIAL; one of the two is required."
            source: text? "The surface the follow came from."
        | follow_topic -> followTopic since "2026-09-06" "Follow a #tag.":
            tag: text "The tag, with or without #."
        | frequency_approve as "frequency.approve" -> frequencyApprove since "2026-09-06" "Approve a mic request.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            request_id: text "Mic request id."
        | frequency_block as "frequency.block" -> frequencyBlock since "2026-09-06" "Block a participant from the room.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_cancel as "frequency.cancel" -> frequencyCancel since "2026-09-06" "Cancel a scheduled Frequency.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_cohost as "frequency.cohost" -> frequencyCohost since "2026-09-06" "Make a participant a co-host.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_create as "frequency.create" -> frequencyCreate since "2026-09-06" "Create a Frequency, scheduled or ready to start.":
            title: text "Title."
            description: text? "Description."
            visibility: text? "Who may tune in; `audience` is accepted too." also audience
            language: text? "Language tag."
            adult_content: bool? "Adult content; `is_nsfw` and `nsfw` are accepted too." also is_nsfw, nsfw
            max_speakers: int? "Speaker cap."
            max_listeners: int? "Listener cap."
            speaker_verity_min_tier: int? "Minimum identity tier to speak, 0–3."
            scheduled_at: text? "RFC 3339 start, for a scheduled Frequency."
            community_id: text? "Host it inside a community."
            idempotency_key: text? "Retry-safe key for the create."
        | frequency_decline as "frequency.decline" -> frequencyDecline since "2026-09-06" "Decline a mic request.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            request_id: text "Mic request id."
        | frequency_demote as "frequency.demote" -> frequencyDemote since "2026-09-06" "Move a speaker back to listening.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_end as "frequency.end" -> frequencyEnd since "2026-09-06" "End a Frequency.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_go_live as "frequency.go_live" -> frequencyGoLive since "2026-09-06" "Create a Frequency and start it now.":
            title: text "Title."
            description: text? "Description."
            visibility: text? "Who may tune in; `audience` is accepted too." also audience
            language: text? "Language tag."
            adult_content: bool? "Adult content; `is_nsfw` and `nsfw` are accepted too." also is_nsfw, nsfw
            max_speakers: int? "Speaker cap."
            max_listeners: int? "Listener cap."
            speaker_verity_min_tier: int? "Minimum identity tier to speak, 0–3."
            scheduled_at: text? "RFC 3339 start, for a scheduled Frequency."
            community_id: text? "Host it inside a community."
            idempotency_key: text? "Retry-safe key for the create."
        | frequency_heartbeat as "frequency.heartbeat" -> frequencyHeartbeat since "2026-09-06" "Presence beat while in the room (the native stream beats for you).":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_leave as "frequency.leave" -> frequencyLeave since "2026-09-06" "Leave the room.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_lock as "frequency.lock" -> frequencyLock since "2026-09-06" "Lock or unlock the room to new listeners.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            locked: bool "Locked."
        | frequency_mute as "frequency.mute" -> frequencyMute since "2026-09-06" "Mute a speaker.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_remove as "frequency.remove" -> frequencyRemove since "2026-09-06" "Remove a participant.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_report as "frequency.report" -> frequencyReport since "2026-09-06" "Report the room or a participant.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            reason: text "Why."
            detail: text? "Detail, up to 500 characters."
            target_handle: text? "The participant reported, when not the room."
        | frequency_request_mic as "frequency.request_mic" -> frequencyRequestMic since "2026-09-06" "Ask for the mic.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            reason: text? "Why, up to 140 characters."
        | frequency_requests_open as "frequency.requests_open" -> frequencyRequestsOpen since "2026-09-06" "Open or close requests for the mic.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            open: bool "Open."
        | frequency_schedule as "frequency.schedule" -> frequencySchedule since "2026-09-06" "Move a scheduled Frequency.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            scheduled_at: text "RFC 3339 start."
        | frequency_start as "frequency.start" -> frequencyStart since "2026-09-06" "Start a Frequency the caller hosts.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_tune_in as "frequency.tune_in" -> frequencyTuneIn since "2026-09-06" "Join as a listener.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
        | frequency_unblock as "frequency.unblock" -> frequencyUnblock since "2026-09-06" "Lift a room block.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_uncohost as "frequency.uncohost" -> frequencyUncohost since "2026-09-06" "Remove co-host.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_unmute as "frequency.unmute" -> frequencyUnmute since "2026-09-06" "Unmute a speaker.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            target_pial: text? "The participant, by PIAL."
            target_handle: text? "The participant, by handle; `handle` is accepted too." also handle
            reason: text? "Why, up to 140 characters."
        | frequency_upvote as "frequency.upvote" -> frequencyUpvote since "2026-09-06" "Upvote a mic request.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            request_id: text "Mic request id."
        | frequency_withdraw as "frequency.withdraw" -> frequencyWithdraw since "2026-09-06" "Withdraw a mic request.":
            frequency_id: text "Frequency id; `id` is accepted too." also id
            request_id: text "Mic request id."
        | handle_change -> handleChange since "2026-09-06" "Rename the caller's own handle. Checked against the same format rule and reserved-word list as signup, then granted or refused by registry-brain — the handle authority — before this brain's own copy ever changes.":
            handle: text "The new handle, 1-30 chars, letters/numbers/underscore/hyphen only."
        | history_clear -> historyClear since "2026-09-06" "Clear viewing history."
        | list_add_member -> listAddMember since "2026-09-06" "Add a person to a list.":
            list_id: text "List id."
            handle: text "The member, without the @."
        | list_remove_member -> listRemoveMember since "2026-09-06" "Remove a person from a list.":
            list_id: text "List id."
            handle: text "The member, without the @."
        | live_remind -> liveRemind since "2026-09-06" "Set or clear a reminder for a scheduled stream.":
            stream_id: text "Scheduled stream id."
            on: bool = true "Remind me; default true. `reminder` is accepted too." also reminder
        | live_schedule -> liveSchedule since "2026-09-06" "Schedule a stream.":
            title: text? "Title."
            description: text? "Description."
            is_nsfw: bool? "Adult content; `nsfw` is accepted too." also nsfw
            scheduled_at: text "When, as the client's local date-time."
            tz: text? "IANA time zone scheduled_at is in."
        | live_schedule_cancel -> liveScheduleCancel since "2026-09-06" "Cancel a scheduled stream.":
            stream_id: text "Scheduled stream id."
        | live_schedule_update -> liveScheduleUpdate since "2026-09-06" "Change a scheduled stream.":
            stream_id: text "Scheduled stream id."
            title: text? "Title."
            description: text? "Description."
            is_nsfw: bool? "Adult content; `nsfw` is accepted too." also nsfw
            scheduled_at: text "When, as the client's local date-time."
            tz: text? "IANA time zone scheduled_at is in."
        | marketplace_listing_create as "marketplace.listing.create" -> marketplaceListingCreate since "2026-09-06" "List encrypted content for sale. Requires identity verification.":
            title: text "Title."
            description: text? "Description."
            price_sats: int "Price in satoshis."
            content_url: text "The encrypted upload's URL."
            content_hash: text "Hash of the plaintext."
            cek_encrypted: text "The content key, wrapped for Themis."
            visibility: text? "public or subscribers."
        | marketplace_listing_delete as "marketplace.listing.delete" -> marketplaceListingDelete since "2026-09-06" "Delete a listing.":
            listing_id: text "Listing id."
        | marketplace_listing_edit as "marketplace.listing.edit" -> marketplaceListingEdit since "2026-09-06" "Change a listing, or toggle it active.":
            listing_id: text "Listing id."
            is_active: bool? "Whether the listing is for sale."
            title: text? "Title."
            description: text? "Description."
            price_sats: int? "Price in satoshis."
        | marketplace_purchase_initiate as "marketplace.purchase.initiate" -> marketplacePurchaseInitiate since "2026-09-06" "Begin buying a listing: Themis answers the address and amount to pay; the content key is delivered on confirmation.":
            listing_id: text "Listing id."
            payment_currency: text "Which rail." one of "btc", "xrp"
        | marketplace_shop_close as "marketplace.shop.close" -> marketplaceShopClose since "2026-09-06" "Close the shop."
        | marketplace_shop_open as "marketplace.shop.open" -> marketplaceShopOpen since "2026-09-06" "Open a shop: register the BTC address proceeds are paid to. Requires identity verification.":
            btc_address: text "The seller's BTC address."
        | marketplace_subscription_create as "marketplace.subscription.create" -> marketplaceSubscriptionCreate since "2026-09-06" "Subscribe to a seller.":
            seller_pial: text "The seller."
        | message_number -> messageNumber since "2026-09-06" "Message a person through a Number, or release a message held for one.":
            number: text? "The Number typed."
            handle: text? "The person, when the Number is a key to their door; `to` is accepted too." also to
            body: text? "The message."
            pending_id: text? "A held message to release instead; `p` is accepted too." also p
        | message_read -> messageRead since "2026-09-06" "Mark a conversation read.":
            conversation_id: text "Conversation id; `c` is accepted too." also c
        | message_send -> messageSend since "2026-09-06" "Send a plaintext message into a conversation (sealed messages go to /api/gnosis/send-sealed).":
            conversation_id: text "Conversation id; `c` is accepted too." also c
            body: text "The message."
            reply_to: text? "Message replied to; `reply_to_id` is accepted too." also reply_to_id
        | message_start -> messageStart since "2026-09-06" "Start a conversation with a person by handle; the one answer shape whether or not it was delivered.":
            handle: text "Who; `to` is accepted too." also to
            body: text "The first message."
        | mute -> mute since "2026-09-06" "Mute a person.":
            target_handle: text "Handle without the @."
        | mute_keyword -> muteKeyword since "2026-09-06" "Mute a keyword.":
            keyword: text "The keyword."
        | nexus_persona_link_confirmed as "nexus.persona.link.confirmed" -> nexusPersonaLinkConfirmed since "2026-09-06" "Confirm a link request.":
            request_id: text "The link request."
        | nexus_persona_link_declined as "nexus.persona.link.declined" -> nexusPersonaLinkDeclined since "2026-09-06" "Decline a link request.":
            request_id: text "The link request."
        | nexus_persona_link_initiated as "nexus.persona.link.initiated" -> nexusPersonaLinkInitiated since "2026-09-06" "Ask another persona to link into this nexus.":
            target_pial_shard_id: text "The persona's PIAL shard."
        | nexus_persona_switched as "nexus.persona.switched" -> nexusPersonaSwitched since "2026-09-06" "Switch the active persona.":
            target_handle: text "The persona to switch to."
        | nexus_unified_view_toggled as "nexus.unified_view.toggled" -> nexusUnifiedViewToggled since "2026-09-06" "Toggle a unified view across personas.":
            mode: text "Which view." one of "notifications", "messages", "earnings"
        | not_interested -> notInterested since "2026-09-06" "Show fewer works like this one.":
            work_id: text "The work; `post_id` is accepted too." also post_id
            surface: text? "The feed surface it was seen on."
            session_id: text? "The browsing session."
        | note_create -> noteCreate since "2026-09-06" "Write a Context Note on a work.":
            work_id: text "The work."
            note_type: text "The note's type."
            body: text "The note."
            evidence_url: text? "A source."
        | note_rate -> noteRate since "2026-09-06" "Rate a Context Note.":
            note_id: text "Note id."
            rating: text "The rating."
        | note_request_review -> noteRequestReview since "2026-09-06" "Ask for a note to be reviewed.":
            note_id: text "Note id."
            work_id: text "The work."
        | notif_read -> notifRead since "2026-09-06" "Mark one notification read.":
            notif_id: text "Notification id; `id` is accepted too." also id
        | notif_read_all -> notifReadAll since "2026-09-06" "Mark every notification read."
        | notification_prefs -> notificationPrefs since "2026-09-06" "Patch what Herald may send; only fields present change.":
            push_enabled: bool? "Set when present."
            messages_enabled: bool? "Set when present."
            likes_enabled: bool? "Set when present."
            reposts_enabled: bool? "Set when present."
            replies_enabled: bool? "Set when present."
            follows_enabled: bool? "Set when present."
            achievements_enabled: bool? "Set when present."
            mentions_enabled: bool? "Set when present."
            frequencies_enabled: bool? "Set when present."
            quiet_hours_enabled: bool? "Set when present."
            quiet_hours_start: int? "Hour, 0–23."
            quiet_hours_end: int? "Hour, 0–23."
            timezone: text? "IANA time zone for quiet hours."
        | number_mint -> numberMint since "2026-09-06" "Mint a F33D3R Number.":
            policy: text "Who may reach this Number."
        | number_policy -> numberPolicy since "2026-09-06" "Change a Number's policy.":
