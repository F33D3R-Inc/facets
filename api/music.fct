import "entities.fct"
import "core.fct"

app F33D3RMusic:
    # A track as every music surface answers with it, for the viewer `me`.
    derive trackDTO(t: Track, me: int): TrackDTO = TrackDTO{
        id: "" + t.id,
        title: t.title,
        description: t.description,
        genre: t.genre,
        audio_url: t.audio_url,
        cover_url: t.cover_url,
        duration_secs: t.duration_secs,
        price_cents: t.price_cents,
        is_free: t.is_free,
        play_count: t.play_count,
        like_count: count(l in TrackLike where l.track == t.id),
        tags: [],
        created_at: iso(t.created),
        author: workAuthorDTO(Account(t.author), me)
        }
    # Tracks newest first, optionally one genre, paged by track id.
    action musicFeed(genre: text?, cursor: text?, limit: int?) -> V2PageOfTrackDTO:
        requires member
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let me = max(a.id in Account where a.handle == actor)
        let g = lower(trim(genre))
        let ids = list(t.id in Track where t.id < start && (g == "" || lower(t.genre) == g) by id desc limit n)
        let next = do nextCursor(ids, n)
        return V2PageOfTrackDTO{items: list(trackDTO(t, me) in Track where t.id in ids by id desc), next_cursor: next, server_time: iso(now())}
    action myTracks() -> V2MyTracksDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2MyTracksDTO{artist_stats: V2ArtistStatsDTO{total_tracks: count(t in Track where t.author == me), total_plays: sum(t.play_count in Track where t.author == me), total_likes: count(l in TrackLike where exists(t in Track where t.id == l.track && t.author == me))}, tracks: list(trackDTO(t, me) in Track where t.author == me by id desc)}
    action createTrack(title: text, description: text?, genre: text?, audio_url: text?, cover_url: text?, duration_secs: int?, price_cents: int?, is_free: bool?) -> TrackDTO:
        requires member
        check title != "" "a title is required"
        let me = max(a.id in Account where a.handle == actor)
        let tid = add Track { author: me, title: title, description: description, genre: genre, audio_url: audio_url, cover_url: cover_url, duration_secs: duration_secs, price_cents: price_cents, is_free: is_free, play_count: 0, created: now() }
        return trackDTO(Track(tid), me)
    action getTrack(id: int) -> TrackDTO:
        requires member
        check exists(t in Track where t.id == id) "no such track" status 404
        let me = max(a.id in Account where a.handle == actor)
        return trackDTO(Track(id), me)
    action likeTrack(id: int) -> V2TrackLikeDTO:
        requires member
        check exists(t in Track where t.id == id) "no such track" status 404
        let me = max(a.id in Account where a.handle == actor)
        if exists(l in TrackLike where l.track == id && l.account == me):
            remove l in TrackLike where l.track == id && l.account == me
        else:
            add TrackLike { track: id, account: me }
        return V2TrackLikeDTO{liked: exists(l in TrackLike where l.track == id && l.account == me), like_count: count(l in TrackLike where l.track == id)}
    action playTrack(id: int, event_type: text?, position_secs: text?, duration_secs: text?, session_id: text?):
        requires member
        check exists(t in Track where t.id == id) "no such track" status 404
        set Track(id).play_count = Track(id).play_count + 1

    action visionTray() -> V2VisionTrayDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2VisionTrayDTO{own: V2VisionRingDTO{count: 0, is_live: false, latest_at: iso(now()), state: "none", unseen_count: 0, visions: [], author: accountDTO(Account(me), me)}, rings: []}
    action createVision(body: text, content_type: text?, media_url: text?, audience: text?, is_nsfw: bool?, allow_replies: bool?, shared_work_id: text?, ttl_hours: int?, source: text?, poll_options: text?, artboard_align: text?, artboard_background: text?, artboard_type_scale: text?, artboard_typeface: text?) -> V2VisionCreatedDTO:
        requires member
        check body != "" || media_url != "" "say something"
        let me = max(a.id in Account where a.handle == actor)
        let hrs = do ttlOr(ttl_hours)
        let _h401 = do orTextV(audience, "public")
        let vid = add Vision { author: me, body: body, content_type: content_type, media_url: media_url, audience: _h401, is_nsfw: is_nsfw, allow_replies: allow_replies, shared_work_id: toInt(shared_work_id), created: now(), expires: now() + hrs * 3600 }
        return V2VisionCreatedDTO{vision_id: "" + vid}
    proc ttlOr(v: int) -> int:
        if v <= 0:
            return 24
        return v
    proc orTextV(v: text, fallback: text) -> text:
        if v == "":
            return fallback
        return v
    action deleteVision(id: int):
        requires member
        check Vision(id).author == max(a.id in Account where a.handle == actor) "not your vision" status 403
        remove Vision(id)
    action replyToVision(id: int, body: text):
        requires member
        check exists(v in Vision where v.id == id) "no such vision" status 404
        check body != "" "say something"
        let me = max(a.id in Account where a.handle == actor)
        add VisionReply { vision: id, account: me, body: body, created: now() }
    action viewVision(id: int):
        requires member
        check exists(v in Vision where v.id == id) "no such vision" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(x in VisionView where x.vision == id && x.account == me):
            add VisionView { vision: id, account: me, created: now() }
    action visionViewers(id: int) -> V2VisionViewersDTO:
        requires member
        check Vision(id).author == max(a.id in Account where a.handle == actor) "not your vision" status 403
        let me = max(a.id in Account where a.handle == actor)
        return V2VisionViewersDTO{count: count(v in VisionView where v.vision == id), viewers: list(accountDTO(Account(v.account), me) in VisionView where v.vision == id)}
    action voteVision(id: int, option_idx: int):
        requires member
        check exists(v in Vision where v.id == id) "no such vision" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(x in VisionVote where x.vision == id && x.account == me):
            add VisionVote { vision: id, account: me, option_idx: option_idx }
    action muteVisions(handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == handle)
        if !exists(m in VisionMute where m.account == me && m.target == target):
            add VisionMute { account: me, target: target }
    action unmuteVisions(handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == handle)
        remove m in VisionMute where m.account == me && m.target == target

    # This module's HTTP surface (merged into the app with the rest of it).
    api GET "/api/v2/music/feed" -> musicFeed rate read since "2026-09-18"
    api GET "/api/v2/music/mine" -> myTracks rate read since "2026-09-18"
    api POST "/api/v2/music/tracks" -> createTrack status 201 rate write since "2026-09-18"
    api GET "/api/v2/music/tracks/{id}" -> getTrack rate read since "2026-09-18"
    api POST "/api/v2/music/tracks/{id}/like" -> likeTrack rate write since "2026-09-18"
    api POST "/api/v2/music/tracks/{id}/play" -> playTrack status 204 rate write since "2026-09-18"
    api GET "/api/v2/visions" -> visionTray rate read since "2026-09-18"
    api POST "/api/v2/visions" -> createVision status 201 rate write since "2026-09-18"
    api DELETE "/api/v2/visions/{id}" -> deleteVision status 204 rate write since "2026-09-18"
    api POST "/api/v2/visions/{id}/replies" -> replyToVision status 204 rate write since "2026-09-18"
    api GET "/api/v2/visions/{id}/viewers" -> visionViewers rate read since "2026-09-18"
    api POST "/api/v2/visions/{id}/views" -> viewVision status 204 rate write since "2026-09-18"
    api POST "/api/v2/visions/{id}/votes" -> voteVision status 204 rate write since "2026-09-18"
    api PUT "/api/v2/visions/mutes/{handle}" -> muteVisions status 204 rate write since "2026-09-18"
    api DELETE "/api/v2/visions/mutes/{handle}" -> unmuteVisions status 204 rate write since "2026-09-18"
