        return V2SearchDTO{works: list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where contains(lower(w.body), lower(q)) && !w.deleted by id desc limit 20), people: list(V2AccountDTO{handle: Account(a.id).handle, display_name: Account(a.id).display_name, avatar_url: Account(a.id).avatar_url, header_url: Account(a.id).header_url, bio: Account(a.id).bio, location: Account(a.id).location, location_label: Account(a.id).location, website: Account(a.id).website, pronouns: Account(a.id).pronouns, accent_hex: Account(a.id).accent_hex, theme_id: Account(a.id).theme_id, official_type: Account(a.id).official_type, account_label: Account(a.id).account_label, is_private: Account(a.id).is_private, is_creator: Account(a.id).is_creator, is_verified: Account(a.id).is_verified, realm: Account(a.id).realm, realm_name: "aethyr", role: Account(a.id).role_type, xp: Account(a.id).xp, online: false, active_recently: true, post_count: count(w in Work where w.author == a.id && !w.deleted), follower_count: count(f in Follow where f.followee == a.id), following_count: count(f in Follow where f.follower == a.id), viewer_follows: exists(f in Follow where f.follower == me && f.followee == a.id)} in Account where contains(lower(a.handle), lower(q)) by id limit 20), tags: [], articles: [], communities: [], music: [], live: [], total: count(w in Work where contains(lower(w.body), lower(q)) && !w.deleted), did_you_mean: "", typo: false}
    action searchHistory() -> SearchHistoryDTO:
        requires member
        return SearchHistoryDTO{recent: []}
    action searchSaved() -> SavedSearchListDTO:
        requires member
        return SavedSearchListDTO{max: 20, saved: []}
    action searchSuggest(q: text?, type: text?) -> V2SearchSuggestDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let _h11 = do orText(q, "")
        let _h12 = do orText(q, "")
        return V2SearchSuggestDTO{query: _h11, people: list(V2AccountDTO{handle: Account(a.id).handle, display_name: Account(a.id).display_name, avatar_url: Account(a.id).avatar_url, header_url: Account(a.id).header_url, bio: Account(a.id).bio, location: Account(a.id).location, location_label: Account(a.id).location, website: Account(a.id).website, pronouns: Account(a.id).pronouns, accent_hex: Account(a.id).accent_hex, theme_id: Account(a.id).theme_id, official_type: Account(a.id).official_type, account_label: Account(a.id).account_label, is_private: Account(a.id).is_private, is_creator: Account(a.id).is_creator, is_verified: Account(a.id).is_verified, realm: Account(a.id).realm, realm_name: "aethyr", role: Account(a.id).role_type, xp: Account(a.id).xp, online: false, active_recently: true, post_count: count(w in Work where w.author == a.id && !w.deleted), follower_count: count(f in Follow where f.followee == a.id), following_count: count(f in Follow where f.follower == a.id), viewer_follows: exists(f in Follow where f.follower == me && f.followee == a.id)} in Account where contains(lower(a.handle), lower(_h12)) by id limit 5), tags: [], suggestions: []}
    action searchHistoryClear():
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove h in SearchHistoryEntry where h.account == me
    action searchHistoryForget(query: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove h in SearchHistoryEntry where h.account == me && h.query == query
    action searchSave(query: text, type: text?, name: text?):
        requires member
        check query != "" "a query is required"
        let me = max(a.id in Account where a.handle == actor)
        add SavedSearch { account: me, query: query, lane: type, name: name, created: now() }
    action searchUnsave(id: text?, query: text?, type: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let sid = toInt(id)
        if sid > 0:
            remove SavedSearch(sid)
        else:
            remove s in SavedSearch where s.account == me && s.query == query

    action history(limit: int?, cursor: text?) -> [V2HistoryEntryDTO]:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        return list(V2HistoryEntryDTO{viewed_at: "" + h.viewed, work: V2WorkDTO{id: "" + h.work, cid: "" + h.work, author: WorkAuthorDTO{handle: Account(Work(h.work).author).handle, display_name: Account(Work(h.work).author).display_name, avatar_url: Account(Work(h.work).author).avatar_url, is_creator: Account(Work(h.work).author).is_creator, is_verified: Account(Work(h.work).author).is_verified, official_type: Account(Work(h.work).author).official_type, realm: Account(Work(h.work).author).realm, role: Account(Work(h.work).author).role_type, is_mutual: false}, body: Work(h.work).body, kind: Work(h.work).kind, content_class: Work(h.work).content_class, content_type: Work(h.work).kind, created_at: "" + Work(h.work).created, is_nsfw: Work(h.work).is_nsfw, is_gore: Work(h.work).is_gore, is_sensitive: Work(h.work).is_sensitive, is_pinned: Work(h.work).is_pinned, is_edited: Work(h.work).edited, made_with_ai: Work(h.work).made_with_ai, paid_partnership: Work(h.work).paid_partnership, comment_gating: Work(h.work).comment_gating, like_count: count(l in Like where l.work == h.work), dislike_count: count(l in Dislike where l.work == h.work), liked_by_viewer: exists(l in Like where l.work == h.work && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == h.work && l.account == me), bookmark_count: count(b in Bookmark where b.work == h.work), bookmarked_by_viewer: exists(b in Bookmark where b.work == h.work && b.account == me), quote_count: count(w2 in Work where w2.quoted == h.work && !w2.deleted), repost_count: count(r in Repost where r.work == h.work), reply_count: count(w2 in Work where w2.parent_cid == h.work && !w2.deleted), purchased_by_viewer: false}} in History where h.account == me by viewed desc limit n)
    action historyClear():
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove h in History where h.account == me
    action viewTime(post_id: text, seconds: float, session_id: text?, surface: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        add ViewEvent { work: wid, account: me, seconds: round(seconds), created: now() }
        if !exists(h in History where h.account == me && h.work == wid):
            add History { account: me, work: wid, viewed: now() }
