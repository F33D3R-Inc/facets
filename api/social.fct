    api GET "/api/v2/notifications" -> notifications rate read since "2026-09-18"
    api GET "/api/v2/notifications/changes" -> notificationsChanges rate read since "2026-09-18"
    api GET "/api/v2/tags/trending" -> tagsTrending rate read since "2026-09-18"
    api GET "/api/v2/topics/snoozes" -> topicSnoozes rate read since "2026-09-18"
    api GET "/api/v2/search" -> search rate read since "2026-09-18"
    api GET "/api/v2/search/history" -> searchHistory rate read since "2026-09-18"
    api GET "/api/v2/search/saved" -> searchSaved rate read since "2026-09-18"
