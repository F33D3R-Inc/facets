import "entities.fct"
import "core.fct"
import "polls.fct"

# Feed, works, the social graph, notifications, search and tags — the core
# timeline surface layered on the Work/Follow/Like/Notification rows from
# entities.fct and the Account rows from core.fct.
app F33D3RSocial:
    policy ownsWork(id: int):
        Work(id).author == max(a.id in Account where a.handle == actor)
    policy notDeleted(id: int):
        !Work(id).deleted

    proc daysOr(v: int, fallback: int) -> int:
        if v <= 0:
            return fallback
        return v

    # A work as every surface answers with it — the feed, a thread, a profile's
    # works, search, bookmarks, history — for the viewer `me` (0 for a guest).
    # purchased_by_viewer is a WorkPurchase of a priced work (dealings.fct's
    # workPurchase); none is gated to subscribers, and no media scanner runs, so every work reads
    # scan_state "clean" (the legacy default for an unscanned work).
    # cid is the content id a signed work was published under (sha256:…),
    # else, for a work made unsigned, its id.
    derive workDTO(w: Work, me: int): V2WorkDTO = V2WorkDTO{
        id: "" + w.id,
        cid: first(list(x.cid in Work where x.id == w.id && x.cid != "") + ["" + w.id]),
        author: accountDTO(Account(w.author), me),
        body: w.body,
        kind: w.kind,
        content_class: w.content_class,
        content_type: w.kind,
        created_at: iso(w.created),
        is_nsfw: w.is_nsfw,
        is_gore: w.is_gore,
        is_sensitive: w.is_sensitive,
        is_pinned: w.is_pinned,
        is_edited: w.edited,
        made_with_ai: w.made_with_ai,
        paid_partnership: w.paid_partnership,
        comment_gating: w.comment_gating,
        like_count: count(l in Like where l.work == w.id),
        dislike_count: count(l in Dislike where l.work == w.id),
        liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me),
        disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me),
        bookmark_count: count(b in Bookmark where b.work == w.id),
        bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me),
        quote_count: count(q in Work where q.quoted == w.id && !q.deleted),
        repost_count: count(r in Repost where r.work == w.id),
        reposted_by_viewer: exists(r in Repost where r.work == w.id && r.account == me),
        reply_count: count(r in Work where r.parent_cid == w.id && !r.deleted),
        view_count: count(v in ViewEvent where v.work == w.id),
        viewer_follows_author: exists(f in Follow where f.follower == me && f.followee == w.author),
        purchased_by_viewer: exists(p in WorkPurchase where p.work == w.id && p.buyer == me),
        subscriber_only: false,
        scan_state: "clean",
        poll: first(list(pollV2(p, me) in Poll where p.work == w.id))
        }

    # The v1 notification the /api/v2/events stream carries (notification),
    # as the recipient `me` sees it.
    derive notificationV1(x: Notification, me: int): NotificationDTO = NotificationDTO{
        id: "" + x.id,
        kind: x.kind,
        target_type: x.target_type,
        target_id: "" + x.target_id,
        preview: x.preview,
        amount_uaet: x.amount_uaet,
        is_read: x.is_read,
        created_at: iso(x.created),
        actor_count: 1,
        actors: [workAuthorDTO(Account(x.actor), me)]
        }

    # The v1 work card the /api/v2/events stream carries (new_post, work_edited):
    # the same facts as workDTO for the viewer `me`, WorkAuthorDTO author.
    derive workCardDTO(w: Work, me: int): WorkDTO = WorkDTO{
        id: "" + w.id,
        cid: first(list(x.cid in Work where x.id == w.id && x.cid != "") + ["" + w.id]),
        author: workAuthorDTO(Account(w.author), me),
        body: w.body,
        kind: w.kind,
        content_type: w.kind,
        created_at: iso(w.created),
        is_nsfw: w.is_nsfw,
        is_gore: w.is_gore,
        is_sensitive: w.is_sensitive,
        is_pinned: w.is_pinned,
        is_edited: w.edited,
        made_with_ai: w.made_with_ai,
        paid_partnership: w.paid_partnership,
        comment_gating: w.comment_gating,
        like_count: count(l in Like where l.work == w.id),
        dislike_count: count(l in Dislike where l.work == w.id),
        liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me),
        disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me),
        bookmark_count: count(b in Bookmark where b.work == w.id),
        bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me),
        quote_count: count(q in Work where q.quoted == w.id && !q.deleted),
        repost_count: count(r in Repost where r.work == w.id),
        reposted_by_viewer: exists(r in Repost where r.work == w.id && r.account == me),
        reply_count: count(r in Work where r.parent_cid == w.id && !r.deleted),
        view_count: count(v in ViewEvent where v.work == w.id),
        viewer_follows_author: exists(f in Follow where f.follower == me && f.followee == w.author),
        work_purchased_by_viewer: exists(p in WorkPurchase where p.work == w.id && p.buyer == me),
        subscriber_only: false,
        scan_state: "clean",
        poll: first(list(pollV1(p, me) in Poll where p.work == w.id))
        }


    action getWork(id: int) -> V2WorkThreadDTO:
        requires member
        check exists(w in Work where w.id == id && !w.deleted) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        let replyIds = list(w.id in Work where w.parent_cid == id && !w.deleted by id desc limit 20)
        let next = do nextCursor(replyIds, 20)
        return V2WorkThreadDTO{work: workDTO(Work(id), me), ancestors: list(workDTO(w, me) in Work where w.id == Work(id).parent_cid), replies: V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in replyIds by id desc), next_cursor: next, server_time: iso(now())}}
    action getWorks(ids: [int]) -> V2PageOfV2WorkDTO:
        requires member
        check len(ids) >= 1 && len(ids) <= 100 "between 1 and 100 ids are required" status 400 code "ids_required"
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in ids && !w.deleted by id), next_cursor: "", server_time: iso(now())}
    # Replies and quotes, newest first: a work id is its creation order, so the
    # id cursor pages them exactly as cursorStart/nextCursor page every feed.
    action getWorkReplies(id: int, cursor: text?, limit: int?) -> V2PageOfV2WorkDTO:
        requires member
        check exists(w in Work where w.id == id && !w.deleted) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(w.id in Work where w.parent_cid == id && !w.deleted && w.id < start by id desc limit n)
        let next = do nextCursor(ids, n)
        return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in ids by id desc), next_cursor: next, server_time: iso(now())}
    action getWorkQuotes(id: int, cursor: text?, limit: int?) -> V2PageOfV2WorkDTO:
        requires member
        check exists(w in Work where w.id == id && !w.deleted) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(w.id in Work where w.quoted == id && !w.deleted && w.id < start by id desc limit n)
        let next = do nextCursor(ids, n)
        return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in ids by id desc), next_cursor: next, server_time: iso(now())}

    action post(body: text, is_nsfw: bool?, content_class: text?, made_with_ai: bool?, paid_partnership: bool?, comment_gating: text?, parent_cid: text?, quoted_work_id: text?, poll_options: [text]?, poll_ends_at: text?, poll_option_images: [text]?, poll_shuffle: bool?) -> WorkCreatedDTO:
        requires member
        check body != "" "say something"
        let me = max(a.id in Account where a.handle == actor)
        let parent = toInt(parent_cid)
        let quoted = toInt(quoted_work_id)
        let _h1 = do orText(comment_gating, "everyone")
        let wid = add Work { legacy_id: "", author: me, body: body, kind: "text", content_class: content_class, media_urls: "", is_nsfw: is_nsfw, is_gore: false, is_sensitive: false, is_pinned: false, made_with_ai: made_with_ai, paid_partnership: paid_partnership, parent_cid: parent, quoted: quoted, price_uaet: 0, comment_gating: _h1, deleted: false, edited: false, created: now(), edited_at: 0 }
        let tags = hashtags(body)
        for ht in tags:
            add WorkTag { work: wid, tag: ht, created: now() }
        # A ballot, when the work carries poll_options: one option per label,
        # index-aligned images (all or none), an optional end time.
        check len(poll_option_images) == 0 || len(poll_option_images) == len(poll_options) "poll_option_images must have one entry per option" status 400
        if len(poll_options) > 0:
            let pid = add Poll { work: wid, ends_at: fromIso(poll_ends_at), shuffle: poll_shuffle, created: now() }
            for label in poll_options:
                let at = count(o in PollOption where o.poll == pid)
                add PollOption { poll: pid, idx: at, label: label, image_url: pollImage(poll_option_images, at) }
        if parent > 0:
            let note4 = add Notification { account: Work(parent).author, actor: me, kind: "reply", target_type: "work", target_id: wid, preview: body, amount_uaet: 0, is_read: false, created: now() }
            emit notification notificationV1(Notification(note4), Work(parent).author) to Account(Work(parent).author).handle
            emit notify NotifyEventDTO{unread: count(n in Notification where n.account == Work(parent).author && !n.is_read)} to Account(Work(parent).author).handle
        for f in Follow where f.followee == me:
            emit new_post NewPostEventDTO{work_id: "" + wid, author_handle: actor, work: workCardDTO(Work(wid), f.follower)} to Account(f.follower).handle
        return WorkCreatedDTO{work_id: "" + wid, cid: "" + wid}
    action deleteWork(id: int):
        requires member
        requires ownsWork(id)
        set Work(id).deleted = true
        emit post_deleted WorkRemovedEventDTO{work_id: "" + id}
        for ww in WorkWatch where ww.work == id:
            emit work_removed WorkRemovedEventDTO{work_id: "" + id} to Account(ww.account).handle
    action editWork(id: int, body: text, made_with_ai: bool?, paid_partnership: bool?) -> V2WorkDTO:
        requires member
        requires ownsWork(id)
        check body != "" "say something"
        set Work(id).body = body
        set Work(id).made_with_ai = made_with_ai
        set Work(id).paid_partnership = paid_partnership
        if exists(d in BrandDeal where d.work == id && (d.status == "live" || d.status == "paid")):
            set Work(id).paid_partnership = true
        set Work(id).edited = true
        set Work(id).edited_at = now()
        let me = max(a.id in Account where a.handle == actor)
        for ww in WorkWatch where ww.work == id:
            emit work_edited WorkEventDTO{work_id: "" + id, work: workCardDTO(Work(id), ww.account)} to Account(ww.account).handle
        return workDTO(Work(id), me)
    action setWorkLabels(work_id: text, made_with_ai: bool?, paid_partnership: bool?):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        set Work(id).made_with_ai = made_with_ai
        set Work(id).paid_partnership = paid_partnership
        if exists(d in BrandDeal where d.work == id && (d.status == "live" || d.status == "paid")):
            set Work(id).paid_partnership = true
    action pinWork(post_id: text):
        requires member
        let id = toInt(post_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        for w in Work where w.author == me && w.is_pinned:
            set Work(w.id).is_pinned = false
        set Work(id).is_pinned = true
    action unpinWork(post_id: text):
        requires member
        let id = toInt(post_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        set Work(id).is_pinned = false

    action likeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        check exists(w in Work where w.id == id) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(l in Like where l.work == id && l.account == me):
            add Like { work: id, account: me }
            if Work(id).author != me:
                let note5 = add Notification { account: Work(id).author, actor: me, kind: "like", target_type: "work", target_id: id, preview: Work(id).body, amount_uaet: 0, is_read: false, created: now() }
                emit notification notificationV1(Notification(note5), Work(id).author) to Account(Work(id).author).handle
                emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == Work(id).author && !nn.is_read)} to Account(Work(id).author).handle
    action unlikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove l in Like where l.work == id && l.account == me
    action dislikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        if !exists(l in Dislike where l.work == id && l.account == me):
            add Dislike { work: id, account: me }
    action undislikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove l in Dislike where l.work == id && l.account == me
    action repostWork(work_id: text):
        requires member
        let id = toInt(work_id)
        check exists(w in Work where w.id == id) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(r in Repost where r.work == id && r.account == me):
            add Repost { work: id, account: me }
            if Work(id).author != me:
                let note6 = add Notification { account: Work(id).author, actor: me, kind: "repost", target_type: "work", target_id: id, preview: Work(id).body, amount_uaet: 0, is_read: false, created: now() }
                emit notification notificationV1(Notification(note6), Work(id).author) to Account(Work(id).author).handle
                emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == Work(id).author && !nn.is_read)} to Account(Work(id).author).handle
    action unrepostWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove r in Repost where r.work == id && r.account == me
    action bookmarkWork(work_id: text, folder_id: text?):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        let f = toInt(folder_id)
        if !exists(b in Bookmark where b.work == id && b.account == me):
            add Bookmark { work: id, account: me, folder: f }
    action unbookmarkWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove b in Bookmark where b.work == id && b.account == me
    action watchPost(post_id: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        check exists(w in Work where w.id == wid) "no such work" status 404
        if !exists(v in WorkWatch where v.account == me && v.work == wid):
            add WorkWatch { account: me, work: wid }
    action unwatchPost(post_id: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        remove v in WorkWatch where v.account == me && v.work == wid
    action notInterested(work_id: text, surface: text?, session_id: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(work_id)
        if !exists(m in Mute where m.account == me && m.target == Work(wid).author):
            add ViewEvent { work: wid, account: me, seconds: 0, created: now() }
    action reportWork(reason: text, post_id: text?, target_handle: text?, detail: text?):
        requires member
        check reason != "" "a reason is required"
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        let th = do orText(target_handle, "")
        let target = max(a.id in Account where a.handle == th)
        add Report { reporter: me, reason: reason, work: wid, target: target, detail: detail, created: now() }

    action createList(name: text, description: text?, is_public: bool?):
        requires member
        check name != "" "a name is required"
        let me = max(a.id in Account where a.handle == actor)
        add WorkList { owner: me, name: name, description: description, is_public: is_public, created: now() }
    action deleteList(list_id: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        remove m in ListMember where m.list == id
        remove WorkList(id)
    action listAddMember(list_id: text, handle: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let target = max(a.id in Account where a.handle == handle)
        if !exists(m in ListMember where m.list == id && m.account == target):
            add ListMember { list: id, account: target }
    action listRemoveMember(list_id: text, handle: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let target = max(a.id in Account where a.handle == handle)
        remove m in ListMember where m.list == id && m.account == target

    action bookmarksPage(filter: text?, folder: text?, limit: int?, cursor: text?) -> V2BookmarkPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(b.work in Bookmark where b.account == me && b.work < start by work desc limit n)
        let _h2 = do nextCursor(ids, n)
        return V2BookmarkPageDTO{items: list(workDTO(w, me) in Work where w.id in ids by id), all_count: count(b in Bookmark where b.account == me), folder: folder, folders: list(V2BookmarkFolderDTO{id: "" + f.id, name: f.name, position: f.position, count: count(b in Bookmark where b.folder == f.id), created_at: iso(f.created)} in BookmarkFolder where f.account == me by position), next_cursor: _h2, server_time: iso(now())}
    action bookmarkFolders() -> V2BookmarkFolderListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2BookmarkFolderListDTO{all_count: count(b in Bookmark where b.account == me), folders: list(V2BookmarkFolderDTO{id: "" + f.id, name: f.name, position: f.position, count: count(b in Bookmark where b.folder == f.id), created_at: iso(f.created)} in BookmarkFolder where f.account == me by position)}
    action createBookmarkFolder(name: text, work_id: text?, filter: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let fid = add BookmarkFolder { account: me, name: name, position: count(f in BookmarkFolder where f.account == me), created: now() }
        let wid = toInt(work_id)
        if wid > 0:
            add Bookmark { work: wid, account: me, folder: fid }
    action deleteBookmarkFolder(folder_id: text, filter: text?):
        requires member
        let fid = toInt(folder_id)
        remove b in Bookmark where b.folder == fid
        remove BookmarkFolder(fid)
    action renameBookmarkFolder(folder_id: text, name: text, filter: text?):
        requires member
        set BookmarkFolder(toInt(folder_id)).name = name

    action follow(target_handle: text?, target_pial: text?, source: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let _h3 = do orText(target_handle, "")
        let target = max(a.id in Account where a.handle == _h3)
        check target > 0 "no such account" status 404
        if !exists(f in Follow where f.follower == me && f.followee == target):
            add Follow { follower: me, followee: target, created: now() }
            let note7 = add Notification { account: target, actor: me, kind: "follow", target_type: "account", target_id: me, preview: "", amount_uaet: 0, is_read: false, created: now() }
            emit notification notificationV1(Notification(note7), target) to Account(target).handle
            emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == target && !nn.is_read)} to Account(target).handle
    action unfollow(target_handle: text?, target_pial: text?, source: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let _h4 = do orText(target_handle, "")
        let target = max(a.id in Account where a.handle == _h4)
        remove f in Follow where f.follower == me && f.followee == target
    action block(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == target_handle)
        check target > 0 "no such account" status 404
        if !exists(b in Block where b.account == me && b.target == target):
            add Block { account: me, target: target }
        remove f in Follow where f.follower == target && f.followee == me
    action unblock(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == target_handle)
        remove b in Block where b.account == me && b.target == target
    action mute(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == target_handle)
        check target > 0 "no such account" status 404
        if !exists(m in Mute where m.account == me && m.target == target):
            add Mute { account: me, target: target }
    action unmute(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == target_handle)
        remove m in Mute where m.account == me && m.target == target
    action circleAdd(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        check exists(a in Account where a.handle == target_handle) "no such user" status 404
        let target = max(a.id in Account where a.handle == target_handle)
        if !exists(c in Circle where c.account == me && c.target == target):
            add Circle { account: me, target: target }
    action circleRemove(target_handle: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let target = max(a.id in Account where a.handle == target_handle)
        remove c in Circle where c.account == me && c.target == target

    action getUsers(handles: [text]) -> V2PageOfV2AccountDTO:
        check len(handles) >= 1 && len(handles) <= 100 "between 1 and 100 handles are required" status 400 code "handles_required"
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfV2AccountDTO{items: list(accountDTO(a, me) in Account where a.handle in handles && !a.deactivated by id), next_cursor: "", server_time: iso(now())}
    action getProfile(handle: text) -> V2ProfileDTO:
        requires member
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let id = max(a.id in Account where a.handle == handle)
        let me = max(a.id in Account where a.handle == actor)
        return V2ProfileDTO{account: accountDTO(Account(id), me), viewer_follows: exists(f in Follow where f.follower == me && f.followee == id), follows_viewer: exists(f in Follow where f.follower == id && f.followee == me), viewer_is_blocked: exists(b in Block where b.account == id && b.target == me)}
    action getFollowers(handle: text, cursor: text?, limit: int?, active: text?) -> V2AccountsPageDTO:
        requires member
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let id = max(a.id in Account where a.handle == handle)
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(f.follower in Follow where f.followee == id && f.follower < start by follower desc limit n)
        let _h5 = do nextCursor(ids, n)
        return V2AccountsPageDTO{items: list(accountDTO(a, me) in Account where a.id in ids by id), active_count: 0, active_only: false, next_cursor: _h5, server_time: iso(now())}
    action getFollowing(handle: text, cursor: text?, limit: int?, active: text?) -> V2AccountsPageDTO:
        requires member
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let id = max(a.id in Account where a.handle == handle)
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(f.followee in Follow where f.follower == id && f.followee < start by followee desc limit n)
        let _h6 = do nextCursor(ids, n)
        return V2AccountsPageDTO{items: list(accountDTO(a, me) in Account where a.id in ids by id), active_count: 0, active_only: false, next_cursor: _h6, server_time: iso(now())}
    # A profile's works by tab, newest first: works (top-level posts), replies,
    # media, and the owner-only likes/saves. Every tab pages by work id.
    action getUserWorks(handle: text, tab: text?, sort: text?, limit: int?, cursor: text?) -> V2PageOfV2WorkDTO:
        requires member
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let id = max(a.id in Account where a.handle == handle)
        let me = max(a.id in Account where a.handle == actor)
        let t = do orText(tab, "works")
        check t == "works" || t == "replies" || t == "media" || t == "likes" || t == "saves" "no such tab" status 400 code "unknown_tab"
        check t != "likes" || id == me "Nobody but @{handle} can see what they have liked." status 403 code "likes_private"
        check t != "saves" || id == me "Saves are private." status 403 code "saves_private"
        check !Account(id).is_private || id == me || exists(f in Follow where f.follower == me && f.followee == id) "This account is private." status 403 code "private_account"
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        if t == "likes":
            let liked = list(l.work in Like where l.account == id && l.work < start by work desc limit n)
            let likedNext = do nextCursor(liked, n)
            return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in liked && !w.deleted by id desc), next_cursor: likedNext, server_time: iso(now())}
        if t == "saves":
            let saved = list(b.work in Bookmark where b.account == id && b.work < start by work desc limit n)
            let savedNext = do nextCursor(saved, n)
            return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in saved && !w.deleted by id desc), next_cursor: savedNext, server_time: iso(now())}
        let own = list(w.id in Work where w.author == id && !w.deleted && w.id < start && ((t == "works" && w.parent_cid == 0) || (t == "replies" && w.parent_cid > 0) || (t == "media" && w.media_urls != "")) by id desc limit n)
        let next = do nextCursor(own, n)
        return V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in own by id desc), next_cursor: next, server_time: iso(now())}
    action getBlocks() -> V2PageOfV2AccountDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfV2AccountDTO{items: list(accountDTO(a, me) in Account where exists(b in Block where b.account == me && b.target == a.id) by id), next_cursor: "", server_time: iso(now())}
    action getMutes() -> V2PageOfV2AccountDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfV2AccountDTO{items: list(accountDTO(a, me) in Account where exists(m in Mute where m.account == me && m.target == a.id) by id), next_cursor: "", server_time: iso(now())}

    action feed(surface: text?, tag: text?, session_id: text?, limit: int?, cursor: text?) -> V2FeedPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(w.id in Work where w.id < start && !w.deleted by id desc limit n)
        let _h7 = do nextCursor(ids, n)
        return V2FeedPageDTO{items: list(workDTO(w, me) in Work where w.id in ids by id desc), next_cursor: _h7, server_time: iso(now()), live_count: 0}
    action feedChanges(surface: text?, since: text, limit: int?) -> V2FeedPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let sinceId = toInt(since)
        let n = do pageSize(limit, 20, 50)
        return V2FeedPageDTO{items: list(workDTO(w, me) in Work where w.id > sinceId && !w.deleted by id desc limit n), next_cursor: "", server_time: iso(now())}

    action notifications(tab: text?, limit: int?, cursor: text?) -> V2NotificationsPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(x.id in Notification where x.account == me && x.id < start by id desc limit n)
        let _h8 = do nextCursor(ids, n)
        let _h9 = do orText(tab, "all")
        return V2NotificationsPageDTO{items: list(V2NotificationDTO{id: "" + x.id, kind: x.kind, target_type: x.target_type, target_id: "" + x.target_id, preview: x.preview, amount_uaet: x.amount_uaet, is_read: x.is_read, created_at: iso(x.created), actor_count: 1, actors: [accountDTO(Account(x.actor), me)]} in Notification where x.id in ids by id desc), next_cursor: _h8, server_time: iso(now()), tab: _h9, unread_count: count(x in Notification where x.account == me && !x.is_read)}
    action notificationsChanges(since: text, tab: text?, limit: int?) -> V2NotificationsPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let sinceId = toInt(since)
        let n = do pageSize(limit, 20, 50)
        let _h10 = do orText(tab, "all")
        return V2NotificationsPageDTO{items: list(V2NotificationDTO{id: "" + x.id, kind: x.kind, target_type: x.target_type, target_id: "" + x.target_id, preview: x.preview, amount_uaet: x.amount_uaet, is_read: x.is_read, created_at: iso(x.created), actor_count: 1, actors: [accountDTO(Account(x.actor), me)]} in Notification where x.account == me && x.id > sinceId by id desc limit n), next_cursor: "", server_time: iso(now()), tab: _h10, unread_count: count(x in Notification where x.account == me && !x.is_read)}
    # Only the caller's own row is marked; their badge follows on every
    # connection they have open.
    action notifRead(notif_id: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let nid = toInt(notif_id)
        check notif_id != "" "notif_id required" status 400
        check exists(x in Notification where x.id == nid && x.account == me) "notification not found" status 404
        set Notification(nid).is_read = true
        emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == me && !nn.is_read)} to actor
    action notifReadAll():
        requires member
        let me = max(a.id in Account where a.handle == actor)
        for x in Notification where x.account == me && !x.is_read:
            set Notification(x.id).is_read = true
        emit notify NotifyEventDTO{unread: 0} to actor

    # A body's #hashtags: each `#` followed by letters, digits or `_`,
    # lowercased, without the `#`, each once, in order of first use.
    proc hashtags(body: text) -> [text]:
        let mut out = []
        let mut i = 0
        let n = len(body)
        loop i < n:
            if charAt(body, i) == "#":
                let mut j = i + 1
                loop j < n && contains("abcdefghijklmnopqrstuvwxyz0123456789_", lower(charAt(body, j))):
                    j = j + 1
                if j > i + 1:
                    let tag = lower(slice(body, i + 1, j))
                    let mut seen = false
                    let mut k = 0
                    loop k < len(out):
                        if out[k] == tag:
                            seen = true
                        k = k + 1
                    if !seen:
                        out = append(out, tag)
                i = j
            else:
                i = i + 1
        return out

    # GET /api/v2/tags/trending — the 12 tags on the most live works of the
    # last 7 days, most used first (the legacy query, over WorkTag rows).
    action tagsTrending() -> V2PageOfTagDTO:
        requires member
        let since = now() - 604800
        let items = list(TagDTO{tag: t.tag, count: count(x in WorkTag where x.tag == t.tag && x.created > since && !Work(x.work).deleted)} in WorkTag where t.created > since && !Work(t.work).deleted && t.id == min(y.id in WorkTag where y.tag == t.tag && y.created > since && !Work(y.work).deleted) by count(x in WorkTag where x.tag == t.tag && x.created > since && !Work(x.work).deleted) desc limit 12)
        return V2PageOfTagDTO{items: items, next_cursor: "", server_time: iso(now())}
    action followTopic(tag: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        if !exists(t in TopicFollow where t.account == me && t.tag == tag):
            add TopicFollow { account: me, tag: tag }
    action unfollowTopic(tag: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove t in TopicFollow where t.account == me && t.tag == tag
    # The caller's snoozes in force, soonest to expire first; expired rows
    # are dropped as they are found.
    action topicSnoozes() -> TopicSnoozesDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let at = now()
        remove t in TopicSnooze where t.account == me && t.until <= at
        return topicSnoozesV1(me, at)
    # A #tag, or a feed surface as a whole (its tags and its own id), hidden
    # for 7 or 30 days; snoozing again extends, never stacks.
    action snoozeTopic(tag: text?, surface_id: text?, days: int?, answer: text?) -> TopicSnoozesDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let sid = lower(trim(surface_id))
        let one = seTag(tag)
        check sid != "" || seValidTag(one) "tag required" status 400
        check sid == "" || exists(s in FeedSurface where s.slug == sid && s.is_active && s.surface_type == "interest") "unknown surface" status 404
        check days == 7 || days == 30 "days must be 7 or 30" status 400
        let covered = seSurfaceTags(max(s.tags in FeedSurface where sid != "" && s.slug == sid), sid)
        let tags = seTopicSet(sid, covered, one)
        let at = now()
        let until = at + days * 86400
        for t in tags:
            remove x in TopicSnooze where x.account == me && x.tag == t
            add TopicSnooze { account: me, tag: t, surface_id: sid, until: until }
        remove t in TopicSnooze where t.account == me && t.until <= at
        return topicSnoozesV1(me, at)
    action unsnoozeTopic(tag: text?, surface_id: text?, days: int?, answer: text?) -> TopicSnoozesDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let sid = lower(trim(surface_id))
        let one = seTag(tag)
        check sid != "" || seValidTag(one) "tag required" status 400
        check sid == "" || exists(s in FeedSurface where s.slug == sid && s.is_active && s.surface_type == "interest") "unknown surface" status 404
        let covered = seSurfaceTags(max(s.tags in FeedSurface where sid != "" && s.slug == sid), sid)
        let tags = seTopicSet(sid, covered, one)
        let at = now()
        for t in tags:
            remove x in TopicSnooze where x.account == me && x.tag == t
        remove t in TopicSnooze where t.account == me && t.until <= at
        return topicSnoozesV1(me, at)

    action search(q: text, type: text?, sort: text?, page: int?) -> V2SearchDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2SearchDTO{works: list(workDTO(w, me) in Work where contains(lower(w.body), lower(q)) && !w.deleted by id desc limit 20), people: list(accountDTO(a, me) in Account where contains(lower(a.handle), lower(q)) by id limit 20), tags: [], articles: [], communities: [], music: [], live: [], total: count(w in Work where contains(lower(w.body), lower(q)) && !w.deleted), did_you_mean: "", typo: false}
    action searchHistory() -> SearchHistoryDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return searchHistoryV1(me)
    action searchSaved() -> SavedSearchListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return savedSearchListV1(me)
    action searchSuggest(q: text?, type: text?) -> V2SearchSuggestDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let _h11 = do orText(q, "")
        let _h12 = do orText(q, "")
        return V2SearchSuggestDTO{query: _h11, people: list(accountDTO(a, me) in Account where contains(lower(a.handle), lower(_h12)) by id limit 5), tags: [], suggestions: []}
    # Searches are keyed case-folded with their whitespace collapsed: "NFL
    # Draft" and " nfl  draft" are one search. Each answers the list re-read.
    action searchHistoryClear() -> SearchHistoryDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove h in SearchHistoryEntry where h.account == me
        return searchHistoryV1(me)
    action searchHistoryForget(query: text) -> SearchHistoryDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let key = lower(seSearchNorm(query))
        remove h in SearchHistoryEntry where h.account == me && lower(h.query) == key
        return searchHistoryV1(me)
    # Keep a search (at most 50); keeping one already kept for that lane
    # answers the list as it stands. A name keeps 40 characters.
    action searchSave(query: text, type: text?, name: text?) -> SavedSearchListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let q = seSearchNorm(query)
        check q != "" "type something to save" status 400
        let lane = seLane(type)
        if !exists(s in SavedSearch where s.account == me && lower(s.query) == lower(q) && s.lane == lane):
            check count(s in SavedSearch where s.account == me) < 50 "you can keep up to 50 saved searches" status 400
            add SavedSearch { account: me, query: q, lane: lane, name: seTruncate(trim(name), 40), created: now(), last_seen: now() }
        return savedSearchListV1(me)
    # Drop one of the caller's saved searches, by id or by query + lane.
    action searchUnsave(id: text?, query: text?, type: text?) -> SavedSearchListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let key = lower(seSearchNorm(query))
        let lane = seLane(type)
        let sid = toInt(id)
        let found = max(s.id in SavedSearch where s.account == me && ((id != "" && s.id == sid) || (id == "" && lower(s.query) == key && s.lane == lane)))
        check found > 0 "saved search not found" status 404
        remove SavedSearch(found)
        return savedSearchListV1(me)

    # Most recently viewed first; the cursor is the viewed instant of the last
    # entry on the previous page.
    action history(limit: int?, cursor: text?) -> V2PageOfV2HistoryEntryDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let seen = list(h.viewed in History where h.account == me && h.viewed < start by viewed desc limit n)
        let next = do nextCursor(seen, n)
        return V2PageOfV2HistoryEntryDTO{items: list(V2HistoryEntryDTO{viewed_at: iso(h.viewed), work: workDTO(Work(h.work), me)} in History where h.account == me && h.viewed < start && !Work(h.work).deleted by viewed desc limit n), next_cursor: next, server_time: iso(now())}
    action historyClear():
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove h in History where h.account == me
    action viewTime(post_id: text, seconds: float, session_id: text?, surface: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        add ViewEvent { work: wid, account: me, seconds: round(seconds), created: now() }
        if !exists(h in History where h.account == me && h.work == wid):
            add History { account: me, work: wid, viewed: now() }

