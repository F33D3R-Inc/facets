import "entities.fct"
import "core.fct"

# Feed, works, the social graph, notifications, search and tags — the core
# timeline surface layered on the Work/Follow/Like/Notification rows from
# entities.fct and the Account rows from core.fct.
app F33D3RSocial:
    policy ownsWork(id: int):
        Work(id).author == max(a.id in Account where a.handle == actor)
    policy notDeleted(id: int):
        !Work(id).deleted

    proc daysOr(v: int, fallback: int) -> int:
        if v <= 0:
            return fallback
        return v


    action getWork(id: int) -> V2WorkThreadDTO:
        check exists(w in Work where w.id == id && !w.deleted) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        return V2WorkThreadDTO{work: V2WorkDTO{id: "" + id, cid: "" + id, author: WorkAuthorDTO{handle: Account(Work(id).author).handle, display_name: Account(Work(id).author).display_name, avatar_url: Account(Work(id).author).avatar_url, is_creator: Account(Work(id).author).is_creator, is_verified: Account(Work(id).author).is_verified, official_type: Account(Work(id).author).official_type, realm: Account(Work(id).author).realm, role: Account(Work(id).author).role_type, is_mutual: false}, body: Work(id).body, kind: Work(id).kind, content_class: Work(id).content_class, content_type: Work(id).kind, created_at: "" + Work(id).created, is_nsfw: Work(id).is_nsfw, is_gore: Work(id).is_gore, is_sensitive: Work(id).is_sensitive, is_pinned: Work(id).is_pinned, is_edited: Work(id).edited, made_with_ai: Work(id).made_with_ai, paid_partnership: Work(id).paid_partnership, comment_gating: Work(id).comment_gating, like_count: count(l in Like where l.work == id), dislike_count: count(l in Dislike where l.work == id), liked_by_viewer: exists(l in Like where l.work == id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == id && l.account == me), bookmark_count: count(b in Bookmark where b.work == id), bookmarked_by_viewer: exists(b in Bookmark where b.work == id && b.account == me), quote_count: count(w2 in Work where w2.quoted == id && !w2.deleted), repost_count: count(r in Repost where r.work == id), reply_count: count(w2 in Work where w2.parent_cid == id && !w2.deleted), purchased_by_viewer: false}, ancestors: list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where w.id == Work(id).parent_cid), replies: list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where w.parent_cid == id && !w.deleted by created desc limit 50)}
    action getWorks(ids: text) -> [V2WorkDTO]:
        let me = max(a.id in Account where a.handle == actor)
        return list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where w.id > 0 && !w.deleted && contains(ids, "" + w.id) by id)
    action getWorkReplies(id: int, cursor: text?, limit: int?) -> [V2WorkDTO]:
        let me = max(a.id in Account where a.handle == actor)
        return list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where w.parent_cid == id && !w.deleted by created desc limit 50)
    action getWorkQuotes(id: int, cursor: text?, limit: int?) -> [V2WorkDTO]:
        let me = max(a.id in Account where a.handle == actor)
        return list(V2WorkDTO{id: "" + w.id, cid: "" + w.id, author: WorkAuthorDTO{handle: Account(Work(w.id).author).handle, display_name: Account(Work(w.id).author).display_name, avatar_url: Account(Work(w.id).author).avatar_url, is_creator: Account(Work(w.id).author).is_creator, is_verified: Account(Work(w.id).author).is_verified, official_type: Account(Work(w.id).author).official_type, realm: Account(Work(w.id).author).realm, role: Account(Work(w.id).author).role_type, is_mutual: false}, body: Work(w.id).body, kind: Work(w.id).kind, content_class: Work(w.id).content_class, content_type: Work(w.id).kind, created_at: "" + Work(w.id).created, is_nsfw: Work(w.id).is_nsfw, is_gore: Work(w.id).is_gore, is_sensitive: Work(w.id).is_sensitive, is_pinned: Work(w.id).is_pinned, is_edited: Work(w.id).edited, made_with_ai: Work(w.id).made_with_ai, paid_partnership: Work(w.id).paid_partnership, comment_gating: Work(w.id).comment_gating, like_count: count(l in Like where l.work == w.id), dislike_count: count(l in Dislike where l.work == w.id), liked_by_viewer: exists(l in Like where l.work == w.id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w.id && l.account == me), bookmark_count: count(b in Bookmark where b.work == w.id), bookmarked_by_viewer: exists(b in Bookmark where b.work == w.id && b.account == me), quote_count: count(w2 in Work where w2.quoted == w.id && !w2.deleted), repost_count: count(r in Repost where r.work == w.id), reply_count: count(w2 in Work where w2.parent_cid == w.id && !w2.deleted), purchased_by_viewer: false} in Work where w.quoted == id && !w.deleted by created desc limit 50)

    action post(body: text, is_nsfw: bool?, content_class: text?, made_with_ai: bool?, paid_partnership: bool?, comment_gating: text?, parent_cid: text?, quoted_work_id: text?) -> WorkCreatedDTO:
        requires member
        check body != "" "say something"
        let me = max(a.id in Account where a.handle == actor)
        let parent = toInt(parent_cid)
        let quoted = toInt(quoted_work_id)
        let _h1 = do orText(comment_gating, "everyone")
        let wid = add Work { author: me, body: body, kind: "text", content_class: content_class, media_urls: "", is_nsfw: is_nsfw, is_gore: false, is_sensitive: false, is_pinned: false, made_with_ai: made_with_ai, paid_partnership: paid_partnership, parent_cid: parent, quoted: quoted, price_uaet: 0, comment_gating: _h1, deleted: false, edited: false, created: now(), edited_at: 0 }
        if parent > 0:
            add Notification { account: Work(parent).author, actor: me, kind: "reply", target_type: "work", target_id: wid, preview: body, amount_uaet: 0, is_read: false, created: now() }
        return WorkCreatedDTO{work_id: "" + wid, cid: "" + wid}
    action deleteWork(id: int):
        requires member
        requires ownsWork(id)
        set Work(id).deleted = true
    action editWork(id: int, body: text, made_with_ai: bool?, paid_partnership: bool?) -> V2WorkDTO:
        requires member
        requires ownsWork(id)
        check body != "" "say something"
        set Work(id).body = body
        set Work(id).made_with_ai = made_with_ai
        set Work(id).paid_partnership = paid_partnership
        set Work(id).edited = true
        set Work(id).edited_at = now()
        let me = max(a.id in Account where a.handle == actor)
        return V2WorkDTO{id: "" + id, cid: "" + id, author: WorkAuthorDTO{handle: Account(Work(id).author).handle, display_name: Account(Work(id).author).display_name, avatar_url: Account(Work(id).author).avatar_url, is_creator: Account(Work(id).author).is_creator, is_verified: Account(Work(id).author).is_verified, official_type: Account(Work(id).author).official_type, realm: Account(Work(id).author).realm, role: Account(Work(id).author).role_type, is_mutual: false}, body: Work(id).body, kind: Work(id).kind, content_class: Work(id).content_class, content_type: Work(id).kind, created_at: "" + Work(id).created, is_nsfw: Work(id).is_nsfw, is_gore: Work(id).is_gore, is_sensitive: Work(id).is_sensitive, is_pinned: Work(id).is_pinned, is_edited: Work(id).edited, made_with_ai: Work(id).made_with_ai, paid_partnership: Work(id).paid_partnership, comment_gating: Work(id).comment_gating, like_count: count(l in Like where l.work == id), dislike_count: count(l in Dislike where l.work == id), liked_by_viewer: exists(l in Like where l.work == id && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == id && l.account == me), bookmark_count: count(b in Bookmark where b.work == id), bookmarked_by_viewer: exists(b in Bookmark where b.work == id && b.account == me), quote_count: count(w2 in Work where w2.quoted == id && !w2.deleted), repost_count: count(r in Repost where r.work == id), reply_count: count(w2 in Work where w2.parent_cid == id && !w2.deleted), purchased_by_viewer: false}
    action setWorkLabels(work_id: text, made_with_ai: bool?, paid_partnership: bool?):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        set Work(id).made_with_ai = made_with_ai
        set Work(id).paid_partnership = paid_partnership
    action pinWork(post_id: text):
        requires member
        let id = toInt(post_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        for w in Work where w.author == me && w.is_pinned:
            set Work(w.id).is_pinned = false
        set Work(id).is_pinned = true
    action unpinWork(post_id: text):
        requires member
        let id = toInt(post_id)
        let me = max(a.id in Account where a.handle == actor)
        check Work(id).author == me "not your work" status 403
        set Work(id).is_pinned = false

    action likeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        check exists(w in Work where w.id == id) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(l in Like where l.work == id && l.account == me):
            add Like { work: id, account: me }
            if Work(id).author != me:
                add Notification { account: Work(id).author, actor: me, kind: "like", target_type: "work", target_id: id, preview: Work(id).body, amount_uaet: 0, is_read: false, created: now() }
    action unlikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove l in Like where l.work == id && l.account == me
    action dislikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        if !exists(l in Dislike where l.work == id && l.account == me):
            add Dislike { work: id, account: me }
    action undislikeWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove l in Dislike where l.work == id && l.account == me
    action repostWork(work_id: text):
        requires member
        let id = toInt(work_id)
        check exists(w in Work where w.id == id) "no such work" status 404
        let me = max(a.id in Account where a.handle == actor)
        if !exists(r in Repost where r.work == id && r.account == me):
            add Repost { work: id, account: me }
            if Work(id).author != me:
                add Notification { account: Work(id).author, actor: me, kind: "repost", target_type: "work", target_id: id, preview: Work(id).body, amount_uaet: 0, is_read: false, created: now() }
    action unrepostWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove r in Repost where r.work == id && r.account == me
    action bookmarkWork(work_id: text, folder_id: text?):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        let f = toInt(folder_id)
        if !exists(b in Bookmark where b.work == id && b.account == me):
            add Bookmark { work: id, account: me, folder: f }
    action unbookmarkWork(work_id: text):
        requires member
        let id = toInt(work_id)
        let me = max(a.id in Account where a.handle == actor)
        remove b in Bookmark where b.work == id && b.account == me
    action watchPost(post_id: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        check exists(w in Work where w.id == wid) "no such work" status 404
        if !exists(v in WorkWatch where v.account == me && v.work == wid):
            add WorkWatch { account: me, work: wid }
    action unwatchPost(post_id: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        remove v in WorkWatch where v.account == me && v.work == wid
    action notInterested(work_id: text, surface: text?, session_id: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(work_id)
        if !exists(m in Mute where m.account == me && m.target == Work(wid).author):
            add ViewEvent { work: wid, account: me, seconds: 0, created: now() }
    action reportWork(reason: text, post_id: text?, target_handle: text?, detail: text?):
        requires member
        check reason != "" "a reason is required"
        let me = max(a.id in Account where a.handle == actor)
        let wid = toInt(post_id)
        let th = do orText(target_handle, "")
        let target = max(a.id in Account where a.handle == th)
        add Report { reporter: me, reason: reason, work: wid, target: target, detail: detail, created: now() }

    action createList(name: text, description: text?, is_public: bool?):
        requires member
        check name != "" "a name is required"
        let me = max(a.id in Account where a.handle == actor)
        add WorkList { owner: me, name: name, description: description, is_public: is_public, created: now() }
    action deleteList(list_id: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        remove m in ListMember where m.list == id
        remove WorkList(id)
    action listAddMember(list_id: text, handle: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let target = max(a.id in Account where a.handle == handle)
        if !exists(m in ListMember where m.list == id && m.account == target):
            add ListMember { list: id, account: target }
    action listRemoveMember(list_id: text, handle: text):
        requires member
        let id = toInt(list_id)
        let me = max(a.id in Account where a.handle == actor)
        check WorkList(id).owner == me "not your list" status 403
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let target = max(a.id in Account where a.handle == handle)
        remove m in ListMember where m.list == id && m.account == target

    action bookmarksPage(filter: text?, folder: text?, limit: int?, cursor: text?) -> V2BookmarkPageDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(b.work in Bookmark where b.account == me && b.work < start by work desc limit n)
        let _h2 = do nextCursor(ids, n)
        return V2BookmarkPageDTO{items: list(V2WorkDTO{id: "" + w, cid: "" + w, author: WorkAuthorDTO{handle: Account(Work(w).author).handle, display_name: Account(Work(w).author).display_name, avatar_url: Account(Work(w).author).avatar_url, is_creator: Account(Work(w).author).is_creator, is_verified: Account(Work(w).author).is_verified, official_type: Account(Work(w).author).official_type, realm: Account(Work(w).author).realm, role: Account(Work(w).author).role_type, is_mutual: false}, body: Work(w).body, kind: Work(w).kind, content_class: Work(w).content_class, content_type: Work(w).kind, created_at: "" + Work(w).created, is_nsfw: Work(w).is_nsfw, is_gore: Work(w).is_gore, is_sensitive: Work(w).is_sensitive, is_pinned: Work(w).is_pinned, is_edited: Work(w).edited, made_with_ai: Work(w).made_with_ai, paid_partnership: Work(w).paid_partnership, comment_gating: Work(w).comment_gating, like_count: count(l in Like where l.work == w), dislike_count: count(l in Dislike where l.work == w), liked_by_viewer: exists(l in Like where l.work == w && l.account == me), disliked_by_viewer: exists(l in Dislike where l.work == w && l.account == me), bookmark_count: count(b in Bookmark where b.work == w), bookmarked_by_viewer: exists(b in Bookmark where b.work == w && b.account == me), quote_count: count(w2 in Work where w2.quoted == w && !w2.deleted), repost_count: count(r in Repost where r.work == w), reply_count: count(w2 in Work where w2.parent_cid == w && !w2.deleted), purchased_by_viewer: false} in Work where w.id > 0 && contains("" + ids, "" + w.id) by id), all_count: count(b in Bookmark where b.account == me), folder: folder, folders: list(V2BookmarkFolderDTO{id: "" + f.id, name: f.name, position: f.position, count: count(b in Bookmark where b.folder == f.id), created_at: ""} in BookmarkFolder where f.account == me by position), next_cursor: _h2, server_time: "" + now()}
    action bookmarkFolders() -> V2BookmarkFolderListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2BookmarkFolderListDTO{all_count: count(b in Bookmark where b.account == me), folders: list(V2BookmarkFolderDTO{id: "" + f.id, name: f.name, position: f.position, count: count(b in Bookmark where b.folder == f.id), created_at: ""} in BookmarkFolder where f.account == me by position)}
