    action snoozeTopic(tag: text?, surface_id: text?, days: int?, answer: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let d = do daysOr(days, 7)
        let t = now() + d * 86400
        add TopicSnooze { account: me, tag: tag, surface_id: surface_id, until: t }
    action unsnoozeTopic(tag: text?, surface_id: text?, days: int?, answer: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        remove t in TopicSnooze where t.account == me && t.tag == tag

