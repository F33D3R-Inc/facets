import "entities.fct"
import "core.fct"
import "social.fct"

app F33D3RMisc:
    # The balance an account holds: every wallet entry summed. Settlement is
    # immediate here — no entry is ever pending — so pending_uaet is 0 by
    # construction, the same figure GET /api/v2/wallet answers.
    derive balanceDTO(me: int): BalanceEventDTO = BalanceEventDTO{balance_uaet: sum(w.amount_uaet in WalletEntry where w.account == me), pending_uaet: 0}

    action wallet() -> V2WalletDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2WalletDTO{balance_uaet: sum(w.amount_uaet in WalletEntry where w.account == me), pending_uaet: 0, entries: list(V2WalletEntryDTO{id: "" + w.id, kind: w.kind, amount_uaet: w.amount_uaet, created_at: iso(w.created), counterparty_handle: Account(w.counterparty).handle} in WalletEntry where w.account == me by id desc limit 50)}
    action walletSend(target_handle: text, amount: text):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        check exists(a in Account where a.handle == target_handle) "no such account" status 404
        let target = max(a.id in Account where a.handle == target_handle)
        let amt = toInt(amount)
        check sum(w.amount_uaet in WalletEntry where w.account == me) >= amt "insufficient balance" status 400
        add WalletEntry { account: me, kind: "send", amount_uaet: 0 - amt, counterparty: target, created: now() }
        add WalletEntry { account: target, kind: "receive", amount_uaet: amt, counterparty: me, created: now() }
        emit balance balanceDTO(me) to actor
        emit balance balanceDTO(target) to Account(target).handle
    action tip(target_handle: text, amount_aet: text?, work_id: text?, stream_id: text?):
        requires member
        let me = max(a.id in Account where a.handle == actor)
        check exists(a in Account where a.handle == target_handle) "no such account" status 404
        let target = max(a.id in Account where a.handle == target_handle)
        let _h301 = do orTextM(amount_aet, "0")
        let amt = toInt(_h301)
        add WalletEntry { account: me, kind: "tip_sent", amount_uaet: 0 - amt, counterparty: target, created: now() }
        add WalletEntry { account: target, kind: "tip_received", amount_uaet: amt, counterparty: me, created: now() }
        emit balance balanceDTO(me) to actor
        emit balance balanceDTO(target) to Account(target).handle
        let wid = toInt(work_id)
        if wid > 0:
            let note8 = add Notification { account: target, actor: me, kind: "tip", target_type: "work", target_id: wid, preview: "", amount_uaet: amt, is_read: false, created: now() }
            emit notification notificationV1(Notification(note8), target) to Account(target).handle
            emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == target && !nn.is_read)} to Account(target).handle
        let sid = toInt(stream_id)
        if sid > 0 && exists(s in LiveStream where s.id == sid):
            set LiveStream(sid).tip_total_uaet = LiveStream(sid).tip_total_uaet + amt
            emit tips LiveTipsEventDTO{goal_uaet: LiveStream(sid).tip_goal_uaet, total_uaet: LiveStream(sid).tip_total_uaet} on sid

    proc orTextM(v: text, fallback: text) -> text:
        if v == "":
            return fallback
        return v

    # Leaderboards: all-time by an account's XP, today's by the XP it earned
    # since midnight UTC (its XpEvent rows).
    action achievements() -> V2AchievementsDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let dayStart = now() - now() % 86400
        return V2AchievementsDTO{total_count: count(a in Achievement where a.account == me), earned_count: count(a in Achievement where a.account == me && a.earned > 0), groups: [], xp_total: Account(me).xp, xp_percent: 0, xp_to_next: 100, current_tier: "bronze", next_tier: "silver", in_top10: count(b in Account where !b.deactivated && b.xp > Account(me).xp) < 10, my_rank: 1 + count(b in Account where !b.deactivated && b.xp > Account(me).xp), my_xp_today: sum(x.amount in XpEvent where x.account == me && x.created >= dayStart), daily_global_board: V2PageOfV2LeaderboardEntryDTO{items: list(V2LeaderboardEntryDTO{rank: 1 + count(b in Account where !b.deactivated && sum(x.amount in XpEvent where x.account == b.id && x.created >= dayStart) > sum(x.amount in XpEvent where x.account == a.id && x.created >= dayStart)), handle: a.handle, display_name: a.display_name, avatar_url: a.avatar_url, xp_today: sum(x.amount in XpEvent where x.account == a.id && x.created >= dayStart)} in Account where !a.deactivated && exists(x in XpEvent where x.account == a.id && x.created >= dayStart) by sum(x.amount in XpEvent where x.account == a.id && x.created >= dayStart) desc limit 10), next_cursor: "", server_time: iso(now())}, all_time_global_board: V2PageOfV2LeaderboardEntryDTO{items: list(V2LeaderboardEntryDTO{rank: 1 + count(b in Account where !b.deactivated && b.xp > a.xp), handle: a.handle, display_name: a.display_name, avatar_url: a.avatar_url, xp_today: sum(x.amount in XpEvent where x.account == a.id && x.created >= dayStart)} in Account where !a.deactivated && a.xp > 0 by xp desc limit 10), next_cursor: "", server_time: iso(now())}}
    action analytics(period: text?, sort: text?) -> V2AnalyticsDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let days = do periodDays(period)
        let _h302 = do orTextM(sort, "top")
        return V2AnalyticsDTO{period_days: days, astraon_online: false, posts: [], sort_by: _h302}
    proc periodDays(v: text) -> int:
        if v == "7":
            return 7
        if v == "90":
            return 90
        if v == "all":
            return 3650
        return 30

    action contactRequests() -> V2ContactRequestsDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2ContactRequestsDTO{requests: list(V2ContactRequestDTO{id: "" + r.id, note: r.note, created_at: "" + r.created, handle: Account(r.requester).handle, display: Account(r.requester).display_name, avatar: Account(r.requester).avatar_url} in ContactRequest where r.account == me by id desc)}
    action decideContactRequest(id: int, decision: text):
        requires member
        check decision == "accept" || decision == "decline" "unknown decision" status 400 code "unknown_decision"
        let me = max(a.id in Account where a.handle == actor)
        check ContactRequest(id).account == me "not your request" status 403
        if decision == "accept":
            add Follow { follower: me, followee: ContactRequest(id).requester, created: now() }
        remove ContactRequest(id)

    action creatorFans() -> V2CreatorFansDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        check Account(me).is_creator "only a creator has fans" status 403 code "not_a_creator"
        return V2CreatorFansDTO{count: count(f in Follow where f.followee == me), fans: [], attendance_available: false, commerce_available: false}

    action listWorkLists() -> V2PageOfV2ListDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfV2ListDTO{items: list(V2ListDTO{id: "" + l.id, name: l.name, description: l.description, is_public: l.is_public, created_at: iso(l.created), owner_handle: Account(l.owner).handle, member_count: count(m in ListMember where m.list == l.id)} in WorkList where l.owner == me by id desc), next_cursor: "", server_time: iso(now())}
    action getWorkList(id: int, cursor: text?, limit: int?) -> V2ListDetailDTO:
        requires member
        check exists(l in WorkList where l.id == id) "That list does not exist." status 404 code "list_not_found"
        let me = max(a.id in Account where a.handle == actor)
        # The list's timeline: its members' works, newest first, paged.
        let n = do pageSize(limit, 20, 50)
        let start = do cursorStart(cursor)
        let ids = list(w.id in Work where !w.deleted && w.id < start && exists(m in ListMember where m.list == id && m.account == w.author) by id desc limit n)
        let next = do nextCursor(ids, n)
        return V2ListDetailDTO{list: V2ListDTO{id: "" + id, name: WorkList(id).name, description: WorkList(id).description, is_public: WorkList(id).is_public, created_at: iso(WorkList(id).created), owner_handle: Account(WorkList(id).owner).handle, member_count: count(m in ListMember where m.list == id)}, members: list(accountDTO(Account(m.account), me) in ListMember where m.list == id), works: V2PageOfV2WorkDTO{items: list(workDTO(w, me) in Work where w.id in ids by id desc), next_cursor: next, server_time: iso(now())}}

    # An account as a starter pack lists it (the golden UserDTO).
    derive userDTO(a: Account): UserDTO = UserDTO{
        handle: a.handle,
        display_name: a.display_name,
        avatar_url: a.avatar_url,
        header_url: a.header_url,
        bio: a.bio,
        location: a.location,
        website: a.website,
        pronouns: a.pronouns,
        accent_hex: a.accent_hex,
        theme_id: a.theme_id,
        official_type: a.official_type,
        account_label: a.account_label,
        is_private: a.is_private,
        is_creator: a.is_creator,
        is_verified: a.is_verified,
        realm: a.realm,
        realm_name: "aethyr",
        role: a.role_type,
        xp: a.xp,
        online: false,
        active_recently: true,
        post_count: count(w in Work where w.author == a.id && !w.deleted),
        follower_count: count(f in Follow where f.followee == a.id),
        following_count: count(f in Follow where f.follower == a.id)
        }
    # A starter pack for the viewer `me`: its members, and whether `me`
    # already follows every member other than itself (false for an empty pack).
    derive starterPackDTO(p: StarterPack, me: int): StarterPackDTO = StarterPackDTO{
        id: "" + p.id,
        slug: p.slug,
        title: p.title,
        description: p.description,
        member_count: count(m in StarterPackMember where m.pack == p.id),
        members: list(userDTO(Account(m.account)) in StarterPackMember where m.pack == p.id by id),
        viewer_follows_all: me > 0 && exists(m in StarterPackMember where m.pack == p.id) && !exists(m in StarterPackMember where m.pack == p.id && m.account != me && !exists(f in Follow where f.follower == me && f.followee == m.account))
        }
    action listPacks() -> V2PageOfStarterPackDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return V2PageOfStarterPackDTO{items: list(starterPackDTO(p, me) in StarterPack by id), next_cursor: "", server_time: iso(now())}
    action getPack(slug: text) -> StarterPackDTO:
        requires member
        check exists(p in StarterPack where p.slug == slug) "no such pack" status 404
        let id = max(p.id in StarterPack where p.slug == slug)
        let me = max(a.id in Account where a.handle == actor)
        return starterPackDTO(StarterPack(id), me)
    # Follow every member of a pack but the caller, each as a single follow
    # is made (the followed are told), and answer the pack as it now stands.
    action packFollowAll(slug: text) -> StarterPackDTO:
        requires member
        check slug != "" "slug required" status 400
        check exists(p in StarterPack where p.slug == slug) "pack not found" status 404
        let id = max(p.id in StarterPack where p.slug == slug)
        let me = max(a.id in Account where a.handle == actor)
        for m in StarterPackMember where m.pack == id && m.account != me:
            if !exists(f in Follow where f.follower == me && f.followee == m.account):
                add Follow { follower: me, followee: m.account, created: now() }
                let note = add Notification { account: m.account, actor: me, kind: "follow", target_type: "account", target_id: me, preview: "", amount_uaet: 0, is_read: false, created: now() }
                emit notification notificationV1(Notification(note), m.account) to Account(m.account).handle
                emit notify NotifyEventDTO{unread: count(nn in Notification where nn.account == m.account && !nn.is_read)} to Account(m.account).handle
        return starterPackDTO(StarterPack(id), me)

    action transparencyMethodology() -> V2TransparencyMethodologyDTO:
        return V2TransparencyMethodologyDTO{model: "als", formula: "r = mu + b_u + b_i", als_iterations: 15, lambda_l2_regularization: 0, min_ratings: 5, helpful_threshold: 0, not_helpful_threshold: 0, rating_encoding: "binary", notes: "community-rated context notes, scored by an ALS collaborative filter"}
    action upstreamSources() -> V2UpstreamListDTO:
        requires member
        return V2UpstreamListDTO{server_time: iso(now()), sources: []}
    action sanctumFacetsCatalog() -> FacetCatalogDTO:
        return FacetCatalogDTO{catalog_version: "1", contract_version: "1", count: 0, facets: [], server_time: iso(now())}

    # This module's HTTP surface (merged into the app with the rest of it).
    api GET "/api/v2/wallet" -> wallet rate read since "2026-09-18"
    api GET "/api/v2/achievements" -> achievements rate read since "2026-09-18"
    api GET "/api/v2/analytics" -> analytics rate read since "2026-09-18"
    api GET "/api/v2/contact-requests" -> contactRequests rate read since "2026-09-18"
    api POST "/api/v2/contact-requests/{id}" -> decideContactRequest status 204 rate write since "2026-09-18"
    api GET "/api/v2/creator/fans" -> creatorFans rate read since "2026-09-18"
    api GET "/api/v2/lists" -> listWorkLists rate read since "2026-09-18"
    api GET "/api/v2/lists/{id}" -> getWorkList rate read since "2026-09-18"
    api GET "/api/v2/packs" -> listPacks rate read since "2026-09-18"
    api GET "/api/v2/packs/{slug}" -> getPack rate read since "2026-09-18"
    api GET "/api/v2/transparency/methodology" -> transparencyMethodology rate read since "2026-09-18"
    api GET "/api/v2/upstream" -> upstreamSources rate read since "2026-09-18"
    api GET "/api/v2/contract/facets" -> sanctumFacetsCatalog rate read since "2026-09-13"
