import "core.fct"
import "social.fct"
import "messaging.fct"
import "events.fct"
import "live.fct"
import "communities.fct"
import "misc.fct"
import "polls.fct"
import "mutations.fct"
import "music.fct"
import "articles.fct"
import "commerce.fct"
import "media.fct"
import "markets.fct"
import "platform.fct"
import "social_events.fct"
import "dealings.fct"
import "affiliations.fct"
import "sanctum.fct"
import "account.fct"
import "operator.fct"

app F33D3RApi:
    view Home at "/":
        text "F33D3R API — {count(Account)} accounts"

    contract "/api/v2/contract" rate read since "2026-09-13":
        title "F33D3R native API"
        description "The JSON surface the native clients read (/api/v2), the events on its streams (x-stream-events) and the mutations POST /events accepts (x-mutation-events). Generated from the server's own route registry; info.version is the sha256 of this document without it, so equal contracts have equal versions. Conventions every operation keeps: (1) every GET answering JSON is a conditional GET (x-conditional-get) — a 200 carries a strong ETag over its bytes and Cache-Control: private, no-cache; send If-None-Match to be answered 304 with no body. Streams and binary answers are never tagged. (2) Every answer carries X-RateLimit-Limit (the per-minute budget of the limiter named in x-rate-limit), X-RateLimit-Remaining (requests left in the burst bucket now) and X-RateLimit-Reset (unix seconds when the bucket is full again); a 429 adds Retry-After in seconds. (3) A deprecated operation is marked deprecated with x-sunset, and answers Deprecation: true and Sunset: <HTTP-date> on every response until that day. (4) Every list a client pages (WorkPageDTO, NotificationPageDTO, V2Page) carries server_time, the server's clock when it was read; hand it back unchanged as ?since= to /api/v2/feed/changes, /api/v2/notifications/changes and /api/v2/messages/changes to receive only what landed after it — the phone's own clock is never consulted. (5) GET /api/v2/works?ids= and GET /api/v2/users?handles= hydrate up to 100 rows in one call, in the order asked, omitting what does not exist or may not be seen. (6) Every distinct version of this document the deployment has served is at /api/v2/contract/history, and /api/v2/contract/diff?from=&to= computes what changed between two of them on the server. (7) x-facet-catalog names the web Facets Android projects; the full catalogue is /api/v2/contract/facets."
        bearer "The session token from POST /api/v1/auth/login or /signup, as `Authorization: Bearer <token>`."
