import "entities.fct"
import "core.fct"
import "social.fct"

# Real multipart uploads, now that `bytes`-typed action parameters exist:
# a `bytes` parameter is bound to the uploaded file's stored URL by the
# runtime's multipart binder (runtime/apidecl.go bindMultipartBody), so these
# actions store that URL exactly as a `text` field, no different from an
# author-supplied one.
app F33D3RMedia:
    action uploadMedia(file: bytes) -> V2MediaUploadDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        add MediaUpload { owner: me, url: file, bytes: 0, created: now() }
        return V2MediaUploadDTO{url: file, bytes: 0}
    action uploadVideo(file: bytes, captions: bytes?) -> V2VideoJobDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        # The same bytes already on F33D3R: answered 200 `duplicate`, nothing
        # queued, pointing at the work that carries them when one does.
        let d = fileDigest(file)
        if d != "" && exists(v in VideoJob where v.digest == d):
            let prev = max(v.id in VideoJob where v.digest == d)
            let used = max(w.id in Work where !w.deleted && contains(w.media_urls, VideoJob(prev).master_url))
            if used > 0:
                return V2VideoJobDTO{upload_id: "" + prev, status: "duplicate", master_url: VideoJob(prev).master_url, duplicate_of_work_id: "" + used, duplicate_of_handle: Account(Work(used).author).handle} status 200
            return V2VideoJobDTO{upload_id: "" + prev, status: "duplicate", master_url: VideoJob(prev).master_url} status 200
        let jid = add VideoJob { owner: me, master_url: file, poster_url: "", captions_url: captions, status: "processing", width: 0, height: 0, duration_secs: 0, digest: d, created: now() }
        return V2VideoJobDTO{upload_id: "" + jid, status: "processing", master_url: file, captions_url: captions, poster_url: "", width: 0, height: 0, duration_secs: 0}
    action getVideoJob(id: int) -> V2VideoJobDTO:
        requires member
        check exists(v in VideoJob where v.id == id) "No such upload." status 404 code "video_job_not_found"
        return V2VideoJobDTO{upload_id: "" + id, status: VideoJob(id).status, master_url: VideoJob(id).master_url, captions_url: VideoJob(id).captions_url, poster_url: VideoJob(id).poster_url, width: VideoJob(id).width, height: VideoJob(id).height, duration_secs: VideoJob(id).duration_secs}
    action uploadVoice(audio: bytes) -> V2VoiceUploadDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        add VoiceUpload { owner: me, url: audio, duration_secs: 0, created: now() }
        return V2VoiceUploadDTO{url: audio}

    action setWorkCaptions(id: int, captions: bytes) -> VideoDTO:
        requires member
        check Work(id).author == max(a.id in Account where a.handle == actor) "not your work" status 403
        check exists(v in VideoJob where v.owner == Work(id).author) "This post has no video." status 409 code "no_video"
        let jid = max(v.id in VideoJob where v.owner == Work(id).author)
        set VideoJob(jid).captions_url = captions
        return VideoDTO{master_url: VideoJob(jid).master_url, poster_url: VideoJob(jid).poster_url, captions_url: captions, width: VideoJob(jid).width, height: VideoJob(jid).height, duration_secs: VideoJob(jid).duration_secs}
    action setWorkPoster(id: int, image: bytes?, seconds: float?) -> VideoDTO:
        requires member
        check Work(id).author == max(a.id in Account where a.handle == actor) "not your work" status 403
        check exists(v in VideoJob where v.owner == Work(id).author) "This post has no video." status 409 code "no_video"
        let jid = max(v.id in VideoJob where v.owner == Work(id).author)
        set VideoJob(jid).poster_url = image
        return VideoDTO{master_url: VideoJob(jid).master_url, poster_url: image, captions_url: VideoJob(jid).captions_url, width: VideoJob(jid).width, height: VideoJob(jid).height, duration_secs: VideoJob(jid).duration_secs}

    # This module's HTTP surface (merged into the app with the rest of it).
    api POST "/api/v2/media" -> uploadMedia status 201 rate write since "2026-09-18":
        summary "Upload one image (JPEG, PNG, GIF, WebP)."
        errors 400, 415, 422
    api POST "/api/v2/media/videos" -> uploadVideo status 202 rate write since "2026-09-18":
        summary "Upload one video; answered with a transcode job."
        description "200 carries status duplicate when the bytes are already on F33D3R and nothing was queued."
        errors 400, 415, 422
    api GET "/api/v2/media/videos/{id}" -> getVideoJob rate read since "2026-09-18":
        summary "Poll a video transcode job."
        errors 404
        id: text "upload_id from the video upload."
    api POST "/api/v2/media/voice" -> uploadVoice status 201 rate write since "2026-09-18":
        summary "Upload one voice note."
        errors 400, 415, 422
    api POST "/api/v2/works/{id}/captions" -> setWorkCaptions rate write since "2026-09-18":
        errors 401
        summary "Add or replace a video's captions"
        description "Multipart: `captions` (or `file`), a WebVTT file. Owner-only; only the original uploader's work may carry captions. Answers the work's video as it now stands."
        id: text "Work id."
    api POST "/api/v2/works/{id}/poster" -> setWorkPoster rate write since "2026-09-18":
        errors 401
        summary "Choose a video's thumbnail"
        description "Either multipart `image` (or `file`), an image processed by Caeor, or form `seconds`, a moment of the video the transcoder extracts a frame at. Owner-only. Answers the work's video as it now stands."
        id: text "Work id."
