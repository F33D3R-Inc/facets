import "entities.fct"
import "core.fct"

app F33D3RMessaging:
    # A conversation as the inbox answers with it, for the member `me`.
    derive conversationDTO(c: Conversation, me: int): V2ConversationDTO = V2ConversationDTO{
        id: "" + c.id,
        is_group: c.is_group,
        title: c.title,
        mode: c.mode,
        message_ttl_seconds: c.message_ttl_seconds,
        last_at: iso(c.last_at),
        unread_count: max(m2.unread in ConversationMember where m2.conversation == c.id && m2.account == me),
        preview: ""
        }
    proc maxUsesOr(v: int) -> int:
        if v <= 0:
            return 999999
        return v

    policy inConversation(id: int):
        exists(m in ConversationMember where m.conversation == id && m.account == max(a.id in Account where a.handle == actor))

    # Newest activity first; the cursor is the last_at of the previous page's
    # last conversation.
    action listConversations(cursor: text?, limit: int?) -> V2PageOfV2ConversationDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 50, 200)
        let start = do cursorStart(cursor)
        let lasts = list(c.last_at in Conversation where c.last_at < start && exists(m in ConversationMember where m.conversation == c.id && m.account == me) by last_at desc limit n)
        let next = do nextCursor(lasts, n)
        return V2PageOfV2ConversationDTO{items: list(conversationDTO(c, me) in Conversation where c.last_at < start && exists(m in ConversationMember where m.conversation == c.id && m.account == me) by last_at desc limit n), next_cursor: next, server_time: iso(now())}
    # Every conversation with activity after `since` (a server_time the client
    # holds), newest first, in one page.
    action conversationChanges(since: text) -> V2PageOfV2ConversationDTO:
        requires member
        check since != "" "since is required" status 400
        let me = max(a.id in Account where a.handle == actor)
        let sinceT = toInt(since)
        return V2PageOfV2ConversationDTO{items: list(conversationDTO(c, me) in Conversation where c.last_at > sinceT && exists(m in ConversationMember where m.conversation == c.id && m.account == me) by last_at desc), next_cursor: "", server_time: iso(now())}
    action startConversation(handle: text?, body: text, number: text?, pending_id: text?) -> V2ConversationStartDTO:
        requires member
        check body != "" "Write something to send." status 400 code "body_required"
        let me = max(a.id in Account where a.handle == actor)
        check exists(a in Account where a.handle == handle) "no such user" status 404
        let other = max(a.id in Account where a.handle == handle)
        let cid = add Conversation { is_group: false, title: "", mode: "direct", message_ttl_seconds: 0, created: now(), last_at: now() }
        add ConversationMember { conversation: cid, account: me, unread: 0, joined: now() }
        add ConversationMember { conversation: cid, account: other, unread: 1, joined: now() }
        add Message { conversation: cid, sender: me, body: body, kind: "text", reply_to: 0, deleted: false, edited_at: 0, created: now() }
        return V2ConversationStartDTO{state: "created", pending_id: pending_id, conversation: V2ConversationDTO{id: "" + cid, is_group: false, title: "", mode: "direct", message_ttl_seconds: 0, last_at: iso(now()), unread_count: 0, preview: body}}
    action getThread(id: int, cursor: text?, limit: int?) -> V2ThreadDTO:
        requires member
        requires inConversation(id)
        let me = max(a.id in Account where a.handle == actor)
        let n = do pageSize(limit, 30, 100)
        let start = do cursorStart(cursor)
        let ids = list(msg.id in Message where msg.conversation == id && msg.id < start by id desc limit n)
        let next = do nextCursor(ids, n)
        return V2ThreadDTO{conversation: conversationDTO(Conversation(id), me), members: list(accountDTO(Account(m.account), me) in ConversationMember where m.conversation == id by id), messages: V2PageOfV2MessageDTO{items: list(V2MessageDTO{id: "" + msg.id, conversation_id: "" + id, sender: accountDTO(Account(msg.sender), me), body: msg.body, kind: msg.kind, mode: Conversation(id).mode, created_at: iso(msg.created), is_mine: msg.sender == me, deleted: msg.deleted, reply_to_id: "" + msg.reply_to} in Message where msg.id in ids by id desc), next_cursor: next, server_time: iso(now())}}
    action sendMessage(id: int, body: text, reply_to: text?) -> V2MessageDTO:
        requires member
        requires inConversation(id)
        check body != "" "Write something to send." status 400 code "body_required"
        let me = max(a.id in Account where a.handle == actor)
        let rt = toInt(reply_to)
        let mid = add Message { conversation: id, sender: me, body: body, kind: "text", reply_to: rt, deleted: false, edited_at: 0, created: now() }
        set Conversation(id).last_at = now()
        for m in ConversationMember where m.conversation == id && m.account != me:
            set ConversationMember(m.id).unread = m.unread + 1
            emit gnosis_message MessagePushDTO{conversation_id: "" + id, message_id: "" + mid, mode: Conversation(id).mode, created_at: iso(now()), sender_account: "" + me, sender_handle: actor} to Account(m.account).handle
        return V2MessageDTO{id: "" + mid, conversation_id: "" + id, sender: accountDTO(Account(me), me), body: body, kind: "text", mode: Conversation(id).mode, created_at: iso(now()), is_mine: true, deleted: false, reply_to_id: reply_to}
    action markRead(id: int):
        requires member
        requires inConversation(id)
        let me = max(a.id in Account where a.handle == actor)
        for m in ConversationMember where m.conversation == id && m.account == me:
            set ConversationMember(m.id).unread = 0
    action typing(id: int):
        requires member
        requires inConversation(id)
        let me = max(a.id in Account where a.handle == actor)
        for m in ConversationMember where m.conversation == id && m.account == me:
            set ConversationMember(m.id).last_typed = now()
        for m in ConversationMember where m.conversation == id && m.account != me:
            emit gnosis_typing TypingEventDTO{conversation_id: "" + id, handle: actor, typing: true} to Account(m.account).handle
    # Answers the conversation as it now stands (the golden ConversationDTO):
    # a 1:1 names the other member, a group its title.
    action setTTL(id: int, ttl_seconds: int) -> ConversationDTO:
        requires member
        requires inConversation(id)
        check ttl_seconds >= 0 "ttl_seconds must not be negative" status 400
        set Conversation(id).message_ttl_seconds = ttl_seconds
        let me = max(a.id in Account where a.handle == actor)
        let lastMsg = max(x.id in Message where x.conversation == id && !x.deleted)
        let preview = Message(lastMsg).body
        let unread = max(m.unread in ConversationMember where m.conversation == id && m.account == me)
        if Conversation(id).is_group:
            return ConversationDTO{id: "" + id, is_group: true, title: Conversation(id).title, mode: Conversation(id).mode, message_ttl_seconds: ttl_seconds, last_at: iso(Conversation(id).last_at), preview: preview, unread: unread}
        let other = max(m.account in ConversationMember where m.conversation == id && m.account != me)
        return ConversationDTO{id: "" + id, is_group: false, mode: Conversation(id).mode, message_ttl_seconds: ttl_seconds, last_at: iso(Conversation(id).last_at), preview: preview, unread: unread, other_handle: Account(other).handle, other_display: Account(other).display_name, other_avatar: Account(other).avatar_url}
    action callSignal(id: int, kind: text, media: text?, reason: text?) -> CallDTO:
        requires member
        requires inConversation(id)
        check kind != "" "kind is required" status 400
        let me = max(a.id in Account where a.handle == actor)
        add CallSignal { conversation: id, from_account: me, kind: kind, media: media, reason: reason, created: now() }
        for m in ConversationMember where m.conversation == id && m.account != me:
            emit gnosis_call CallSignalDTO{call_id: "" + id, conversation_id: "" + id, from_account: "" + me, from_handle: actor, kind: kind, media: media, reason: reason} to Account(m.account).handle
        return CallDTO{call_id: "" + id, conversation_id: "" + id, media: media, role: "caller", state: kind, peer: ThreadMemberDTO{account: "" + me, handle: Account(me).handle, display: Account(me).display_name, avatar: Account(me).avatar_url}}

    action getDMSettings(handle: text?) -> V2DMSettingsDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        if !exists(d in DMSettings where d.account == me):
            return V2DMSettingsDTO{access_level: "everyone", charge_mode: "none", price_aet: 0.0, vip_min_price_aet: 0.0}
        let d = max(x.id in DMSettings where x.account == me)
        return V2DMSettingsDTO{access_level: DMSettings(d).access_level, charge_mode: DMSettings(d).charge_mode, price_aet: DMSettings(d).price_aet, vip_min_price_aet: DMSettings(d).vip_min_price_aet}
    action setDMSettings(access_level: text, charge_mode: text?, price_aet: float?, vip_min_price_aet: float?) -> V2DMSettingsDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        if exists(d in DMSettings where d.account == me):
            let d = max(x.id in DMSettings where x.account == me)
            set DMSettings(d).access_level = access_level
            set DMSettings(d).charge_mode = charge_mode
            set DMSettings(d).price_aet = price_aet
            set DMSettings(d).vip_min_price_aet = vip_min_price_aet
        else:
            add DMSettings { account: me, access_level: access_level, charge_mode: charge_mode, price_aet: price_aet, vip_min_price_aet: vip_min_price_aet }
        return V2DMSettingsDTO{access_level: access_level, charge_mode: charge_mode, price_aet: price_aet, vip_min_price_aet: vip_min_price_aet}

    action getInvites(id: int) -> V2InviteListDTO:
        requires member
        requires inConversation(id)
        return V2InviteListDTO{conversation_id: "" + id, invites: list(V2InviteDTO{token: i.token, url: "https://f33d3r.com/join/" + i.token, max_uses: i.max_uses, uses: i.uses, state: "active", created_at: iso(i.created), expires_at: iso(i.expires)} in ConversationInvite where i.conversation == id by id desc)}
    action createInvite(id: int, expires_in: int?, max_uses: int?) -> V2InviteDTO:
        requires member
        requires inConversation(id)
        let ttl = do offsetOr(expires_in)
        let t = randomToken(20)
        let m = do maxUsesOr(max_uses)
        let iid = add ConversationInvite { conversation: id, token: t, max_uses: m, uses: 0, expires: now() + ttl, created: now() }
        # 201 with the new link (the golden contract also lists the route's 200).
        return V2InviteDTO{token: t, url: "https://f33d3r.com/join/" + t, max_uses: m, uses: 0, state: "active", created_at: iso(now()), expires_at: iso(now() + ttl)} status 201
    # Retires a join link and answers the links its group still has.
    action revokeInvite(token: text) -> V2InviteListDTO:
        requires member
        check exists(i in ConversationInvite where i.token == token) "no such link" status 404
        let cid = max(i.conversation in ConversationInvite where i.token == token)
        let me = max(a.id in Account where a.handle == actor)
        check exists(m in ConversationMember where m.conversation == cid && m.account == me) "not a member of this group" status 403
        remove i in ConversationInvite where i.token == token
        return V2InviteListDTO{conversation_id: "" + cid, invites: list(V2InviteDTO{token: i.token, url: "https://f33d3r.com/join/" + i.token, max_uses: i.max_uses, uses: i.uses, state: "active", created_at: iso(i.created), expires_at: iso(i.expires)} in ConversationInvite where i.conversation == cid by id desc)}
    action previewJoin(token: text) -> V2JoinPreviewDTO:
        requires member
        check exists(i in ConversationInvite where i.token == token) "no such invite" status 401
        let iid = max(i.id in ConversationInvite where i.token == token)
        let cid = ConversationInvite(iid).conversation
        let me = max(a.id in Account where a.handle == actor)
        return V2JoinPreviewDTO{token: token, title: Conversation(cid).title, member_count: count(m in ConversationMember where m.conversation == cid), already_member: exists(m in ConversationMember where m.conversation == cid && m.account == me), conversation_id: "" + cid, sealed: false, state: "open", faces: []}
    action join(token: text) -> V2JoinResultDTO:
        requires member
        let t = now()
        check exists(i in ConversationInvite where i.token == token && i.expires > t) "no such invite" status 401
        let iid = max(i.id in ConversationInvite where i.token == token)
        let cid = ConversationInvite(iid).conversation
        let me = max(a.id in Account where a.handle == actor)
        let already = exists(m in ConversationMember where m.conversation == cid && m.account == me)
        if !already:
            add ConversationMember { conversation: cid, account: me, unread: 0, joined: now() }
            set ConversationInvite(iid).uses = ConversationInvite(iid).uses + 1
        return V2JoinResultDTO{joined: !already, admitted: true, already_member: already, conversation_id: "" + cid, preview: V2JoinPreviewDTO{token: token, title: Conversation(cid).title, member_count: count(m in ConversationMember where m.conversation == cid), already_member: true, conversation_id: "" + cid, sealed: false, state: "open", faces: []}}

    # This module's HTTP surface (merged into the app with the rest of it).
    api GET "/api/v2/messages" -> listConversations rate read since "2026-09-18":
        summary "The caller's conversations, newest activity first."
        errors 400
        cursor: text "Opaque page cursor from a previous next_cursor."
        limit: int "Page size, 1-200; default 50."
    api POST "/api/v2/messages" -> startConversation rate write since "2026-09-18":
        summary "Start a conversation with a person, by handle or by Number."
        description "One resource, three addressing modes: handle (message_start), number (message_number), or number+pending_id to release a message already held for one. The one answer shape whether or not it was delivered."
        body V2StartConversationRequest
        errors 400, 429, 503
    api GET "/api/v2/messages/changes" -> conversationChanges rate read since "2026-09-18":
        summary "Conversations with activity after an instant."
        description "v1's GET /api/v1/messages/arrived under the naming GET /api/v2/feed/changes and /api/v2/notifications/changes already established: the resource fact (\"what changed\"), not the push mechanism (\"what arrived\")."
        errors 400
        since: text "RFC 3339 instant: the server_time of the list held."
    api GET "/api/v2/messages/{id}" -> getThread rate read since "2026-09-18":
        summary "One conversation's messages, newest first."
        errors 400, 403, 404
        id: text "Conversation id."
        cursor: text "Opaque page cursor from a previous next_cursor; the page before it."
        limit: int "Page size, 1-200; default 50."
    api POST "/api/v2/messages/{id}" -> sendMessage status 201 rate write since "2026-09-18":
        summary "Send a plaintext message into a conversation that already exists."
        description "Sealed conversations are refused here; a sealed message goes to /api/gnosis/send-sealed."
        body V2SendMessageRequest
        errors 400, 403, 404, 409, 413
        id: text "Conversation id."
    api POST "/api/v2/messages/{id}/read-receipts" -> markRead status 204 rate write since "2026-09-18":
        summary "Mark a conversation read, up to now."
        errors 403
        id: text "Conversation id."
    api POST "/api/v2/messages/{id}/typing" -> typing rate read since "2026-09-18":
        errors 401
        summary "Say the caller is typing"
        description "Send at most once every 3 s while typing; the server holds the notice for 4 s and clears it itself. 204."
        id: text "Conversation id."
    api POST "/api/v2/messages/{id}/ttl" -> setTTL rate write since "2026-09-18":
        errors 401
        summary "Set a conversation's disappearing-messages timer"
        description "Any member of a 1:1, an admin of a group. The change is recorded as a system row in the thread and every member's conversation redraws."
        body V2MessageTTLRequest
        id: text "Conversation id."
    api POST "/api/v2/messages/{id}/call-signal" -> callSignal rate write since "2026-09-18":
        errors 401
        summary "Relay a sealed call signal"
        description "The native form of POST /api/gnosis/call-signal; `c` comes from the path. kind is offer|answer|ice|end; offer and answer carry a sealed envelope keyed to the other party and are answered with CallDTO; ice and end answer 204. The relay stores nothing and reads no SDP."
        body CallSignalRequest
        id: text "Conversation id."
    api GET "/api/v2/messages/dm-settings" -> getDMSettings rate read since "2026-09-18":
        summary "DM access-level settings: the caller's own, or (with ?handle=) another account's requirement."
        description "With no query, the caller's own settings — the same read the web settings panel makes. With ?handle=, a READ-ONLY look at what messaging that account would require (its access level and price), for a composer to show ahead of time. Not a live verdict on the caller's own eligibility (following, subscribed, VIP) — that only exists at send time inside check_send_gate (gnosis/src/access.rs), never cached and never recomputed here; the send itself is still the real answer. A query param, not a path segment, because /api/v2/messages/{id}/... already claims a wildcard first segment for conversation ids (see .../invites), and a second wildcard segment here would collide with it."
        errors 404
        handle: text "Another account's handle, to read its requirement instead of the caller's own settings."
    api POST "/api/v2/messages/dm-settings" -> setDMSettings rate write since "2026-09-18":
        summary "Set who may DM the caller, and what it costs."
        description "Validated in gnosis, not here — e.g. paid_only with a price of 0 or less is refused. Same fields the web settings panel writes."
        body V2SetDMSettingsRequest
        errors 400, 503
    api GET "/api/v2/messages/{id}/invites" -> getInvites rate read since "2026-09-18":
        errors 401
        summary "A group's live join links"
        description "Admin-only. 409 for a 1:1."
        id: text "Conversation id."
    api POST "/api/v2/messages/{id}/invites" -> createInvite rate write since "2026-09-18":
        errors 401
        summary "Mint a join link for a group"
        description "Admin-only. 201 with the new link."
        body V2InviteCreateRequest
        id: text "Conversation id."
    api POST "/api/v2/messages/invites/{token}/revoke" -> revokeInvite rate write since "2026-09-18":
        errors 401
        summary "Retire a join link"
        description "Admin-only on the link's group. Answers the links that remain."
        token: text "Join link token."
    api GET "/api/v2/join/{token}" -> previewJoin rate read since "2026-09-18":
        errors 401
        summary "Preview a join link"
        description "The group's name, size and a few faces, and whether the link still opens (state: open|expired|revoked|used_up|unknown)."
        token: text "Join link token."
    api POST "/api/v2/join/{token}" -> join rate write since "2026-09-18":
        errors 401
        summary "Join a group through a link"
        description "Admitted is true when the thread is now the caller's to open; otherwise preview says why not (the link's state, or the sealed 18+ gate)."
        token: text "Join link token."
