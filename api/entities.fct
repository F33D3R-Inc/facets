# Cross-domain rows every domain module counts against or joins to: a work
# (post), the social graph, and the generic notification feed. Account-only
# state (sessions, settings, identity) lives in core.fct; this file exists so
# two domain modules can both reference the same Work row without redeclaring
# it (an entity is only ever declared once across the merged graph).
app F33D3REntities:
    entity Work:
        id: int
        # The work's id in the legacy F33D3R database ("" for one made here):
        # what a migrated work's identity-derived values (its ballot order)
        # were computed from.
        legacy_id: text
        author: int
        body: text
        kind: text
        content_class: text
        media_urls: text
        is_nsfw: bool
        is_gore: bool
        is_sensitive: bool
        is_pinned: bool
        made_with_ai: bool
        paid_partnership: bool
        parent_cid: int
        quoted: int
        price_uaet: int
        comment_gating: text
        deleted: bool
        edited: bool
        created: int
        edited_at: int
        # A signed work's content id ("sha256:…"; "" for an unsigned one,
        # whose cid is its id), its media's alt text, who it is delivered to
        # (public | circle), the community it is attributed to, when a
        # scheduled one goes out (0 = at once) and a react video's layout.
        cid: text
        alt_text: text
        visibility: text
        community: int
        scheduled_at: int
        react_layout: text
    entity Like:
        id: int
        work: int
        account: int
    entity Dislike:
        id: int
        work: int
        account: int
    entity Repost:
        id: int
        work: int
        account: int
    entity Bookmark:
        id: int
        work: int
        account: int
        folder: int
    # One #hashtag a work carries (lowercased, without the #), dated with the
    # work, so trending counts can window by time.
    entity WorkTag:
        id: int
        work: int
        tag: text
        created: int
    entity BookmarkFolder:
        id: int
        account: int
        name: text
        position: int
        created: int
    entity Follow:
        id: int
        follower: int
        followee: int
        created: int
    entity Block:
        id: int
        account: int
        target: int
    entity Mute:
        id: int
        account: int
        target: int
    entity Notification:
        id: int
        account: int
        actor: int
        kind: text
        target_type: text
        target_id: int
        preview: text
        amount_uaet: int
        is_read: bool
        created: int
    entity ViewEvent:
        id: int
        work: int
        account: int
        seconds: int
        created: int
    entity History:
        id: int
        account: int
        work: int
        viewed: int
    entity WorkWatch:
        id: int
        account: int
        work: int
    entity Circle:
        id: int
        account: int
        target: int
    entity TopicFollow:
        id: int
        account: int
        tag: text
    entity TopicSnooze:
        id: int
        account: int
        tag: text
        surface_id: text
        until: int
    entity SearchHistoryEntry:
        id: int
        account: int
        query: text
        lane: text
        searched: int
    entity SavedSearch:
        id: int
        account: int
        query: text
        lane: text
        name: text
        created: int
        # When its chip was last looked at: new_count counts arrivals since.
        last_seen: int
    entity WorkList:
        id: int
        owner: int
        name: text
        description: text
        is_public: bool
        created: int
    entity ListMember:
        id: int
        list: int
        account: int
    entity Report:
        id: int
        reporter: int
        reason: text
        work: int
        target: int
        detail: text
        created: int
    entity Conversation:
        id: int
        is_group: bool
        title: text
        mode: text
        message_ttl_seconds: int
        created: int
        last_at: int
    entity ConversationMember:
        id: int
        conversation: int
        account: int
        unread: int
        joined: int
        last_typed: int
    entity Message:
        id: int
        conversation: int
        sender: int
        body: text
        kind: text
        reply_to: int
        deleted: bool
        edited_at: int
        created: int
    entity CallSignal:
        id: int
        conversation: int
        from_account: int
        kind: text
        media: text
        reason: text
        created: int
    entity DMSettings:
        id: int
        account: int
        access_level: text
        charge_mode: text
        price_aet: float
        vip_min_price_aet: float
    entity ConversationInvite:
        id: int
        conversation: int
        token: text
        max_uses: int
        uses: int
        expires: int
        created: int
    entity LiveStream:
        id: int
        author: int
        title: text
        description: text
        audience: text
        lane: text
        is_nsfw: bool
        status: text
        scheduled_at: int
        started_at: int
        ended_at: int
        tip_goal_uaet: int
        tip_total_uaet: int
        heart_count: int
        pinned_body: text
        viewer_count: int
    entity LiveChatMsg:
        id: int
        stream: int
        author: int
        body: text
        kind: text
        amount_uaet: int
        created: int
        # The chat scan: a held line waits on the broadcaster (hold_reason says
        # why); a dropped one was held and refused. norm is the body lowercased
        # with its whitespace collapsed, for spotting a repeat.
        held: bool
        hold_reason: text
        dropped: bool
        norm: text
    # An operator-listed term: a chat line carrying it is held for review.
    entity LiveChatHoldTerm:
        id: int
        term: text
    entity LiveViewer:
        id: int
        stream: int
        account: int
        joined: int
    entity Frequency:
        id: int
        host: int
        title: text
        description: text
        visibility: text
        language: text
        adult_content: bool
        max_speakers: int
        max_listeners: int
        state: text
        locked: bool
        requests_open: bool
        scheduled_at: int
        started_at: int
        ended_at: int
        end_reason: text
        ticket_price_aet: int
        vip_plan: int
        # The community hosting it (0 for none), the Verity tier a speaker
        # needs (0-3), and the host's retry key for the create ("" for none).
        community: int
        speaker_min_tier: int
        idem_key: text
    entity FrequencyMember:
        id: int
        frequency: int
        account: int
        role: text
        muted: bool
        present: bool
        joined: int
    entity FrequencyRequest:
        id: int
        frequency: int
        account: int
        reason: text
        created: int
    entity Community:
        id: int
        handle: text @unique
        name: text
        description: text
        avatar_url: text
        banner_url: text
        membership_policy: text
        created: int
        # The creator's account, the optimistic version every settings change
        # bumps, when it last changed, and the shop plan a vip_only community
        # admits (0 for none).
        creator: int
        version: int
        updated: int
        required_plan: int
    entity CommunityMember:
        id: int
        community: int
        account: int
        role: text
        joined: int
    entity CommunityJoinRequest:
        id: int
        community: int
        account: int
        created: int
        message: text
    entity CommunityInvite:
        id: int
        community: int
        invitee: int
        created: int
        inviter: int
    entity ModerationAction:
        id: int
        community: int
        report_id: int
        action: text
        reason: text
        moderator: int
        created: int
        # Who or what the action was aimed at (0 for neither).
        target: int
        work: int
    entity FrequencyReport:
        id: int
        frequency: int
        reporter: int
        reason: text
        detail: text
        target_handle: text
        created: int
    entity LiveReminder:
        id: int
        account: int
        stream: int
    entity Place:
        id: int
        owner: int
        name: text
        category: text
        description: text
        address: text
        website: text
        lat: float
        lon: float
        status: text
        created: int
    # One open /api/v2/events connection: presence is having at least one.
    # Connections end with the process, so the rows do too.
    entity EventsConnection @ephemeral:
        id: int
        account: int
        opened: int
    entity WalletEntry:
        id: int
        account: int
        kind: text
        amount_uaet: int
        counterparty: int
        created: int
    # XP an account earned, and when: the daily leaderboard sums today's.
    entity XpEvent:
        id: int
        account: int
        amount: int
        created: int
    entity Achievement:
        id: int
        account: int
        slug: text
        category: text
        name: text
        description: text
        icon: text
        rarity: text
        xp_reward: int
        earned: int
    entity ContactRequest:
        id: int
        account: int
        requester: int
        note: text
        created: int
    entity Track:
        id: int
        author: int
        title: text
        description: text
        genre: text
        audio_url: text
        cover_url: text
        duration_secs: int
        price_cents: int
        is_free: bool
        play_count: int
        created: int
    entity TrackLike:
        id: int
        track: int
        account: int
    entity Article:
        id: int
        author: int
        slug: text @unique
        title: text
        subtitle: text
        body: text
        cover_url: text
        status: text
        subscriber_only: bool
        community_id: int
        published_at: int
        created: int
        updated: int
        view_count: int
        # Up to six lowercased tags, comma-separated.
        tags: text
    entity ArticleLike:
        id: int
        article: int
        account: int
    entity ArticleBookmark:
        id: int
        article: int
        account: int
    entity Vision:
        id: int
        author: int
        body: text
        content_type: text
        media_url: text
        audience: text
        is_nsfw: bool
        allow_replies: bool
        shared_work_id: int
        created: int
        expires: int
    entity VisionView:
        id: int
        vision: int
        account: int
        created: int
    entity VisionVote:
        id: int
        vision: int
        account: int
        option_idx: int
    entity VisionReply:
        id: int
        vision: int
        account: int
        body: text
        created: int
    entity VisionMute:
        id: int
        account: int
        target: int
    entity StarterPack:
        id: int
        slug: text @unique
        title: text
        description: text
        created: int
    entity StarterPackMember:
        id: int
        pack: int
        account: int
    entity MediaUpload:
        id: int
        owner: int
        url: text
        bytes: int
        created: int
    entity VideoJob:
        id: int
        owner: int
        master_url: text
        poster_url: text
        captions_url: text
        status: text
        width: int
        height: int
        duration_secs: float
        digest: text
        created: int
    entity VoiceUpload:
        id: int
        owner: int
        url: text
        duration_secs: float
        created: int
    entity FrequencyListener:
        id: int
        frequency: int
        account: int
        joined: int
    entity Listing:
        id: int
        seller: int
        title: text
        description: text
        price_sats: int
        currency: text
        is_active: bool
        content_url: text
        content_hash: text
        cek_encrypted: text
        created: int
        visibility: text
    entity Purchase:
        id: int
        listing: int
        buyer: int
        status: text
        currency: text
        expected_sats: int
        cek_for_buyer: text
        expires: int
        confirmed: int
        delivered: int
        created: int
    entity Shop:
        id: int
        owner: int
        is_enabled: bool
        btc_address: text
        xrp_address: text
        created: int
    entity ShopPlan:
        id: int
        shop: int
        name: text
        description: text
        price_aet: int
        is_active: bool
        created: int
    entity ShopSubscription:
        id: int
        shop: int
        account: int
        plan: int
        created: int
        status: text
        period_end: int
    entity TransparencyNote:
        id: int
        work: int
        author_token: text
        note_type: text
        body: text
        factor: int
        intercept: int
        helpful_count: int
        not_helpful_count: int
        status: text
        created: int
        # The account that wrote it (never published: the token stands for
        # it), its source, whether the work's author disputed it, and when
        # it last changed.
        author: int
        evidence_url: text
        author_disputed: bool
        updated: int
    entity TransparencyRating:
        id: int
        note: int
        rater_token: text
        rating: text
        created: int
    entity FrequencyTicketOffer:
        id: int
        frequency: int
        price_aet: int
        created: int
    entity FrequencyTicket:
        id: int
        frequency: int
        account: int
        price_aet: int
        created: int
