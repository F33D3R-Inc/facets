import "core.fct"
import "social.fct"

# The account's own event stream and its connect/disconnect hooks. The
# mutation lane (POST /events) is the Mutation union in mutations.fct.
app F33D3REvents:
    # The account's own event stream (text/event-stream). The runtime opens every
    # connection with the typed `hello` frame and numbers the rest, replaying
    # what a reconnecting client missed after its Last-Event-ID. (The room
    # streams in live.fct send no hello, as legacy's never did.)
    stream "/api/v2/events" requires member rate read since "2026-09-18":
        summary "The account's own event stream (text/event-stream)."
        hello since "2026-09-13"
        connect -> eventsBalance as balance
        connect -> eventsUnread as notify
        connect -> eventsOnline
        disconnect -> eventsOffline
        balance: BalanceEventDTO since "2026-09-06" "The AET balance changed; also sent once on connect when Ain Soph answers."
        gnosis_call: CallSignalDTO since "2026-09-06" "Sealed call signalling (offer, answer, ice, end) with the recipient's own wrapped key."
        gnosis_message: MessagePushDTO since "2026-09-06" "A message arrived, addressed to this account, with this recipient's sealed key when sealed."
        gnosis_message_remove: MessageRemoveDTO since "2026-09-06" "A disappearing message expired or was deleted; drop it."
        gnosis_typing: TypingEventDTO since "2026-09-13" "A member of one of the receiver's conversations started or stopped typing."
        live_start: LiveStartEventDTO since "2026-09-06" "Someone the account follows went live."
        live_state: LiveStateEventDTO since "2026-09-13" "A followed broadcaster's stream changed state (scheduled, moved, cancelled, live, ended)."
        new_post: NewPostEventDTO since "2026-09-06" "Someone the account follows published or reposted a work; the card is attached."
        notification: NotificationDTO since "2026-09-13" "A grouped notification the page would now show first — insert or replace by id."
        notify: NotifyEventDTO since "2026-09-06" "The unread notification count changed; also sent once on connect."
        poll_result: PollResultEventDTO since "2026-09-13" "A watched work's ballot moved; the poll is inside, in the receiver's own order with their own vote marked."
        post_deleted: WorkRemovedEventDTO since "2026-09-06" "A work was deleted; remove it from every screen."
        presence: PresenceEventDTO since "2026-09-13" "A followed account came online or went away."
        work_edited: WorkEventDTO since "2026-09-13" "A watched work's words or labels changed; the work is inside, rendered for the receiver."
        work_engagement: WorkEngagementEventDTO since "2026-09-06" "A watched work's counts changed (watch_post / unwatch_post choose which)."
        work_removed: WorkRemovedEventDTO since "2026-09-13" "A watched work is gone (to connections watching it)."

    # The account's event stream hooks: the balance and the unread count are
    # sent to each new connection; the first open connection brings the
    # account online for its followers, the last one to close takes it away.
    action eventsBalance() -> BalanceEventDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return balanceDTO(me)
    action eventsUnread() -> NotifyEventDTO:
        requires member
        let me = max(a.id in Account where a.handle == actor)
        return NotifyEventDTO{unread: count(n in Notification where n.account == me && !n.is_read)}
    action eventsOnline():
        requires member
        let me = max(a.id in Account where a.handle == actor)
        if !exists(c in EventsConnection where c.account == me):
            for f in Follow where f.followee == me:
                emit presence PresenceEventDTO{handle: actor, online: true, user_id: "" + me} to Account(f.follower).handle
        add EventsConnection { account: me, opened: now() }
    action eventsOffline():
        let me = max(a.id in Account where a.handle == actor)
        let cid = max(c.id in EventsConnection where c.account == me)
        remove EventsConnection(cid)
        set Account(me).last_seen = now()
        if !exists(c in EventsConnection where c.account == me):
            for f in Follow where f.followee == me:
                emit presence PresenceEventDTO{handle: actor, online: false, user_id: "" + me} to Account(f.follower).handle
