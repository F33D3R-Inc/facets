# PasswordResetForm — the two-step "I forgot my password" flow, and the
# logged-in "change it because I already know it" cousin. Three components,
# each a LoginForm-shaped card body rather than a whole screen — drop each
# into `auth/AuthCard` (or a settings page, for the logged-in one) the same
# way `auth/LoginForm` does.
#
#     state resetEmail: text = "" @client
#     use AuthCard("Reset your password", "We will email you a link."):
#         use PasswordResetRequestForm(sendResetLink, resetEmail)
#
#     state resetPw: text = "" @client
#     use AuthCard("Choose a new password", ""):
#         use PasswordResetConfirmForm(resetPassword, token, resetPw)
#
#     state curPw: text = "" @client
#     state newPw: text = "" @client
#     state pwShown: bool = false @client
#     use ChangePasswordForm(changePassword, curPw, newPw, pwShown)
#
# ── WHY THREE COMPONENTS AND NOT ONE WITH A FLAG ─────────────────────────────
#
# `auth/loginform.fct`'s own note is the reason: the submit control of a form
# carrying data is the language's `form` node, written where the arguments
# are, so a component that submits one has to know its action's exact arity.
# A request-a-link form takes an email; a confirm-with-a-new-password form
# takes a token and a password; a change-password form takes the current
# password AND the new one. Three arities, three components — the same
# reason `LoginForm` and `SignupForm` are not one component with a flag.
#
# ── THE TOKEN IS A PARAMETER, NOT SOMETHING THIS FILE READS OFF THE ROUTE ────
#
# A reset-confirm screen arrives at something like `/reset/:token`, and the
# host's own `view … at "/reset/:token"` is where that route parameter is
# already bound — this library has no way to name an app's own route pattern
# from inside a shared component, so the host reads its own `token` and hands
# it down, the same way `data/feed.fct`'s `PostDetail` view reads `id` and
# passes it on rather than a library component reaching for a route it does
# not own.
#
# ── THERE IS NO CONFIRM-PASSWORD FIELD, HERE EITHER ──────────────────────────
#
# `auth/signupform.fct`'s own note applies unchanged: a "do these match" check
# only means something on the authority, and the authority only ever receives
# ONE of two typed values — the second is never sent — so a client-side
# comparison would be a check that can never see reality. Every new-password
# box here is `NewPasswordField`, which is the only real mitigation this
# language can offer: a password manager's fill and generate, not a second
# box to retype into.
#
# ── `ChangePasswordForm` STILL TAKES A `shown: cell bool` PARAMETER ──────────
#
# And still does nothing with it — the identical dead parameter
# `auth/PasswordField` and `auth/SignupForm` both carry, for the identical
# reason given in `auth/passwordfield.fct`: `PasswordField`'s signature is
# fixed at seven arguments including this one, so anything that calls it
# still has to have a `cell bool` on hand to pass through, even though no
# reveal is expressible against a real `password` control.
import "../forms/form.fct"
import "../forms/textfield.fct"
import "passwordfield.fct"
import "loginform.fct"
app FacetAuth:
    component PasswordResetRequestForm(a: action, email: cell text):
        box class "x-authform":
            use Form(a):
                form "Send reset link" -> a(email):
                    use TextField("Email", "you@example.com", true, "", "", email)
    component PasswordResetConfirmForm(a: action, token: text, password: cell text):
        box class "x-authform":
            use Form(a):
                form "Reset password" -> a(token, password):
                    use NewPasswordField("New password", "", true, "At least 12 characters.", failed(a), password)
    component ChangePasswordForm(a: action, current: cell text, next: cell text, shown: cell bool):
        box class "x-authform":
            use Form(a):
                form "Update password" -> a(current, next):
                    use PasswordField("Current password", "", true, "", "", current, shown)
                    use NewPasswordField("New password", "", true, "At least 12 characters.", failed(a), next)
