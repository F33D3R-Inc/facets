# f33d3r timeline — the social reference app assembled from the library's atoms:
# the look, the rail, post cards with media and an engagement bar, quote posts
# in the card's slot, infinite scroll, a profile page with a banner, tag pages,
# a post page, and the sign-in surfaces a visitor sees.
#
# This is the plain-app composition track at full size. `home.fct` is the same
# track exercising notifications, search, replies and post detail; `f33d3r.fct`
# is the typed-brick stack. All three compose the same atoms.
#
#   facet dev timeline.fct
import "layout/vocabulary.fct"
import "layout/topbar.fct"
import "ui/look.fct"
import "ui/icon.fct"
import "ui/navrail.fct"
import "ui/signupcard.fct"
import "ui/guestbanner.fct"
import "ui/trend.fct"
import "social/postcard.fct"
import "social/quotecard.fct"
import "social/composebox.fct"
import "social/whotofollow.fct"
import "profile/profileheader.fct"
import "forms/searchbox.fct"
import "social/visibility.fct"
import "data/searchquery.fct"
import "forms/livesearchbox.fct"

app F33D3RTimeline:
    auth

    enum Kind: text, richtext, video, image

    entity Tweet:
        id: int
        author: text
        handle: text
        verified: bool
        kind: Kind
        body: text
        media: text
        quoted: int
        pinned: bool
        created: int
        # When the work last reached a feed — its posting or its newest repost
        # (the reference's feed_ts): a fresh repost lifts it to the top.
        surfaced: int
        # The reference's work flags social/visibility.fct gates on.
        nsfw: bool
        subscriberOnly: bool
        visibility: text
    entity Like:
        id: int
        tweet: Tweet
        user: text
    entity Repost:
        id: int
        tweet: Tweet
        user: text
    entity Bookmark:
        id: int
        tweet: Tweet
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text

    state draft: text = "" @client
    state feedTab: text = "foryou" @client
    # The instant the feed's snoozes are measured against: a snooze is a
    # preference with an end, and a where filter is pure, so the view carries
    # the moment it was read (the same shape messages.fct's dmAsOf takes).
    state feedAsOf: int = now() @client
    state profileTab: text = "posts" @client
    state q: text = "" @client
    state shown: int = 20 @client
    state username: text = "" @client
    state password: text = "" @client

    policy member:
        actor != "guest"

    derive follows(who: text): bool = exists(f in Follow where f.follower == actor && f.followee == who)
    action post(body: text):
        requires member
        check trim(body) != "" "say something"
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", quoted: 0, pinned: false, created: now(), surfaced: now(), nsfw: false, subscriberOnly: false, visibility: "public" }
    # A work with the reference's flags: NSFW (gated for guests and for
    # viewers not showing sensitive content), subscriber-only (the author and
    # active subscribers), and circle visibility (the author's circle).
    action postWork(body: text, nsfw: bool, subscriberOnly: bool, circle: bool):
        requires member
        check trim(body) != "" "say something"
        let vis = do visibilityOf(circle)
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", quoted: 0, pinned: false, created: now(), surfaced: now(), nsfw: nsfw, subscriberOnly: subscriberOnly, visibility: vis }
    proc visibilityOf(circle: bool) -> text:
        if circle:
            return "circle"
        return "public"
    action quote(body: text, quoted: int):
        requires member
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", quoted: quoted, pinned: false, created: now(), surfaced: now(), nsfw: false, subscriberOnly: false, visibility: "public" }
    action postVideo(body: text, media: text):
        requires member
        add Tweet { author: actor, handle: actor, verified: true, kind: Kind.video, body: body, media: media, quoted: 0, pinned: true, created: now(), surfaced: now(), nsfw: false, subscriberOnly: false, visibility: "public" }
    # One reaction per person and work; a repost is a feed item that lifts the
    # work back to the top of the feeds.
    action like(id: int):
        requires member
        check exists(t in Tweet where t.id == id) "that post doesn't exist"
        check !exists(l in Like where l.tweet == id && l.user == actor) "you already liked this"
        add Like { tweet: id, user: actor }
    action repost(id: int):
        requires member
        check exists(t in Tweet where t.id == id) "that post doesn't exist"
        check !exists(r in Repost where r.tweet == id && r.user == actor) "you already reposted this"
        add Repost { tweet: id, user: actor }
        set Tweet(id).surfaced = now()
    action bookmark(id: int):
        requires member
        check !exists(b in Bookmark where b.tweet == id && b.user == actor) "already bookmarked"
        add Bookmark { tweet: id, user: actor }
    action follow(handle: text):
        requires member
        check handle != actor "you cannot follow yourself"
        check !exists(f in Follow where f.follower == actor && f.followee == handle) "already following"
        add Follow { follower: actor, followee: handle }
    action unfollow(handle: text):
        requires member
        remove f in Follow where f.follower == actor && f.followee == handle
    action loadMore:
        shown = shown + 20

    view Home at "/":
        row class "x-l-app3":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/")
            box class "x-l-app3-main":
                use TopBar("Home", "", "/")
                if actor != "guest":
                    use ComposeBox()
                use LiveSearchBox("Search — \"phrase\", -word, #tag, @handle, from:, since:")
                tabs bind feedTab:
                    tab "For you" -> "foryou":
                        for t in Tweet where feedVisible(t, feedAsOf) && searchHit(t.body, t.author, t.created, t.media != "", 0) by surfaced desc limit shown more loadMore:
                            if t.pinned:
                                row class "x-pinned":
                                    icon "pin"
                                    text "Pinned"
                            use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0):
                                if t.quoted != 0:
                                    use QuoteCard(t.quoted, Tweet(t.quoted).author, Tweet(t.quoted).handle, Tweet(t.quoted).verified, Tweet(t.quoted).body)
                    tab "Following" -> "following":
                        for t in Tweet where feedVisible(t, feedAsOf) && (t.author == actor || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == actor || follows(r.user)))) by surfaced desc limit shown more loadMore:
                            if t.pinned:
                                row class "x-pinned":
                                    icon "pin"
                                    text "Pinned"
                            use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
                box class "x-card":
                    heading 2 "What's happening"
                    use Trend("Tech", "#FacetLang", "1,234 posts")
                    use Trend("News", "#Facet", "987 posts")
                box class "x-card":
                    heading 2 "Who to follow"
                    use WhoToFollow("Grace Hopper", "grace", true, exists(f in Follow where f.follower == actor && f.followee == "grace"))
                    use WhoToFollow("Alan Turing", "alan", false, exists(f in Follow where f.follower == actor && f.followee == "alan"))
        if actor == "guest":
            use GuestBanner("/login")

    # Profile — the header over that user's posts. `/profile/:handle` because
    # that is where `UserChip` and `QuoteCard` link a handle, and a path template
    # is checked against the routes at build time.
    view Profile at "/profile/:handle":
        row class "x-l-app3":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/")
            box class "x-l-app3-main":
                use TopBar(handle, count(t in Tweet where t.handle == handle) + " posts", "/")
                use ProfileHeader(handle, handle, false, "", exists(f in Follow where f.follower == actor && f.followee == handle), "https://picsum.photos/seed/" + handle + "/1200/400", "June 2026", count(f in Follow where f.follower == handle), count(f in Follow where f.followee == handle))
                box class "x-profile-tabs":
                    tabs bind profileTab:
                        tab "Posts" -> "posts":
                            for t in Tweet where t.handle == handle by created desc limit shown more loadMore:
                                if t.pinned:
                                    row class "x-pinned":
                                        icon "pin"
                                        text "Pinned"
                                use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
                        tab "Media" -> "media":
                            for t in Tweet where t.handle == handle && t.media != "" by created desc limit shown more loadMore:
                                use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
        if actor == "guest":
            use GuestBanner("/login")

    # One post on its own — the destination a card's body links to.
    view PostDetail at "/post/:id":
        row class "x-l-app3":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/")
            box class "x-l-app3-main":
                use TopBar("Post", "", "/")
                if exists(t in Tweet where t.id == id && gated(t.author, t.nsfw)):
                    text "This work is not available to you." class "x-empty"
                for t in Tweet where t.id == id && reachable(t) && !gated(t.author, t.nsfw) by id desc limit 1:
                    use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0):
                        if t.quoted != 0:
                            use QuoteCard(t.quoted, Tweet(t.quoted).author, Tweet(t.quoted).handle, Tweet(t.quoted).verified, Tweet(t.quoted).body)
                if !exists(t in Tweet where t.id == id):
                    text "This post no longer exists." class "x-muted x-pad"
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
        if actor == "guest":
            use GuestBanner("/login")

    view Tag at "/tag/:tag":
        row class "x-l-app3":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/")
            box class "x-l-app3-main":
                use TopBar("#" + tag, compact(count(t in Tweet where contains(lower(t.body), "#" + lower(tag)))) + " posts", "/")
                for t in Tweet where contains(lower(t.body), "#" + lower(tag)) by created desc limit shown more loadMore:
                    use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
        if actor == "guest":
            use GuestBanner("/login")

    view Login at "/login":
        box class "x-card" style "max-width: 400px; margin: 10vh auto;":
            text "𝕏" class "x-logo"
            heading 2 "Happening now"
            input bind username placeholder "Username"
            input bind password placeholder "Password"
            button "Create account" -> signup(username, password) class "x-pill x-light x-wide"
            button "Log in" -> login(username, password) class "x-pill x-wide"
            richtext "By signing up, you agree to the [Terms of Service](/terms) and [Privacy Policy](/privacy)." class "x-fine"
