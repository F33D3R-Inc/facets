# f33d3r live — the streaming reference app, assembled from the live facets: a
# browse grid of channels, the theater page (player · info · goal · tips · chat),
# the creator console, and the sign-in surfaces. One set of facets serves what
# Twitch, Kick, YouTube Live, TikTok LIVE and a cam site each call something else.
#
#   facet dev live.fct
import "layout/vocabulary.fct"
import "layout/topbar.fct"
import "ui/look.fct"
import "ui/navrail.fct"
import "ui/signupcard.fct"
import "ui/guestbanner.fct"
import "live/liveplayer.fct"
import "live/streaminfo.fct"
import "live/goalbar.fct"
import "live/tipsheet.fct"
import "live/recenttips.fct"
import "live/chatpanel.fct"
import "live/browsegrid.fct"
import "live/golivepanel.fct"
import "live/streamkeybox.fct"
import "live/agegate.fct"
import "api/handles.fct"

app F33D3RLive:
    auth

    entity Stream:
        id: int
        owner: text
        verified: bool
        title: text
        category: text
        tags: text
        hls: text
        thumb: text
        live: bool
        mature: bool
        viewers: int
        startedAt: int
        pinned: text
        goalLabel: text
        goalTarget: money
        # Who may watch: "" (everyone), "followers", or "subscribers" — the
        # reference's liveMayWatch; the owner always may.
        audience: text
        # "" (not scheduled), or the instant a scheduled broadcast starts —
        # the reference's status 'scheduled' with its scheduled_at.
        scheduledAt: int
    # The operator's held-term list (the reference's LiveChatHoldTerms): a
    # chat line carrying one is held for the host, after the link rule.
    entity HeldTerm:
        id: int
        term: text
    # Presence: a viewer is in the room while holding its event stream
    # (connect joins, disconnect leaves) — the count is who is here, not a
    # number the broadcaster reports.
    entity Viewer @ephemeral:
        id: int
        stream: Stream
        who: text
        joined: int
    # "Remind me" on a scheduled broadcast, sent once when it is near.
    entity Reminder:
        id: int
        stream: Stream
        user: text
        notified: bool
    # What the reminder job delivered, for the reminded account's inbox.
    entity LiveNotice:
        id: int
        user: text
        stream: Stream
        body: text
        at: int
    type ViewersEvent:
        count: int
    entity StreamKey:
        id: int
        stream: Stream
        owner: text
        key: text @secret @requires(member)
        read: owner == actor
    entity Chat:
        id: int
        stream: Stream
        author: text
        role: text
        body: text
        sent: int
        # Held by the chat scan: shown to its sender and the host only until
        # the host releases it (live/chatpanel.fct, live/chatmessage.fct).
        held: bool
        # The line lowercased with its whitespace collapsed — what the repeat
        # rule compares (the reference's strings.Fields join).
        norm: text
    entity Tip:
        id: int
        stream: Stream
        from: text
        cents: money
        note: text
        at: int
    entity Sub:
        id: int
        stream: Stream
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text
    entity Ban:
        id: int
        stream: Stream
        user: text

    state chatDraft: text = "" @client
    state tipOpen: bool = false @client
    state tipNote: text = "" @client
    state ageOk: bool = false @client
    state goTitle: text = "" @client
    state goCategory: text = "" @client
    state goThumbnail: text = "" @client
    state revealKey: bool = false @client
    state username: text = "" @client
    state password: text = "" @client

    policy member:
        actor != "guest"
    policy owner(id: int):
        actor == Stream(id).owner
    policy moderator(id: int):
        actor == Stream(id).owner || role == "admin"
    policy notBanned(id: int):
        !exists(b in Ban where b.stream == id && b.user == actor)
    # liveMayWatch: the owner always; otherwise the stream's audience —
    # everyone, followers of the owner, or subscribers of the channel.
    derive mayWatch(id: int): bool = actor == Stream(id).owner || Stream(id).audience == "" || (Stream(id).audience == "followers" && exists(f in Follow where f.follower == actor && f.followee == Stream(id).owner)) || (Stream(id).audience == "subscribers" && exists(sub in Sub where sub.stream == id && sub.user == actor))
    # The chat scan, in the reference's order: the host is never held; a line
    # with a link is held (a tip-goal room is where scam links go); a shouted
    # line — twelve or more letters, nine in ten of them upper case — is held;
    # a line the same person has already said twice is held.
    proc shouting(body: text) -> bool:
        let mut letters = 0
        let mut upper = 0
        let mut i = 0
        loop i < len(body):
            let ch = charAt(body, i)
            if lower(ch) != upper(ch):
                letters = letters + 1
                if ch == upper(ch):
                    upper = upper + 1
            i = i + 1
        return letters >= 12 && upper * 10 >= letters * 9
    proc heldFor(isHost: bool, body: text, saidBefore: int, flagged: bool) -> bool:
        if isHost:
            return false
        if contains(lower(body), "http://") || contains(lower(body), "https://") || contains(lower(body), "www."):
            return true
        if flagged:
            return true
        let shout = do shouting(body)
        if shout:
            return true
        return saidBefore >= 2

    # ── channel lifecycle (the creator's) ──
    action createChannel(title: text, category: text):
        requires member
        add Stream { owner: actor, verified: false, title: title, category: category, tags: "", hls: "", thumb: "https://picsum.photos/seed/" + actor + "/1280/720", live: false, mature: false, viewers: 0, startedAt: 0, pinned: "", goalLabel: "Tip goal", goalTarget: 10000, audience: "", scheduledAt: 0 }
    action mintKey(stream: int):
        requires owner(stream)
        add StreamKey { stream: stream, owner: actor, key: "live_" + actor + "_" + rand(1000000000) }
    action updateStream(id: int, title: text, category: text, thumbnail: text):
        requires owner(id)
        set Stream(id).title = title
        set Stream(id).category = category
        set Stream(id).thumb = thumbnail
    action setSource(id: int, hls: text, thumb: text, mature: bool):
        requires owner(id)
        set Stream(id).hls = hls
        set Stream(id).thumb = thumb
        set Stream(id).mature = mature
    action goLive(id: int):
        requires owner(id)
        set Stream(id).live = true
        set Stream(id).startedAt = now()
        set Stream(id).scheduledAt = 0
    action endStream(id: int):
        requires owner(id)
        set Stream(id).live = false
    action pin(id: int, body: text):
        requires moderator(id)
        set Stream(id).pinned = body

    # ── the audience ──
    action say(stream: int, body: text):
        requires member
        requires notBanned(stream)
        check trim(body) != "" "say something"
        let isHost = actor == Stream(stream).owner
        let n0 = do seSearchNorm(body)
        let norm = lower(n0)
        let said = count(c in Chat where c.stream == stream && c.author == actor && c.norm == norm)
        let flagged = exists(h in HeldTerm where h.term != "" && contains(lower(body), h.term))
        let held = do heldFor(isHost, body, said, flagged)
        add Chat { stream: stream, author: actor, role: "viewer", body: body, sent: now(), held: held, norm: norm }
    action releaseHeld(id: int):
        requires moderator(Chat(id).stream)
        set Chat(id).held = false
    # The operator's list: admins only, stored lowercased, each once.
    action addHeldTerm(term: text):
        check role == "admin" "only an operator edits the held-term list" status 403
        check trim(term) != "" "a term is required"
        check !exists(h in HeldTerm where h.term == lower(trim(term))) "already on the list"
        add HeldTerm { term: lower(trim(term)) }
    action removeHeldTerm(term: text):
        check role == "admin" "only an operator edits the held-term list" status 403
        remove h in HeldTerm where h.term == lower(trim(term))
    # The room stream's hooks: connecting is joining, disconnecting leaving;
    # the count is the room's, sent to the joiner first and to the room.
    action joinRoom(id: int) -> ViewersEvent:
        requires member
        check exists(s in Stream where s.id == id) "no such stream" status 404
        if !exists(v in Viewer where v.stream == id && v.who == actor):
            add Viewer { stream: id, who: actor, joined: now() }
            set Stream(id).viewers = count(v in Viewer where v.stream == id)
            emit viewers ViewersEvent{count: Stream(id).viewers} on id
        return ViewersEvent{count: Stream(id).viewers}
    action leaveRoom(id: int):
        remove v in Viewer where v.stream == id && v.who == actor
        set Stream(id).viewers = count(v in Viewer where v.stream == id)
        emit viewers ViewersEvent{count: Stream(id).viewers} on id
    # Announce a broadcast for later: 5 minutes to 30 days out (the
    # reference's liveSchedule window).
    action schedule(id: int, at: int):
        requires owner(id)
        check !Stream(id).live "the stream is already live"
        let t0 = now()
        check at >= t0 + 300 && at <= t0 + 2592000 "schedule between 5 minutes and 30 days from now"
        set Stream(id).scheduledAt = at
    # "Remind me": only on a scheduled broadcast, once per person.
    action remind(id: int):
        requires member
        check exists(s in Stream where s.id == id && s.scheduledAt > 0 && !s.live) "only a scheduled broadcast takes a reminder"
        check !exists(r in Reminder where r.stream == id && r.user == actor) "you will already be reminded"
        add Reminder { stream: id, user: actor, notified: false }
    action unremind(id: int):
        requires member
        remove r in Reminder where r.stream == id && r.user == actor
    # The reminder sweep: every reminder for a scheduled broadcast starting
    # within 15 minutes and not yet sent is delivered once.
    action sendDueReminders:
        let t0 = now()
        for r in Reminder where !r.notified && Stream(r.stream).scheduledAt > 0 && !Stream(r.stream).live && Stream(r.stream).scheduledAt <= t0 + 900:
            add LiveNotice { user: r.user, stream: r.stream, body: Stream(r.stream).owner + " goes live soon: " + Stream(r.stream).title, at: t0 }
            set Reminder(r.id).notified = true
    job reminders every 60s -> sendDueReminders
    action setAudience(id: int, audience: text):
        requires owner(id)
        check audience == "" || audience == "followers" || audience == "subscribers" "audience is everyone, followers or subscribers"
        set Stream(id).audience = audience
    action tip(stream: int, cents: money, note: text):
        requires member
        add Tip { stream: stream, from: actor, cents: cents, note: note, at: now() }
        add Chat { stream: stream, author: actor, role: "sub", body: "tipped " + money(cents) + " " + note, sent: now(), held: false, norm: "" }
    action subscribe(stream: int):
        requires member
        add Sub { stream: stream, user: actor }
    action unsubscribe(stream: int):
        requires member
        remove s in Sub where s.stream == stream && s.user == actor
    action subscribeTier(stream: int, tier: int):
        requires member
        add Sub { stream: stream, user: actor }
    action unsubscribeTier(stream: int):
        requires member
        remove s in Sub where s.stream == stream && s.user == actor
    action follow(handle: text):
        requires member
        add Follow { follower: actor, followee: handle }
    action unfollow(handle: text):
        requires member
        remove f in Follow where f.follower == actor && f.followee == handle

    # ── moderation ──
    action deleteChat(id: int):
        requires moderator(Chat(id).stream)
        remove Chat(id)
    action ban(stream: int, user: text):
        requires moderator(stream)
        add Ban { stream: stream, user: user }
    action unban(stream: int, user: text):
        requires moderator(stream)
        remove b in Ban where b.stream == stream && b.user == user

    # ── local ──
    action openTip:
        tipOpen = true
    action closeTip:
        tipOpen = false
    action confirmAge:
        ageOk = true

    view Browse at "/":
        row class "x-l-app3 x-l-app3-wide":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/dashboard")
            box class "x-l-app3-main":
                use TopBar("Live now", compact(count(s in Stream where s.live)) + " channels", "/")
                use BrowseGrid("")
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R Live?", "/login")
        if actor == "guest":
            use GuestBanner("/login")

    view Category at "/browse/:category":
        row class "x-l-app3 x-l-app3-wide":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/dashboard")
            box class "x-l-app3-main":
                use TopBar(category, compact(count(s in Stream where s.live && s.category == category)) + " live", "/")
                use BrowseGrid(category)
            box class "x-l-app3-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R Live?", "/login")

    stream "/live/{id}/events" requires member:
        id: text "Stream id."
        connect -> joinRoom as viewers
        disconnect -> leaveRoom
        viewers: ViewersEvent "Who is in the room now; also sent once on connect."
    view Theater at "/live/:id":
        use AgeGate(Stream(id).mature, ageOk, confirmAge):
            # liveMayWatch: a walled viewer gets the sentence and no player.
            if !mayWatch(id):
                box class "x-empty":
                    if Stream(id).audience == "followers":
                        text "This stream is for {Stream(id).owner}'s followers."
                    if Stream(id).audience == "subscribers":
                        text "This stream is for {Stream(id).owner}'s subscribers."
            if mayWatch(id):
                row class "x-theater":
                    box class "x-stagecol":
                        use LivePlayer(Stream(id))
                        use StreamInfo(Stream(id), exists(f in Follow where f.follower == actor && f.followee == Stream(id).owner), exists(s in Sub where s.stream == id && s.user == actor), openTip)
                        use GoalBar(Stream(id).goalLabel, sum(t.cents in Tip where t.stream == id), Stream(id).goalTarget)
                        use RecentTips(Stream(id))
                    box class "x-chatcol":
                        use ChatPanel(Stream(id), chatDraft, actor == Stream(id).owner || role == "admin")
                use TipSheet(Stream(id), tipOpen, tipNote, closeTip)
        if actor == "guest":
            use GuestBanner("/login")

    view Dashboard at "/dashboard" requires member:
        row class "x-l-app3":
            box class "x-l-app3-nav":
                use NavRail(actor, actor, false, "/dashboard")
            box class "x-l-app3-main":
                use TopBar("Creator console", "", "/")
                if !exists(s in Stream where s.owner == actor):
                    box class "x-console":
                        heading 2 "Create your channel"
                        input bind goTitle placeholder "Stream title"
                        input bind goCategory placeholder "Category"
                        button "Create channel" -> createChannel(goTitle, goCategory) class "x-pill x-primary"
                for s in Stream where s.owner == actor limit 1:
                    use GoLivePanel(s, goTitle, goCategory, goThumbnail)
                for k in StreamKey where k.owner == actor limit 1:
                    use StreamKeyBox(k, revealKey)
                if exists(s in Stream where s.owner == actor) && !exists(k in StreamKey where k.owner == actor):
                    for s in Stream where s.owner == actor limit 1:
                        button "Mint a stream key" -> mintKey(s.id) class "x-pill"
            box class "x-l-app3-aside":
                text "Your channel, your key, your goal."  class "x-muted"

    view Login at "/login":
        box class "x-card" style "max-width: 400px; margin: 10vh auto;":
            text "𝕏" class "x-logo"
            heading 2 "Go live. Watch live."
            input bind username placeholder "Username"
            input bind password placeholder "Password"
            button "Create account" -> signup(username, password) class "x-pill x-light x-wide"
            button "Log in" -> login(username, password) class "x-pill x-wide"
