# Visibility — what a viewer is allowed to see of a work, and what they chose
# not to. Ported from the reference's feed SQL (feed-engine/internal/db/
# works.go: keywordMutedSQL, topicSnoozedSQL, circleVisibleSQL, the
# subscriber_only clause) and its work wall (handler/works_feed.go workWall:
# the NSFW/age gate). Two kinds of rule live here and a host applies them in
# the reference's places:
#
#   - PREFERENCES, applied to the viewer's own feeds only: a muted keyword
#     hides works whose body carries it; a snoozed #tag hides works carrying
#     it until the snooze ends.
#   - ACCESS CONTROL, applied everywhere a work can reach a viewer: a work
#     with visibility "circle" is seen by its author and the author's circle;
#     a subscriber-only work by its author and active subscribers; an NSFW
#     work is gated for guests ("auth") and for viewers who are not verified
#     adults showing sensitive content ("restricted").
#
#     for w in Work where feedVisible(w, myId, now()) by created desc limit shown:
#         use PostCard(…)
#
#     if nsfwGateAuth(myId, w.author, w.is_nsfw): …sign in…
#     if nsfwGateRestricted(myId, w.author, w.is_nsfw): …not available to you…
#
# Bound to the product's rows by `expect`: the work's author, is_nsfw and
# visibility ("circle", "subscribers"), the viewer's MutedKeyword,
# TopicSnooze and Circle rows (set through the product's own mute, snooze and
# circle actions), the Account's is_adult and show_sensitive, and an active
# subscription (commerce/shop.fct). The product's feed applies feedVisible,
# so /api/v2 and the web hide the same works.
import "../commerce/shop.fct"
app FacetSocial:
    expect entity Account:
        id: int
        handle: text
        is_adult: bool
        show_sensitive: bool
    expect entity Work:
        id: int
        author: int
        body: text
        is_nsfw: bool
        visibility: text
    expect entity MutedKeyword:
        id: int
        account: int
        keyword: text
        created: int
    expect entity TopicSnooze:
        id: int
        account: int
        tag: text
        surface_id: text
        until: int
    expect entity Circle:
        id: int
        account: int
        target: int
    # Preferences (the viewer's own feed); `me` is the viewer's Account id, 0
    # for a guest.
    derive keywordMuted(me: int, body: text): bool = exists(k in MutedKeyword where k.account == me && contains(lower(body), lower(k.keyword)))
    derive snoozed(me: int, body: text, at: int): bool = exists(s in TopicSnooze where s.account == me && s.until > at && contains(lower(body), "#" + s.tag))
    # Access control (everywhere).
    derive circleVisible(me: int, author: int, visibility: text): bool = visibility != "circle" || author == me || exists(c in Circle where c.account == author && c.target == me)
    derive subscriberOk(me: int, author: int, visibility: text, at: int): bool = visibility != "subscribers" || author == me || subscribedTo(me, author, at)
    derive sensitiveOk(me: int): bool = exists(a in Account where a.id == me && a.is_adult && a.show_sensitive)
    derive nsfwGateAuth(me: int, author: int, nsfw: bool): bool = nsfw && author != me && me == 0
    derive nsfwGateRestricted(me: int, author: int, nsfw: bool): bool = nsfw && author != me && me != 0 && !sensitiveOk(me)
    derive gated(me: int, author: int, nsfw: bool): bool = nsfwGateAuth(me, author, nsfw) || nsfwGateRestricted(me, author, nsfw)
    derive reachable(w: Work, me: int, at: int): bool = circleVisible(me, w.author, w.visibility) && subscriberOk(me, w.author, w.visibility, at)
    # A derive is pure, so the instant a snooze is measured against is the
    # host's to pass: `feedVisible(w, me, now())`.
    derive feedVisible(w: Work, me: int, at: int): bool = reachable(w, me, at) && !keywordMuted(me, w.body) && !snoozed(me, w.body, at) && !gated(me, w.author, w.is_nsfw)
