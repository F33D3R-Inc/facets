{
  "tests": [
    {
      "name": "guests cannot post; members post text, quotes reference the quoted id, videos are pinned",
      "steps": [
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "post",
          "args": [
            "nope"
          ],
          "fails": "member"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "first"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "quote",
          "args": [
            "seen this?",
            1
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "postVideo",
          "args": [
            "clip",
            "https://cdn/clip.mp4"
          ]
        },
        {
          "expect": "count(Tweet)",
          "equals": 3
        },
        {
          "expect": "Tweet(1).quoted",
          "equals": 0
        },
        {
          "expect": "Tweet(2).quoted",
          "equals": 1
        },
        {
          "expect": "Tweet(2).author",
          "equals": "bob"
        },
        {
          "expect": "Tweet(3).pinned",
          "equals": true
        },
        {
          "expect": "Tweet(3).media",
          "equals": "https://cdn/clip.mp4"
        },
        {
          "expect": "count(t in Tweet where t.pinned)",
          "equals": 1
        }
      ]
    },
    {
      "name": "like, repost and bookmark are one row each per actor and post",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "p"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "like",
          "args": [
            1
          ],
          "fails": "member"
        },
        {
          "expect": "count(l in Like where l.tweet == 1)",
          "equals": 1
        },
        {
          "expect": "count(r in Repost where r.tweet == 1)",
          "equals": 1
        },
        {
          "expect": "count(b in Bookmark where b.user == \"bob\")",
          "equals": 1
        },
        {
          "expect": "Like(1).user",
          "equals": "bob"
        }
      ]
    },
    {
      "name": "follow and unfollow act only on the actor's own edge",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ]
        },
        {
          "expect": "count(f in Follow where f.followee == \"bob\")",
          "equals": 2
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unfollow",
          "args": [
            "bob"
          ]
        },
        {
          "expect": "count(Follow)",
          "equals": 1
        },
        {
          "expect": "Follow(2).follower",
          "equals": "cy"
        }
      ]
    },
    {
      "name": "loadMore grows the client's page size by twenty",
      "steps": [
        {
          "expect": "shown",
          "equals": 20
        },
        {
          "run": "loadMore"
        },
        {
          "expect": "shown",
          "equals": 40
        }
      ]
    },
    {
      "name": "feeds: own posts and reposts by followed accounts are Following items, ordered by newest surfacing; reactions are one per person and work; no self-follow",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "ada one"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "post",
          "args": [
            "bob one"
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "post",
          "args": [
            "cy one"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "  "
          ],
          "fails": "say something"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "ada"
          ],
          "fails": "yourself"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ],
          "fails": "already following"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "count(t in Tweet where t.author == actor || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == actor || follows(r.user))))",
          "equals": 2
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            3
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            3
          ],
          "fails": "already reposted"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "count(t in Tweet where t.author == actor || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == actor || follows(r.user))))",
          "equals": 3
        },
        {
          "expect": "Tweet(3).surfaced >= Tweet(2).surfaced",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ],
          "fails": "already liked"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            99
          ],
          "fails": "doesn't exist"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ],
          "fails": "already bookmarked"
        },
        {
          "expect": "count(Like)",
          "equals": 1
        }
      ]
    },
    {
      "name": "work flags: a circle work reaches only the circle, a subscriber-only work only active subscribers, an NSFW work is gated by the viewer's prefs; a muted keyword or snoozed #tag leaves the feed for that viewer",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "postWork",
          "args": [
            "circle only",
            false,
            false,
            true
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "postWork",
          "args": [
            "subs only",
            false,
            true,
            false
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "postWork",
          "args": [
            "spicy",
            true,
            false,
            false
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "plain #garden"
          ]
        },
        {
          "expect": "Tweet(1).visibility",
          "equals": "circle"
        },
        {
          "expect": "Tweet(4).visibility",
          "equals": "public"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "count(t in Tweet where feedVisible(t, now()))",
          "equals": 4
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "count(t in Tweet where feedVisible(t, now()))",
          "equals": 1
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "addToCircle",
          "args": [
            "bob"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "subscribeCreator",
          "args": [
            "ada"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "setViewerPrefs",
          "args": [
            true,
            true
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "count(t in Tweet where feedVisible(t, now()))",
          "equals": 4
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "muteKeyword",
          "args": [
            "spicy"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "snoozeTopic",
          "args": [
            "garden",
            3
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "count(t in Tweet where feedVisible(t, now()))",
          "equals": 2
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "expect": "reachable(Tweet(1))",
          "equals": false
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "expect": "gated(\"ada\", true)",
          "equals": true
        }
      ]
    }
  ]
}
