{
  "tests": [
    {
      "name": "a guest cannot post; a member posts and the post carries their handle",
      "steps": [
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "post",
          "args": [
            "hi"
          ],
          "fails": "member"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            ""
          ],
          "fails": "say something"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "first light"
          ]
        },
        {
          "expect": "count(Tweet)",
          "equals": 1
        },
        {
          "expect": "Tweet(1).author",
          "equals": "ada"
        },
        {
          "expect": "Tweet(1).handle",
          "equals": "ada"
        },
        {
          "expect": "Tweet(1).body",
          "equals": "first light"
        }
      ]
    },
    {
      "name": "like, repost and reply each notify the post's author, never the actor",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "hello"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "reply",
          "args": [
            1,
            "welcome"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "reply",
          "args": [
            1,
            ""
          ],
          "fails": "say something"
        },
        {
          "expect": "count(Like)",
          "equals": 1
        },
        {
          "expect": "count(Repost)",
          "equals": 1
        },
        {
          "expect": "count(Reply)",
          "equals": 1
        },
        {
          "expect": "count(n in Notification where n.user == \"ada\")",
          "equals": 3
        },
        {
          "expect": "count(n in Notification where n.user == \"bob\")",
          "equals": 0
        },
        {
          "expect": "Notification(1).verb",
          "equals": "liked your post"
        },
        {
          "expect": "Notification(3).subject",
          "equals": "welcome"
        }
      ]
    },
    {
      "name": "bookmarks are per actor and unbookmark removes only the actor's own",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "keep me"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Bookmark)",
          "equals": 2
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "unbookmark",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Bookmark)",
          "equals": 1
        },
        {
          "expect": "Bookmark(1).user",
          "equals": "ada"
        }
      ]
    },
    {
      "name": "follow notifies the followee; unfollow removes just that edge",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "cy"
          ]
        },
        {
          "expect": "count(Follow)",
          "equals": 2
        },
        {
          "expect": "count(n in Notification where n.user == \"bob\" && n.verb == \"followed you\")",
          "equals": 1
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unfollow",
          "args": [
            "bob"
          ]
        },
        {
          "expect": "count(Follow)",
          "equals": 1
        },
        {
          "expect": "Follow(2).followee",
          "equals": "cy"
        }
      ]
    },
    {
      "name": "notifications: only the addressee marks read; clear drops only the actor's",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "p"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "cy"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "markRead",
          "args": [
            1
          ],
          "fails": "ownsNotification"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "markRead",
          "args": [
            1
          ]
        },
        {
          "expect": "Notification(1).read",
          "equals": true
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "clearNotifications"
        },
        {
          "expect": "count(Notification)",
          "equals": 1
        },
        {
          "expect": "Notification(2).user",
          "equals": "cy"
        }
      ]
    },
    {
      "name": "saveProfile requires both fields and replaces the actor's single profile row",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "saveProfile",
          "args": [
            "",
            "bio"
          ],
          "fails": "display name"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "saveProfile",
          "args": [
            "Ada",
            ""
          ],
          "fails": "bio is required"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "saveProfile",
          "args": [
            "Ada",
            "first"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "saveProfile",
          "args": [
            "Ada L.",
            "second"
          ]
        },
        {
          "expect": "count(p in Profile where p.handle == \"ada\")",
          "equals": 1
        },
        {
          "expect": "Profile(2).bio",
          "equals": "second"
        },
        {
          "expect": "Profile(2).verified",
          "equals": false
        }
      ]
    },
    {
      "name": "a channel belongs to its creator: only the owner updates, goes live and ends it",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "",
            "Music"
          ],
          "fails": "title"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "expect": "Stream(1).owner",
          "equals": "ada"
        },
        {
          "expect": "Stream(1).live",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "goLive",
          "args": [
            1
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "updateStream",
          "args": [
            1,
            "x",
            "y",
            "z"
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "updateStream",
          "args": [
            1,
            "Ada plays",
            "Games",
            "https://img/1"
          ]
        },
        {
          "expect": "Stream(1).title",
          "equals": "Ada plays"
        },
        {
          "expect": "Stream(1).thumb",
          "equals": "https://img/1"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "goLive",
          "args": [
            1
          ]
        },
        {
          "expect": "Stream(1).live",
          "equals": true
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "endStream",
          "args": [
            1
          ]
        },
        {
          "expect": "Stream(1).live",
          "equals": false
        }
      ]
    },
    {
      "name": "chat: links are held, the owner moderates (release, delete, ban), a banned viewer is silent",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            ""
          ],
          "fails": "say something"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "hello"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "see http://spam"
          ]
        },
        {
          "expect": "Chat(1).held",
          "equals": false
        },
        {
          "expect": "Chat(2).held",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "releaseHeld",
          "args": [
            2
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "releaseHeld",
          "args": [
            2
          ]
        },
        {
          "expect": "Chat(2).held",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "deleteChat",
          "args": [
            1
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "deleteChat",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Chat)",
          "equals": 1
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "ban",
          "args": [
            1,
            "ada"
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "ban",
          "args": [
            1,
            "bob"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "again"
          ],
          "fails": "notBanned"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "unban",
          "args": [
            1,
            "bob"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "again"
          ]
        },
        {
          "expect": "count(Chat)",
          "equals": 2
        }
      ]
    },
    {
