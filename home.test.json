        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "subscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "subscribeTier",
          "args": [
            1,
            2
          ]
        },
        {
          "expect": "count(Sub)",
          "equals": 2
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "unsubscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "unsubscribeTier",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Sub)",
          "equals": 0
        }
      ]
    },
