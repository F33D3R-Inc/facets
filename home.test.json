    {
      "name": "feeds: your own posts and reposts by people you follow are feed items, and a repost lifts the work to the top (surfaced order)",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "ada one"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "post",
          "args": [
            "bob one"
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "post",
          "args": [
            "cy one"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "bob"
          ]
        },
        {
          "expect": "count(t in Tweet where t.author == \"ada\" || follows(t.author))",
          "equals": 2,
          "as": {
            "actor": "ada",
            "role": "member"
          }
        },
        {
          "expect": "count(t in Tweet where t.author == \"ada\" || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == \"ada\" || follows(r.user))))",
          "equals": 2,
          "as": {
            "actor": "ada",
            "role": "member"
          }
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            3
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "count(t in Tweet where t.author == \"ada\" || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == \"ada\" || follows(r.user))))",
          "equals": 3
        },
        {
          "expect": "Tweet(3).surfaced >= Tweet(1).surfaced",
          "equals": true,
          "as": {
            "actor": "ada",
            "role": "member"
          }
        },
        {
          "expect": "Tweet(3).surfaced >= Tweet(2).surfaced",
          "equals": true,
          "as": {
            "actor": "ada",
            "role": "member"
          }
        }
      ]
    },
