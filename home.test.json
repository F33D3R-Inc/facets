          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "tip",
          "args": [
            1,
            500,
            "great set"
          ]
        },
        {
          "expect": "count(Tip)",
          "equals": 1
        },
        {
          "expect": "Tip(1).from",
          "equals": "bob"
        },
        {
          "expect": "sum(t.cents in Tip where t.stream == 1)",
          "equals": 500
