    {
      "name": "Developer app registration: name, an http(s) redirect and a known scope; the secret is answered once and stored hashed",
      "as": {
        "actor": "guest",
        "role": "guest"
      },
      "steps": [
        {
          "run": "signup",
          "args": [
            "ada",
            "password1",
            "Ada",
            "1990-01-01",
            "safe",
            "",
            "",
            "phone",
            true
          ]
        },
        {
          "run": "devAppRegister",
          "args": [
            "App",
            "https://app.example/cb",
            "read:public_profile",
            ""
          ],
          "fails": "member"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "devAppRegister",
          "args": [
            "",
            "https://app.example/cb",
            "read:public_profile",
            ""
          ],
          "fails": "1-80 characters"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "devAppRegister",
          "args": [
            "App",
            "app.example/cb",
            "read:public_profile",
            ""
          ],
          "fails": "http(s) URL"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "devAppRegister",
          "args": [
            "App",
            "https://app.example/cb",
            "write:everything",
            ""
          ],
          "fails": "at least one scope"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "devAppRegister",
          "args": [
            "App",
            "https://app.example/cb",
            "read:public_works bogus read:public_profile read:public_works",
            "my app"
          ]
        },
        {
          "expect": "count(DevApp)",
          "equals": 1
        },
        {
          "expect": "DevApp(1).owner",
          "equals": 1
        },
        {
          "expect": "DevApp(1).scope",
          "equals": "read:public_works read:public_profile"
        },
        {
          "expect": "take(DevApp(1).client_id, 7)",
          "equals": "f33d3r_"
        },
        {
          "expect": "DevApp(1).client_secret == \"\"",
          "equals": false
        }
      ]
    },
    {
      "name": "one account everywhere: an account made by the web form signs in through the API's createSession, and one made through the API (POST /api/v2/accounts' signup) signs in through the web form \u2014 both are the product's Account rows",
