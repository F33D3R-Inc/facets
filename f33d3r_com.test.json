    {
      "name": "the web's post, reply, like, repost and bookmark write the product's Work/Like/Repost/Bookmark rows (the ones /api/v2 reads); the engagement buttons toggle",
      "steps": [
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "webSignup",
          "args": [
            "ada",
            "correct-horse"
          ]
        },
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "webSignup",
          "args": [
            "bob",
            "battery-staple"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "post",
          "args": [
            "hello #garden"
          ]
        },
        {
          "expect": "count(w in Work where Account(w.author).handle == \"ada\" && w.body == \"hello #garden\")",
          "equals": 1
        },
        {
          "expect": "count(t in WorkTag where t.tag == \"garden\")",
          "equals": 1
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "reply",
          "args": [
            1,
            "nice"
          ]
        },
        {
          "expect": "count(w in Work where w.parent_cid == 1 && Account(w.author).handle == \"bob\")",
          "equals": 1
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "repost",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "expect": "count(l in Like where l.work == 1) + count(r in Repost where r.work == 1) + count(b in Bookmark where b.work == 1)",
          "equals": 3
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "like",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "bookmark",
          "args": [
            1
          ]
        },
        {
          "expect": "count(l in Like where l.work == 1) + count(b in Bookmark where b.work == 1)",
          "equals": 0
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "ada"
          ]
        },
        {
          "expect": "count(f in Follow where Account(f.follower).handle == \"bob\" && Account(f.followee).handle == \"ada\")",
          "equals": 1
        },
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "like",
          "args": [
            1
          ],
          "fails": "member"
        }
      ]
    },
    {
      "name": "messages and live on the product's Conversation/Message and LiveStream/LiveChatMsg: the web's new-message form opens a conversation, the thread's form sends into it; going live, chatting and ending the stream",
      "steps": [
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "webSignup",
          "args": [
            "ada",
            "correct-horse"
          ]
        },
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "webSignup",
          "args": [
            "bob",
            "battery-staple"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "webMessage",
          "args": [
            "bob",
            "hey bob"
          ]
        },
        {
          "expect": "count(c in Conversation where true)",
          "equals": 1
        },
        {
          "expect": "count(x in ConversationMember where x.conversation == 1)",
          "equals": 2
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "sendMessage",
          "args": [
            1,
            "hi ada"
          ]
        },
        {
          "expect": "count(x in Message where x.conversation == 1)",
          "equals": 2
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "webGoLive",
          "args": [
            "late show"
          ]
        },
        {
          "expect": "count(s in LiveStream where s.status == \"live\" && Account(s.author).handle == \"ada\")",
          "equals": 1
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "sendLiveChat",
          "args": [
            1,
            "first!"
          ]
