{
  "tests": [
    {
      "name": "inboxitem: the row shape it expects seeds and reads",
      "steps": [
        {
          "seed": {
            "Thread": [
              {}
            ],
            "Message": [
              {
                "body": "x",
                "sent": 1,
                "thread": 1
              }
            ]
          }
        },
        {
          "expect": "count(Thread)",
          "equals": 1
        },
        {
          "expect": "count(Message)",
          "equals": 1
        },
        {
          "expect": "Message(1).body",
          "equals": "x"
        }
      ]
    }
  ]
}
