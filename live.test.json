{
  "tests": [
    {
      "name": "a channel's owner mints keys, sets the source, goes live, heartbeats and ends; nobody else can",
      "steps": [
        {
          "as": {
            "actor": "guest",
            "role": "guest"
          },
          "run": "createChannel",
          "args": [
            "x",
            "y"
          ],
          "fails": "member"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "expect": "Stream(1).owner",
          "equals": "ada"
        },
        {
          "expect": "Stream(1).mature",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "mintKey",
          "args": [
            1
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "mintKey",
          "args": [
            1
          ]
        },
        {
          "expect": "count(StreamKey)",
          "equals": 1
        },
        {
          "expect": "StreamKey(1).owner",
          "equals": "ada"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "setSource",
          "args": [
            1,
            "h",
            "t",
            true
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setSource",
          "args": [
            1,
            "https://cdn/a.m3u8",
            "https://img/a",
            true
          ]
        },
        {
          "expect": "Stream(1).hls",
          "equals": "https://cdn/a.m3u8"
        },
        {
          "expect": "Stream(1).mature",
          "equals": true
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "goLive",
          "args": [
            1
          ]
        },
        {
          "expect": "Stream(1).live",
          "equals": true
        },
        {
          "expect": "Stream(1).startedAt > 0",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "heartbeat",
          "args": [
            1,
            40
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "heartbeat",
          "args": [
            1,
            40
          ]
        },
        {
          "expect": "Stream(1).viewers",
          "equals": 40
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "endStream",
          "args": [
            1
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "endStream",
          "args": [
            1
          ]
        },
        {
          "expect": "Stream(1).live",
          "equals": false
        }
      ]
    },
    {
      "name": "moderation is the owner or an admin: pin, delete chat, ban and unban",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "hello"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "pin",
          "args": [
            1,
            "rules"
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "pin",
          "args": [
            1,
            "be kind"
          ]
        },
        {
          "expect": "Stream(1).pinned",
          "equals": "be kind"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "deleteChat",
          "args": [
            1
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "ban",
          "args": [
            1,
            "bob"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "again"
          ],
          "fails": "notBanned"
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "unban",
          "args": [
            1,
            "bob"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "again"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "deleteChat",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Chat)",
          "equals": 1
        },
        {
          "expect": "Chat(2).body",
          "equals": "again"
        }
      ]
    },
    {
      "name": "tips add a Tip and a sub-styled chat line; subs, tiers and follows are per actor",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "tip",
          "args": [
            1,
            1000,
            "encore"
          ]
        },
        {
          "expect": "sum(t.cents in Tip where t.stream == 1)",
          "equals": 1000
        },
        {
          "expect": "Chat(1).role",
          "equals": "sub"
        },
        {
          "expect": "Chat(1).author",
          "equals": "bob"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "subscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "subscribeTier",
          "args": [
            1,
            3
          ]
        },
        {
          "expect": "count(Sub)",
          "equals": 2
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "unsubscribe",
          "args": [
            1
          ]
        },
        {
          "expect": "count(s in Sub where s.user == \"bob\")",
          "equals": 0
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "unsubscribeTier",
          "args": [
            1
          ]
        },
        {
          "expect": "count(Sub)",
          "equals": 0
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "ada"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "unfollow",
          "args": [
            "ada"
          ]
        },
        {
          "expect": "count(Follow)",
          "equals": 0
        }
      ]
    },
    {
      "name": "the tip sheet and the age gate are client cells",
      "steps": [
        {
          "expect": "tipOpen",
          "equals": false
        },
        {
          "run": "openTip"
        },
        {
          "expect": "tipOpen",
          "equals": true
        },
        {
          "run": "closeTip"
        },
        {
          "expect": "tipOpen",
          "equals": false
        },
        {
          "expect": "ageOk",
          "equals": false
        },
        {
          "run": "confirmAge"
        },
        {
          "expect": "ageOk",
          "equals": true
        }
      ]
    },
    {
      "name": "chat scan: the host is never held; a link, a shouted line and a third identical line are held; a held line reaches only its sender and the host until released",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "WELCOME EVERYONE TO THE STREAM http://mine.example"
          ]
        },
        {
          "expect": "Chat(1).held",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "  "
          ],
          "fails": "say something"
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "hello there"
          ]
        },
        {
          "expect": "Chat(2).held",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "free coins at https://scam.example"
          ]
        },
        {
          "expect": "Chat(3).held",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "THIS IS ABSOLUTELY AMAZING"
          ]
        },
        {
          "expect": "Chat(4).held",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "Nice One Everybody OK"
          ]
        },
        {
          "expect": "Chat(5).held",
          "equals": false
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "gg"
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "gg"
          ]
        },
        {
          "expect": "Chat(7).held",
          "equals": false
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "run": "say",
          "args": [
            1,
            "gg"
          ]
        },
        {
          "expect": "Chat(8).held",
          "equals": true
        },
        {
          "as": {
            "actor": "dee",
            "role": "member"
          },
          "expect": "count(c in Chat where c.stream == 1 && (!c.held || c.author == actor || actor == Stream(1).owner))",
          "equals": 5
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "count(c in Chat where c.stream == 1 && (!c.held || c.author == actor || actor == Stream(1).owner))",
          "equals": 7
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "count(c in Chat where c.stream == 1 && (!c.held || c.author == actor || actor == Stream(1).owner))",
          "equals": 8
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "releaseHeld",
          "args": [
            3
          ],
          "fails": "moderator"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "releaseHeld",
          "args": [
            3
          ]
        },
        {
          "expect": "Chat(3).held",
          "equals": false
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "releaseHeld",
          "args": [
            4
          ]
        },
        {
          "expect": "Chat(4).held",
          "equals": false
        }
      ]
    },
    {
      "name": "audience: everyone by default; followers-only and subscribers-only streams wall other viewers, never the owner",
      "steps": [
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "createChannel",
          "args": [
            "Ada live",
            "Music"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "setAudience",
          "args": [
            1,
            "followers"
          ],
          "fails": "owner"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setAudience",
          "args": [
            1,
            "vip"
          ],
          "fails": "everyone, followers or subscribers"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setAudience",
          "args": [
            1,
            "followers"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": false
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": true
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "follow",
          "args": [
            "ada"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": true
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setAudience",
          "args": [
            1,
            "subscribers"
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": false
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "subscribe",
          "args": [
            1
          ]
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": true
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "setAudience",
          "args": [
            1,
            ""
          ]
        },
        {
          "as": {
            "actor": "cy",
            "role": "member"
          },
          "expect": "mayWatch(1)",
          "equals": true
        }
      ]
    }
  ]
}
