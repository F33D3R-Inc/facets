# The search engine — the reference's search (feed-engine internal/search and
# internal/db/search.go over Postgres's `f33d3r` text search configuration,
# unaccent and pg_trgm) as procs a host runs over its own rows:
#
#   searchParse          the query language of the search bar (query.go)
#   searchDocText        a row's stored search field: body A | tags B | alt C,
#                        accent-folded, tokenised the way the default parser
#                        does and stemmed by Snowball English, stopwords kept
#                        as "_" so positions (phrases, cover density) survive
#   searchMatch/Rank     websearch_to_tsquery semantics over that field, and
#                        ts_rank_cd(…, 32) × recency, re-ranked by engagement
#   trigramSimilarity    pg_trgm's similarity / strict_word_similarity, for
#                        the misspelled ("neighbourhod") and did-you-mean
#
# The stored field is what a host keeps on its row and filters candidates by
# (`contains(w.search_text, " " + key + " ")`, a case-folded substring a
# trigram index answers); these procs then decide and rank exactly.
app FacetSearch:
    # One query as the engine understands it (query.go's Query). since/until
    # are unix seconds, -1 when unbounded; has is sorted.
    struct SearchQuery:
        raw: text
        terms: text
        words: [text]
        tags: [text]
        cashtags: [text]
        handles: [text]
        from: [text]
        since: int
        until: int
        has: [text]
        minReplies: int
        # The full-text part as websearch_to_tsquery reads Terms (with the
        # @handles and $cashtags after it): an OR of clauses, each an AND of
        # terms — a word or "phrase" of raw words, "-" before an excluded one.
        groups: [[text]]

    # A candidate row, as the host hands it over.
    type SearchDoc:
        id: int
        doc: text
        body: text
        author: text
        created: int
        engagement: int
        views: int
        replies: int
        media: bool
        video: bool
        image: bool
        voice: bool
        poll: bool

    struct SearchPage:
        ids: [int]
        total: int

    # ── text ─────────────────────────────────────────────────────────────────

    proc sxStartsWith(s: text, p: text) -> bool:
        return len(p) <= len(s) && slice(s, 0, len(p)) == p
    proc sxEndsWith(s: text, p: text) -> bool:
        return len(p) <= len(s) && slice(s, len(s) - len(p), len(s)) == p
    proc sxHasText(xs: [text], x: text) -> bool:
        let mut i = 0
        loop i < len(xs):
            if xs[i] == x:
                return true
            i = i + 1
        return false
    proc sxAppendUnique(xs: [text], x: text) -> [text]:
        if sxHasText(xs, x):
            return xs
        return append(xs, x)
    proc sxIsDigit(c: text) -> bool:
        return c >= "0" && c <= "9" && len(c) == 1
    proc sxIsAsciiAlnum(c: text) -> bool:
        return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || sxIsDigit(c)
    # Unicode punctuation and spaces a letter test would reject; every other
    # non-ASCII character is taken for a letter (unicode.IsLetter's answer
    # for the scripts a post is written in).
    proc sxIsUnicodePunct(c: text) -> bool:
        return contains("“”‘’«»‹›—–…·•¡¿„‚†‡‰′″、。，！？：；（）【】「」『』　", c)
    proc sxIsWordChar(c: text) -> bool:
        if sxIsAsciiAlnum(c):
            return true
        return c > "~" && c != "\u007f" && !sxIsUnicodePunct(c) && !sxIsUnicodeSpace(c)
    # RE2's \s: what query.go's spaceRe collapses.
    proc sxIsSpace(c: text) -> bool:
        return c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\u000c"
    # unicode.IsSpace: what the tokenizer splits on.
    proc sxIsUnicodeSpace(c: text) -> bool:
        return sxIsSpace(c) || c == "\u000b" || c == "\u0085" || c == "\u00a0" || c == "\u1680" || (c >= "\u2000" && c <= "\u200a") || c == "\u2028" || c == "\u2029" || c == "\u202f" || c == "\u205f" || c == "\u3000"
    # Collapses every run of whitespace to one space and trims.
    proc sxCollapseSpace(s: text) -> text:
        let mut out = ""
        let mut pending = false
        let mut i = 0
        let n = len(s)
        loop i < n:
            let c = charAt(s, i)
            if sxIsSpace(c):
                pending = out != ""
            else:
                if pending:
                    out = out + " "
                    pending = false
                out = out + c
            i = i + 1
        return trim(out)
    # query.go Normalize: whitespace collapsed, at most 200 runes.
    proc searchNormalize(raw: text) -> text:
        let s = sxCollapseSpace(raw)
        if len(s) > 200:
            return trim(slice(s, 0, 200))
        return s
    # query.go Key: "NFL Draft" and "nfl draft" are one search.
    proc searchKey(raw: text) -> text:
        return lower(searchNormalize(raw))

    # ── accent folding: Postgres's unaccent (unaccent.rules, all 2661 rules) ──

    # Each rule is "\n" + one character + "\t" + its replacement.
    proc sxUnaccentRules() -> text:
