# Search query — the language of the search bar, ported from the reference's
# search package (feed-engine/internal/search/query.go), whose own tests are
# this facet's sidecar:
#
#     "exact phrase"      the words together, in order
#     -word               without this word
#     cat OR dog          either word (bare OR, upper case)
#     #tag                works carrying #tag
#     $TSLA               works mentioning the cashtag
#     @handle             a person: works by or mentioning them
#     from:handle         works by one author (also by:)
#     to:handle           works mentioning them (also mentions:)
#     since:2026-01-01    on or after a day (also after:)
#     until:2026-01-31    on or before a day (also before:)
#     has:media           with media (also video/image/voice/poll/link)
#     min_replies:5       with at least this many replies
#
# The parser never fails: a token it does not understand is a plain word.
#
# A `where` filter is pure and cannot call a proc, so the query is parsed
# ONCE, by the `search` action (or `liveSearch`, the debounced dispatch
# forms/livesearchbox.fct makes), into this facet's per-session cells; the
# `searchHit` derive then applies every operator to a work in a view:
#
#     use LiveSearchBox("Search")
#     for t in Tweet where searchHit(t.body, t.author, t.created, t.media != "", 0) by surfaced desc:
#
# Normalisation is the platform's own (api/handles.fct seSearchNorm).
import "../api/handles.fct"
app FacetData:
    expect state q: text
    state sqRaw: text = "" @server
    state sqWords: [text] = [] @server
    state sqPhrases: [text] = [] @server
    state sqAny: [text] = [] @server
    state sqNeg: [text] = [] @server
    state sqTags: [text] = [] @server
    state sqCashtags: [text] = [] @server
    state sqHandles: [text] = [] @server
    state sqFrom: [text] = [] @server
    state sqHas: [text] = [] @server
    state sqSince: int = 0 @server
    state sqUntil: int = 0 @server
    state sqMinReplies: int = 0 @server
    # ── the parser ───────────────────────────────────────────────────────────
    # tokenize: split on spaces, keeping a "quoted phrase" whole (an unclosed
    # quote runs to the end). A quoted token keeps its opening quote as the
    # mark that it was one.
    proc sqTokens(s: text) -> [text]:
        let mut out = []
        let mut cur = ""
        let mut quoted = false
        let mut i = 0
        loop i < len(s):
            let c = charAt(s, i)
            if c == "\"" || c == "“" || c == "”":
                if quoted:
                    out = out + ["\"" + cur]
                    cur = ""
                    quoted = false
                else:
                    if trim(cur) != "":
                        out = out + [cur]
                    cur = ""
                    quoted = true
            else:
                if (c == " " || c == "\t" || c == "\n") && !quoted:
                    if trim(cur) != "":
                        out = out + [cur]
                    cur = ""
                else:
                    cur = cur + c
            i = i + 1
        if quoted:
            out = out + ["\"" + cur]
        else:
            if trim(cur) != "":
                out = out + [cur]
        return out
    proc sqIsAlnum(c: text) -> bool:
        return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", c)
    # cleanWord: strip the punctuation the parser would drop from the ends,
    # keeping a leading "-" (exclusion); ":&|!()<>\" are not words.
    proc sqCleanWord(t0: text) -> text:
        let neg = slice(t0, 0, 1) == "-"
        let mut t = t0
        loop slice(t, 0, 1) == "-":
            t = slice(t, 1, len(t))
        let mut a = 0
        loop a < len(t) && !sqIsAlnum(charAt(t, a)) && !contains("'#$@", charAt(t, a)):
            a = a + 1
        let mut b = len(t)
        loop b > a && !sqIsAlnum(charAt(t, b - 1)) && !contains("'#$@", charAt(t, b - 1)):
            b = b - 1
        t = slice(t, a, b)
        let mut out = ""
        let mut i = 0
        loop i < len(t):
            let c = charAt(t, i)
            if contains(":&|!()<>\\", c):
                out = out + " "
            else:
                out = out + c
            i = i + 1
        out = trim(seSearchNorm(out))
        if out == "":
            return ""
        if neg:
            return "-" + split(out, " ")[0]
        return out
    # plainWords: lowercase words of letters and digits, an apostrophe or
    # underscore kept inside a word.
    proc sqPlainWords(s: text) -> [text]:
        let mut out = []
        let mut cur = ""
        let mut i = 0
        let low = lower(s)
        loop i <= len(low):
            let c = slice(low, i, i + 1)
            if i < len(low) && (sqIsAlnum(c) || c == "'" || c == "_"):
                cur = cur + c
            else:
                let w = sqTrimMarks(cur)
                if w != "":
                    out = out + [w]
                cur = ""
            i = i + 1
        return out
    proc sqTrimMarks(w: text) -> text:
        let mut a = 0
        loop a < len(w) && contains("'_", charAt(w, a)):
            a = a + 1
        let mut b = len(w)
        loop b > a && contains("'_", charAt(w, b - 1)):
            b = b - 1
        return slice(w, a, b)
    proc sqOnly(s: text, allowed: text, max: int) -> bool:
        return seOnly(s, allowed, max)
    proc sqIsHandle(h: text) -> bool:
        return sqOnly(h, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", 30)
    proc sqIsTag(t: text) -> bool:
        return sqOnly(t, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", 100)
    proc sqIsCashtag(c: text) -> bool:
        return sqOnly(c, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", 6)
    proc sqHasFacet(v: text) -> text:
        if v == "media" || v == "video" || v == "image" || v == "voice" || v == "poll" || v == "link":
            return v
        if v == "images":
            return "image"
        if v == "links":
            return "link"
        return ""
    # A YYYY-MM-DD day as seconds since the epoch (UTC), 0 when it is not one.
    proc sqDay(s: text) -> int:
        if len(s) != 10 || charAt(s, 4) != "-" || charAt(s, 7) != "-":
            return 0
        let y = slice(s, 0, 4)
        let m = slice(s, 5, 7)
        let d = slice(s, 8, 10)
        if !sqOnly(y, "0123456789", 4) || !sqOnly(m, "0123456789", 2) || !sqOnly(d, "0123456789", 2):
            return 0
        if toInt(m) < 1 || toInt(m) > 12 || toInt(d) < 1 || toInt(d) > 31:
            return 0
        return fromIso(s + "T00:00:00Z")
    proc sqHas(xs: [text], x: text) -> bool:
        return seHas(xs, x)
    # One pass over the tokens, answering the field asked for: "words" (the
    # required words and phrases), "any" (the OR alternatives), "neg" (the
    # exclusions), "tags", "cash", "handles", "from", "has".
    proc sqField(raw: text, field: text) -> [text]:
        let toks = sqTokens(seSearchNorm(raw))
        let mut out = []
        let mut i = 0
        loop i < len(toks):
            let t = toks[i]
            # An OR joins the terms on both its sides; one at the edge is dropped.
            let nextOr = i + 2 < len(toks) && toks[i + 1] == "OR" && toks[i + 2] != "OR"
            let prevOr = i >= 2 && toks[i - 1] == "OR" && toks[i - 2] != "OR"
            if slice(t, 0, 1) == "\"":
                let phrase = lower(trim(slice(t, 1, len(t))))
                if phrase != "":
                    if field == "any" && (nextOr || prevOr):
                        out = out + [phrase]
                    if field == "phrases" && !(nextOr || prevOr):
                        out = out + [phrase]
            else:
                if t == "OR":
                    i = i + 1
                    continue
                let mut handled = false
                if slice(t, 0, 1) == "#" && len(t) > 1 && sqIsTag(slice(t, 1, len(t))):
                    handled = true
                    if field == "tags" && !sqHas(out, lower(slice(t, 1, len(t)))):
                        out = out + [lower(slice(t, 1, len(t)))]
                if !handled && slice(t, 0, 1) == "$" && len(t) > 1 && sqIsCashtag(slice(t, 1, len(t))):
                    handled = true
                    if field == "cash" && !sqHas(out, upper(slice(t, 1, len(t)))):
                        out = out + [upper(slice(t, 1, len(t)))]
                if !handled && slice(t, 0, 1) == "@" && len(t) > 1 && sqIsHandle(slice(t, 1, len(t))):
                    handled = true
                    if field == "handles" && !sqHas(out, lower(slice(t, 1, len(t)))):
                        out = out + [lower(slice(t, 1, len(t)))]
                if !handled && contains(t, ":") && slice(t, 0, 1) != "-":
                    let kv = split(t, ":")
                    let key = lower(kv[0])
                    let val = slice(t, len(kv[0]) + 1, len(t))
                    if key != "" && val != "":
                        let h = lower(sqStripAt(val))
                        if (key == "from" || key == "by") && sqIsHandle(h):
                            handled = true
                            if field == "from" && !sqHas(out, h):
                                out = out + [h]
                        if !handled && (key == "to" || key == "mentions") && sqIsHandle(h):
                            handled = true
                            if field == "handles" && !sqHas(out, h):
                                out = out + [h]
                        if !handled && (key == "since" || key == "after" || key == "until" || key == "before") && sqDay(val) > 0:
                            handled = true
                        if !handled && (key == "has" || key == "filter" || key == "is") && sqHasFacet(lower(val)) != "":
                            handled = true
                            if field == "has" && !sqHas(out, sqHasFacet(lower(val))):
                                out = out + [sqHasFacet(lower(val))]
                        if !handled && (key == "min_replies" || key == "min_replys") && sqOnly(val, "0123456789", 7) && toInt(val) > 0:
                            handled = true
                        if !handled && key == "tag" && sqIsTag(sqStripHash(val)):
                            handled = true
                            if field == "tags" && !sqHas(out, lower(sqStripHash(val))):
                                out = out + [lower(sqStripHash(val))]
                if !handled:
                    let w = sqCleanWord(t)
                    if w != "":
                        if slice(w, 0, 1) == "-":
                            if field == "neg":
                                out = out + [lower(slice(w, 1, len(w)))]
                        else:
                            if field == "any" && (nextOr || prevOr):
                                out = out + [lower(w)]
                            if field == "words" && !(nextOr || prevOr):
                                # The lexicon words of the term (the reference's Words).
                                let ws = sqPlainWords(w)
                                let mut j = 0
                                loop j < len(ws):
                                    out = out + [ws[j]]
                                    j = j + 1
            i = i + 1
        return out
    proc sqStripAt(v: text) -> text:
        if slice(v, 0, 1) == "@":
            return slice(v, 1, len(v))
        return v
    proc sqStripHash(v: text) -> text:
        if slice(v, 0, 1) == "#":
            return slice(v, 1, len(v))
        return v
    # The numeric operators: since (start of day), until (end of day), min_replies.
    proc sqInt(raw: text, field: text) -> int:
        let toks = sqTokens(seSearchNorm(raw))
        let mut i = 0
        loop i < len(toks):
            let t = toks[i]
            if contains(t, ":") && slice(t, 0, 1) != "-" && slice(t, 0, 1) != "\"":
                let kv = split(t, ":")
                let key = lower(kv[0])
                let val = slice(t, len(kv[0]) + 1, len(t))
                if field == "since" && (key == "since" || key == "after") && sqDay(val) > 0:
                    return sqDay(val)
                if field == "until" && (key == "until" || key == "before") && sqDay(val) > 0:
                    return sqDay(val) + 86399
                if field == "min_replies" && (key == "min_replies" || key == "min_replys") && sqOnly(val, "0123456789", 7) && toInt(val) > 0:
                    if toInt(val) > 1000000:
                        return 1000000
                    return toInt(val)
            i = i + 1
        return 0
    # The lexicon words of the whole query (plain words and phrases, no
    # exclusions) — what "did you mean" and highlighting read.
    proc sqLexicon(raw: text) -> [text]:
        let words = sqField(raw, "words")
        let alts = sqField(raw, "any")
        let mut out = []
        let mut i = 0
        loop i < len(words):
            let ws = sqPlainWords(words[i])
            let mut j = 0
            loop j < len(ws):
                out = out + [ws[j]]
                j = j + 1
            i = i + 1
        i = 0
        loop i < len(alts):
            let ws = sqPlainWords(alts[i])
            let mut j = 0
            loop j < len(ws):
                out = out + [ws[j]]
                j = j + 1
            i = i + 1
        return out
    # ── the search ───────────────────────────────────────────────────────────
    action search(query: text):
        let norm = do seSearchNorm(query)
        let words = do sqField(query, "words")
        let phrases = do sqField(query, "phrases")
        let alts = do sqField(query, "any")
        let neg = do sqField(query, "neg")
        let tags = do sqField(query, "tags")
        let cash = do sqField(query, "cash")
        let handles = do sqField(query, "handles")
        let from = do sqField(query, "from")
        let has = do sqField(query, "has")
        let since = do sqInt(query, "since")
        let until = do sqInt(query, "until")
        let minr = do sqInt(query, "min_replies")
        sqRaw = norm
        sqWords = words
        sqPhrases = phrases
        sqAny = alts
        sqNeg = neg
        sqTags = tags
        sqCashtags = cash
        sqHandles = handles
        sqFrom = from
        sqHas = has
        sqSince = since
        sqUntil = until
        sqMinReplies = minr
    # The debounced dispatch forms/livesearchbox.fct expects of its host.
    action liveSearch(term: text):
        let norm = do seSearchNorm(term)
        let words = do sqField(term, "words")
        let phrases = do sqField(term, "phrases")
        let alts = do sqField(term, "any")
        let neg = do sqField(term, "neg")
        let tags = do sqField(term, "tags")
        let cash = do sqField(term, "cash")
        let handles = do sqField(term, "handles")
        let from = do sqField(term, "from")
        let has = do sqField(term, "has")
        let since = do sqInt(term, "since")
        let until = do sqInt(term, "until")
        let minr = do sqInt(term, "min_replies")
        sqRaw = norm
        sqWords = words
        sqPhrases = phrases
        sqAny = alts
        sqNeg = neg
        sqTags = tags
        sqCashtags = cash
        sqHandles = handles
        sqFrom = from
        sqHas = has
        sqSince = since
        sqUntil = until
        sqMinReplies = minr
    # Whether a work answers the parsed query: every required word or phrase,
    # at least one OR alternative, no excluded word, every #tag and $cashtag,
    # every @handle (as author or mention), an author in from:, the day
    # bounds, the media facets, the reply floor. An empty query matches all.
    derive searchHit(body: text, author: text, created: int, hasMedia: bool, replies: int): bool = count(w in sqWords where !contains(lower(body), w)) == 0 && count(p in sqPhrases where !contains(lower(body), p)) == 0 && (len(sqAny) == 0 || count(w in sqAny where contains(lower(body), w)) > 0) && count(w in sqNeg where contains(lower(body), w)) == 0 && count(tg in sqTags where !contains(lower(body), "#" + tg)) == 0 && count(c in sqCashtags where !contains(upper(body), "$" + c)) == 0 && count(h in sqHandles where !contains(lower(body), "@" + h) && lower(author) != h) == 0 && (len(sqFrom) == 0 || count(h in sqFrom where h == lower(author)) > 0) && (sqSince == 0 || created >= sqSince) && (sqUntil == 0 || created <= sqUntil) && (count(h in sqHas where h == "media" || h == "image" || h == "video" || h == "voice") == 0 || hasMedia) && (sqMinReplies == 0 || replies >= sqMinReplies)
