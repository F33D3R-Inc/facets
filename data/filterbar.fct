# FilterBar — a search box and a row of filter chips, in the one bar a list
# or a table sits under.
#
#     state planFilter: text = "" @client
#     state onlyActive: bool = true @client
#     use FilterBar(planFilter, "Filter plans…"):
#         use ChipToggle("Active only", onlyActive)
#     for p in Plan where contains(lower(p.name), lower(planFilter)) && (!onlyActive || p.active) by name asc limit 50:
#         ...
#
# ── WHY THIS IS NOT `forms/SearchBox` WITH A PARAMETER ADDED ─────────────────
#
# `forms/searchbox.fct` binds the one input the right rail is assumed to have
# — a fixed `q` cell every call site shares — and adding a `v: cell text`
# parameter to that file would leave its existing call sites binding a name
# they were never given. A list-scoped filter is a different job with the
# same shape: the caller's OWN cell, so two filtered lists on one view can
# each carry their own text without colliding. Hence a second, small
# component instead of a change to a file other screens already depend on.
#
# ── THE CHIPS ARE A SLOT, NOT A SECOND PARAMETER LIST ────────────────────────
#
# A filter bar's chips are `ui/ChipToggle` bound to whatever `@client bool`
# cells this page's own query already reads — there is no way to pass a list
# of (label, cell) pairs as a value, the same reason `forms/field.fct`'s
# scaffold takes its control as a child rather than a parameter. This file
# owns the search box and the row layout; the caller writes the chips, and
# `ui/ChipRow` (imported, not re-declared) is what lays them out so a filter
# bar's chip row is pixel-identical to every other chip row in the library.
import "../ui/chip.fct"
app FacetData:
    css:
        [data-fa-mount] .x-filterbar { display: flex; flex-direction: row; flex-wrap: wrap;
                       align-items: center; gap: 12px; padding: 4px 0 16px;
                       border: none; background: none; }
        [data-fa-mount] .x-filterbar-search { flex: 1 1 220px; min-width: 160px;
                       border: none; background: none; padding: 0; }
        [data-fa-mount] .x-filterbar-search input { width: 100%; box-sizing: border-box;
                       background: var(--x-panel, #16181c); border: 1px solid var(--x-line, #2f3336);
                       border-radius: 9999px; padding: 10px 16px; font-size: 14px; color: var(--fa-fg); }
        [data-fa-mount] .x-filterbar-search input:focus { border-color: var(--fa-accent); outline: none; }
        [data-fa-mount] .x-filterbar > .fa-use { display: contents; }
    component FilterBar(q: cell text, placeholder: text):
        row class "x-filterbar":
            box class "x-filterbar-search":
                input bind q placeholder "{placeholder}"
            use ChipRow():
                slot
