# Feed — a `data` facet: a whole vertical slice (durable data + server logic +
# authorization + content) that snaps into the `feed` socket. Its presentation is
# composed from the SHARED component atoms (PostCard / ComposeBox / SearchBox /
# WhoToFollow) — the same files the plain-app track imports — now that a layered
# build can pull in component-only modules (the shareable-component gap, closed in
# v1.17.0). Exercises the v1.16 language end to end: filtered count/exists, tabs,
# match, richtext/video, pending/failed, contains/search, components, image/badge,
# and `remove … where` (unfollow).
import "../social/postcard.fct"
import "../social/composebox.fct"
import "../social/whotofollow.fct"
import "../forms/searchbox.fct"
data Feed in feed:
    enum Kind: text, richtext, video

    entity Tweet:
        id: int
        author: text
        handle: text
        verified: bool
        kind: Kind
        body: text
        media: text
        created: int
        # When the work last reached a feed — its posting or its newest repost
        # (the reference's feed_ts): a fresh repost lifts it to the top.
        surfaced: int
    entity Like:
        id: int
        tweet: Tweet
        user: text
    entity Repost:
        id: int
        tweet: Tweet
        user: text
    entity Bookmark:
        id: int
        tweet: Tweet
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text

    state draft: text = "" @client
    state feedTab: text = "foryou" @client
    state q: text = "" @client
    state shown: int = 20 @client

    policy member:
        actor != "guest"

    derive follows(who: text): bool = exists(f in Follow where f.follower == actor && f.followee == who)
    action post(body: text):
        requires member
        check trim(body) != "" "say something"
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", created: now(), surfaced: now() }
    # One reaction per person and work; a repost is a feed item that lifts the
    # work back to the top of the feeds.
    action like(id: int):
        requires member
        check exists(t in Tweet where t.id == id) "that post doesn't exist"
        check !exists(l in Like where l.tweet == id && l.user == actor) "you already liked this"
        add Like { tweet: id, user: actor }
    action repost(id: int):
        requires member
        check exists(t in Tweet where t.id == id) "that post doesn't exist"
        check !exists(r in Repost where r.tweet == id && r.user == actor) "you already reposted this"
        add Repost { tweet: id, user: actor }
        set Tweet(id).surfaced = now()
    action bookmark(id: int):
        requires member
        check !exists(b in Bookmark where b.tweet == id && b.user == actor) "already bookmarked"
        add Bookmark { tweet: id, user: actor }
    action follow(target_handle: text):
        requires member
        let handle = target_handle
        check handle != actor "you cannot follow yourself"
        check !exists(f in Follow where f.follower == actor && f.followee == handle) "already following"
        add Follow { follower: actor, followee: handle }
    action unfollow(target_handle: text):
        requires member
        let handle = target_handle
        remove f in Follow where f.follower == actor && f.followee == handle

    content:
        use ComposeBox()
        use SearchBox()
        tabs bind feedTab:
            tab "For you" -> "foryou":
                for t in Tweet where contains(lower(t.body), lower(q)) by surfaced desc limit shown:
                    use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
            tab "Following" -> "following":
                for t in Tweet where (t.author == actor || follows(t.author) || exists(r in Repost where r.tweet == t.id && (r.user == actor || follows(r.user)))) by surfaced desc limit shown:
                    use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
        text "Who to follow"
        use WhoToFollow("Grace Hopper", "grace", true, exists(f in Follow where f.follower == actor && f.followee == "grace"))
        use WhoToFollow("Alan Turing", "alan", false, exists(f in Follow where f.follower == actor && f.followee == "alan"))

    # ── the other screens this slice serves ─────────────────────────────────
    # A `data` facet may declare routed `view`s as well as its `content:` block.
    # `content:` is what the wireframe's socket holds on the mounted route; a
    # `view` here is another whole screen rendered in that same wireframe, with
    # this socket holding the view instead. That is the layered-track analogue of
    # `view X in Shell` on the plain track, and it is the thing this file was
    # missing all day: `PostCard`'s body links to "/post/{id}", and a link to a
    # route no view serves is a build failure — correctly, because a dangling
    # destination inside a shared component would otherwise be discovered by a
    # reader clicking it.
    #
    # THE ROUTES BELONG TO THIS FACET AND NOT TO THE WIREFRAME. `feed` is the
    # socket that owns Tweet, so it is the only place that can answer "what is at
    # /post/7" without a second facet reaching into this one's entities. The nav
    # rail and the right rail come from the wireframe either way, so all three
    # screens are the same site rather than three pages that happen to share a
    # stylesheet.
    view PostDetail at "/post/:id":
        meta title "Post / F33D3R"
        # One row, or the words that say there is none. The `for` is how a single
        # row is fetched — there is no "get one" node — and the `limit 1` is what
        # makes that honest rather than incidental.
        for t in Tweet where t.id == id by id desc limit 1:
            use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
        if !exists(t in Tweet where t.id == id):
            text "This post no longer exists."

    view Profile at "/profile/:handle":
        meta title "@{handle} / F33D3R"
        # `UserChip` and `PostCard` both link a handle here, so this is the
        # destination the whole component set has been pointing at. The follow
        # control is the same `WhoToFollow` the right rail uses — one facet for
        # "this person, and whether you follow them", not a second one that means
        # the same thing on a different page.
        text "Posts by @{handle}"
        use WhoToFollow(handle, handle, false, exists(f in Follow where f.follower == actor && f.followee == handle))
        if !exists(t in Tweet where t.author == handle):
            text "No posts yet."
        for t in Tweet where t.author == handle by created desc limit shown:
            use PostCard(t.id, t.author, t.handle, t.verified, t.kind, t.body, t.media, t.created, count(l in Like where l.tweet == t.id), 0, count(r in Repost where r.tweet == t.id), 0)
