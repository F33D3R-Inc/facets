{
  "tests": [
    {
      "name": "plain words: whitespace collapses, words lowercase, every word must be in the body (the reference's Parse(\"  baby   Elephant  sanctuary \"))",
      "steps": [
        {
          "run": "search",
          "args": [
            "  baby   Elephant  sanctuary "
          ]
        },
        {
          "expect": "sqRaw",
          "equals": "baby Elephant sanctuary"
        },
        {
          "expect": "sqWords",
          "equals": [
            "baby",
            "elephant",
            "sanctuary"
          ]
        },
        {
          "expect": "searchHit(\"A baby elephant at the sanctuary\", \"ada\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"A baby at the sanctuary\", \"ada\", 100, false, 0)",
          "equals": false
        },
        {
          "run": "search",
          "args": [
            ""
          ]
        },
        {
          "expect": "searchHit(\"anything\", \"ada\", 100, false, 0)",
          "equals": true
        }
      ]
    },
    {
      "name": "\"exact phrase\", -word and OR (Parse(`\"nfl draft\" -mock cats OR dogs`)): the phrase whole, the exclusion absent, one of the alternatives present",
      "steps": [
        {
          "run": "search",
          "args": [
            "\"nfl draft\" -mock cats OR dogs"
          ]
        },
        {
          "expect": "sqPhrases",
          "equals": [
            "nfl draft"
          ]
        },
        {
          "expect": "sqWords",
          "equals": []
        },
        {
          "expect": "sqNeg",
          "equals": [
            "mock"
          ]
        },
        {
          "expect": "sqAny",
          "equals": [
            "cats",
            "dogs"
          ]
        },
        {
          "expect": "searchHit(\"the NFL draft and my dogs\", \"ada\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"the NFL draft and my cats\", \"ada\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"the NFL draft, a mock, and cats\", \"ada\", 100, false, 0)",
          "equals": false
        },
        {
          "expect": "searchHit(\"the draft of the NFL and cats\", \"ada\", 100, false, 0)",
          "equals": false
        },
        {
          "expect": "searchHit(\"the NFL draft alone\", \"ada\", 100, false, 0)",
          "equals": false
        },
        {
          "run": "search",
          "args": [
            "OR cats OR"
          ]
        },
        {
          "expect": "sqWords",
          "equals": [
            "cats"
          ]
        },
        {
          "expect": "sqAny",
          "equals": []
        },
        {
          "run": "search",
          "args": [
            "OR OR"
          ]
        },
        {
          "expect": "sqWords",
          "equals": []
        },
        {
          "expect": "searchHit(\"anything\", \"ada\", 100, false, 0)",
          "equals": true
        }
      ]
    },
    {
      "name": "operators (Parse(\"#NFL $tsla @Edd from:@Alice since:2026-01-02 until:2026-01-31 has:video has:LINKS min_replies:3 draft\")): tags lowercase, cashtags uppercase, handles and authors lowercase, day bounds, facets, the reply floor, the rest a word",
      "steps": [
        {
          "run": "search",
          "args": [
            "#NFL $tsla @Edd from:@Alice since:2026-01-02 until:2026-01-31 has:video has:LINKS min_replies:3 draft"
          ]
        },
        {
          "expect": "sqTags",
          "equals": [
            "nfl"
          ]
        },
        {
          "expect": "sqCashtags",
          "equals": [
            "TSLA"
          ]
        },
        {
          "expect": "sqHandles",
          "equals": [
            "edd"
          ]
        },
        {
          "expect": "sqFrom",
          "equals": [
            "alice"
          ]
        },
        {
          "expect": "sqHas",
          "equals": [
            "video",
            "link"
          ]
        },
        {
          "expect": "sqMinReplies",
          "equals": 3
        },
        {
          "expect": "sqWords",
          "equals": [
            "draft"
          ]
        },
        {
          "expect": "sqSince",
          "equals": 1767312000
        },
        {
          "expect": "sqUntil",
          "equals": 1769903999
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"alice\", 1768000000, true, 3)",
          "equals": true
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"bob\", 1768000000, true, 3)",
          "equals": false
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"alice\", 1767000000, true, 3)",
          "equals": false
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"alice\", 1770000000, true, 3)",
          "equals": false
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"alice\", 1768000000, false, 3)",
          "equals": false
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up, thanks @edd\", \"alice\", 1768000000, true, 2)",
          "equals": false
        },
        {
          "expect": "searchHit(\"#nfl draft: $TSLA up\", \"edd\", 1768000000, true, 3)",
          "equals": false
        }
      ]
    },
    {
      "name": "an unknown operator, a bad facet and a bad day are plain words (Parse(\"has:everything lang:fr note:hello\"), Parse(\"since:yesterday until:2026-13-40\"))",
      "steps": [
        {
          "run": "search",
          "args": [
            "has:everything lang:fr note:hello"
          ]
        },
        {
          "expect": "sqHas",
          "equals": []
        },
        {
          "expect": "sqWords",
          "equals": [
            "has",
            "everything",
            "lang",
            "fr",
            "note",
            "hello"
          ]
        },
        {
          "run": "search",
          "args": [
            "since:yesterday until:2026-13-40"
          ]
        },
        {
          "expect": "sqSince",
          "equals": 0
        },
        {
          "expect": "sqUntil",
          "equals": 0
        },
        {
          "expect": "sqWords",
          "equals": [
            "since",
            "yesterday",
            "until",
            "2026",
            "13",
            "40"
          ]
        }
      ]
    },
    {
      "name": "a bare @handle is a person: works by them or mentioning them; to: and mentions: name a mention; tag: is a #tag; by: is from:",
      "steps": [
        {
          "run": "search",
          "args": [
            "@edd"
          ]
        },
        {
          "expect": "searchHit(\"hello world\", \"edd\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"thanks @Edd\", \"ada\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"hello world\", \"ada\", 100, false, 0)",
          "equals": false
        },
        {
          "run": "search",
          "args": [
            "to:edd tag:#Draft by:ada"
          ]
        },
        {
          "expect": "sqHandles",
          "equals": [
            "edd"
          ]
        },
        {
          "expect": "sqTags",
          "equals": [
            "draft"
          ]
        },
        {
          "expect": "sqFrom",
          "equals": [
            "ada"
          ]
        },
        {
          "expect": "searchHit(\"@edd see #draft\", \"ada\", 100, false, 0)",
          "equals": true
        },
        {
          "expect": "searchHit(\"@edd see #draft\", \"bob\", 100, false, 0)",
          "equals": false
        }
      ]
    },
    {
      "name": "liveSearch is the same parse, the debounced dispatch the search box makes; handles keep an inner underscore (Parse(\"edd_app rocks _\"))",
      "steps": [
        {
          "run": "liveSearch",
          "args": [
            "edd_app rocks _"
          ]
        },
        {
          "expect": "sqWords",
          "equals": [
            "edd_app",
            "rocks"
          ]
        },
        {
          "expect": "searchHit(\"edd_app rocks the house\", \"ada\", 100, false, 0)",
          "equals": true
        }
      ]
    }
  ]
}
