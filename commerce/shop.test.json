{
  "tests": [
    {
      "name": "subscribeTo (shop.go subscribeToCreator, web_shop.go Subscribe): not yourself (400); a creator without a documented identity cannot be paid (403 creator_not_verified); the default price is 1 AET, charged as an Ain Soph tip (1% to the pool); active for 30 days, and a renewal charges again and extends",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada",
                "identity_tier": 0,
                "age_band": "unknown"
              },
              {
                "handle": "cat",
                "identity_tier": 2,
                "age_band": "21+"
              },
              {
                "handle": "dan",
                "identity_tier": 1,
                "age_band": "unknown"
              }
            ],
            "Shop": [
              {
                "owner": 2,
                "is_enabled": true
              },
              {
                "owner": 3,
                "is_enabled": true
              }
            ],
            "ShopPlan": [
              {
                "shop": 1,
                "name": "Gold",
                "price_aet": 5,
                "is_active": true
              },
              {
                "shop": 1,
                "name": "Old",
                "price_aet": 2,
                "is_active": false
              }
            ],
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 20000000,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "run": "subscribeTo",
          "args": [
            2,
            2,
            0
          ],
          "fails": "cannot subscribe to yourself"
        },
        {
          "run": "subscribeTo",
          "args": [
            1,
            3,
            0
          ],
          "fails": "has not completed identity verification"
        },
        {
          "run": "subscribeTo",
          "args": [
            1,
            2,
            0
          ]
        },
        {
          "expect": "balanceOf(1)",
          "equals": 19000000
        },
        {
          "expect": "balanceOf(2)",
          "equals": 990000
        },
        {
          "expect": "feePool",
          "equals": 10000
        },
        {
          "expect": "count(s in ShopSubscription where s.account == 1 && s.status == \"active\")",
          "equals": 1
        },
        {
          "expect": "subscribedTo(1, 2, now())",
          "equals": true
        },
        {
          "expect": "subscriberCount(2, now())",
          "equals": 1
        },
        {
          "run": "subscribeTo",
          "args": [
            1,
            2,
            0
          ]
        },
        {
          "expect": "count(ShopSubscription)",
          "equals": 1
        },
        {
          "expect": "balanceOf(1)",
          "equals": 18000000
        },
        {
          "expect": "max(s.period_end in ShopSubscription where true) > now() + 5000000",
          "equals": true
        }
      ]
    },
    {
      "name": "plans: a subscription to an active plan charges its whole-AET price; a retired or foreign plan is refused; an uncovered charge is 422 insufficient_balance and moves nothing",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada",
                "identity_tier": 0,
                "age_band": "unknown"
              },
              {
                "handle": "cat",
                "identity_tier": 2,
                "age_band": "21+"
              },
              {
                "handle": "dan",
                "identity_tier": 1,
                "age_band": "unknown"
              }
            ],
            "Shop": [
              {
                "owner": 2,
                "is_enabled": true
              },
              {
                "owner": 3,
                "is_enabled": true
              }
            ],
            "ShopPlan": [
              {
                "shop": 1,
                "name": "Gold",
                "price_aet": 5,
                "is_active": true
              },
              {
                "shop": 1,
                "name": "Old",
                "price_aet": 2,
                "is_active": false
              }
            ],
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 20000000,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "run": "subscribeTo",
          "args": [
            1,
            2,
            1
          ]
        },
        {
          "expect": "balanceOf(1)",
          "equals": 15000000
        },
        {
          "expect": "max(s.plan in ShopSubscription where true)",
          "equals": 1
        },
        {
          "run": "subscribeTo",
          "args": [
            1,
            2,
            2
          ],
          "fails": "no such plan"
        },
        {
          "run": "subscribeTo",
          "args": [
            3,
            2,
            1
          ],
          "fails": "Not enough AET to subscribe"
        },
        {
          "expect": "count(w in WalletEntry where w.account == 3)",
          "equals": 0
        }
      ]
    },
    {
      "name": "the expiry sweep ends a subscription whose 30 days are over",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada",
                "identity_tier": 0,
                "age_band": "unknown"
              },
              {
                "handle": "cat",
                "identity_tier": 2,
                "age_band": "21+"
              },
              {
                "handle": "dan",
                "identity_tier": 1,
                "age_band": "unknown"
              }
            ],
            "Shop": [
              {
                "owner": 2,
                "is_enabled": true
              },
              {
                "owner": 3,
                "is_enabled": true
              }
            ],
            "ShopPlan": [
              {
                "shop": 1,
                "name": "Gold",
                "price_aet": 5,
                "is_active": true
              },
              {
                "shop": 1,
                "name": "Old",
                "price_aet": 2,
                "is_active": false
              }
            ],
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 20000000,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "seed": {
            "ShopSubscription": [
              {
                "shop": 1,
                "account": 1,
                "plan": 0,
                "created": 1,
                "status": "active",
                "period_end": 2
              },
              {
                "shop": 1,
                "account": 3,
                "plan": 0,
                "created": 1,
                "status": "active",
                "period_end": 99999999999
              }
            ]
          }
        },
        {
          "run": "expireSubs"
        },
        {
          "expect": "count(s in ShopSubscription where s.status == \"expired\")",
          "equals": 1
        },
        {
          "expect": "subscribedTo(3, 2, now())",
          "equals": true
        },
        {
          "expect": "subscribedTo(1, 2, now())",
          "equals": false
        }
      ]
    }
  ]
}