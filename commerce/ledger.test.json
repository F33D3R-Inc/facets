{
  "tests": [
    {
      "name": "Ain Soph's movements on the product's WalletEntry rows: a tip (1%) and a transfer (3%) debit the sender the amount and credit the receiver the amount less the floored fee, which the pool (account 0) keeps",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 10000000,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            2,
            1000000,
            "tip",
            "tip_sent",
            "tip_received"
          ],
          "returns": 990000
        },
        {
          "expect": "balanceOf(1)",
          "equals": 9000000
        },
        {
          "expect": "balanceOf(2)",
          "equals": 990000
        },
        {
          "expect": "feePool",
          "equals": 10000
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            2,
            1000000,
            "transfer",
            "send",
            "receive"
          ],
          "returns": 970000
        },
        {
          "expect": "feePool",
          "equals": 40000
        },
        {
          "expect": "balanceOf(1) + balanceOf(2) + feePool",
          "equals": 10000000
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            2,
            99,
            "tip",
            "tip_sent",
            "tip_received"
          ],
          "returns": 99
        },
        {
          "run": "ledgerMove",
          "args": [
            2,
            1,
            5000,
            "sale",
            "work_purchase",
            "work_sale"
          ],
          "returns": 5000
        }
      ]
    },
    {
      "name": "refusals are Ain Soph's: a non-positive amount, sender = receiver, an insufficient balance \u2014 and nothing moves",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 100,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            2,
            0,
            "tip",
            "a",
            "b"
          ],
          "fails": "amount must be positive"
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            1,
            50,
            "tip",
            "a",
            "b"
          ],
          "fails": "cannot send to yourself"
        },
        {
          "run": "ledgerMove",
          "args": [
            1,
            2,
            101,
            "tip",
            "a",
            "b"
          ],
          "fails": "insufficient balance"
        },
        {
          "expect": "count(WalletEntry)",
          "equals": 1
        }
      ]
    },
    {
      "name": "the wallet UI's actions on the ledger: topUp only opens a pending intent; transfer and a red packet move AET cents as transfers; an operator's credit is an operator's",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "WalletEntry": [
              {
                "account": 1,
                "kind": "deposit",
                "amount_uaet": 1000000,
                "counterparty": 0,
                "created": 1
              }
            ]
          }
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "topUp",
          "args": [
            500
          ]
        },
        {
          "expect": "count(i in PaymentIntent where i.owner == 1 && i.status == \"pending\" && i.usd_cents == 500)",
          "equals": 1
        },
        {
          "expect": "balanceOf(1)",
          "equals": 1000000
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "transfer",
          "args": [
            "bob",
            50,
            "lunch"
          ]
        },
        {
          "expect": "balanceOf(2)",
          "equals": 485000
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "sendRedPacket",
          "args": [
            "bob",
            10,
            "hi"
          ]
        },
        {
          "expect": "count(w in WalletEntry where w.kind == \"red_packet_received\" && w.amount_uaet == 97000)",
          "equals": 1
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "transfer",
          "args": [
            "nobody",
            1,
            ""
          ],
          "fails": "no such account"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "adminCredit",
          "args": [
            "bob",
            5
          ],
          "fails": "only an operator"
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "adminCredit",
          "args": [
            "bob",
            5
          ]
        },
        {
          "expect": "balanceOf(2)",
          "equals": 582005
        }
      ]
    },
    {
      "name": "a top-up is only a pending intent, in the reference's range ($1\u2013$10 000)",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "startTopUp",
          "args": [
            50
          ],
          "fails": "usd_cents out of range"
        },
        {
          "as": {
            "actor": "ada",
            "role": "member"
          },
          "run": "startTopUp",
          "args": [
            1000001
          ],
          "fails": "usd_cents out of range"
        },
        {
          "expect": "balanceOf(1)",
          "equals": 0
        }
      ]
    },
    {
      "name": "the provider webhook: a forged or unsigned delivery is refused (403) and credits nothing; a signed payment_intent.succeeded credits the pending intent once \u2014 $10.00 is 1 000 AET cents less the 2.5% deposit fee, 9.75 AET, the pool keeping 0.25; a replayed event (same id) answers 200 and moves nothing, even without the transport's idempotency key",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "PaymentIntent": [
              {
                "owner": 1,
                "ref": "pi_1",
                "usd_cents": 1000,
                "status": "pending",
                "created": 1
              }
            ]
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_1",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          },
          "forge": true,
          "status": 403
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_1",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          },
          "unsigned": true,
          "status": 403
        },
        {
          "expect": "balanceOf(1)",
          "equals": 0
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_1",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          }
        },
        {
          "expect": "balanceOf(1)",
          "equals": 9750000
        },
        {
          "expect": "PaymentIntent(1).status",
          "equals": "completed"
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_1",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_1",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1",
            "note": "re-sent"
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_2",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          }
        },
        {
          "expect": "balanceOf(1)",
          "equals": 9750000
        },
        {
          "expect": "count(PaymentEvent)",
          "equals": 2
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_1"
          },
          "status": 400,
          "fails": "missing event id"
        }
      ]
    },
    {
      "name": "the webhook's other outcomes: payment_failed marks the intent failed and a later success cannot credit it; an unknown intent and an unknown event type are acknowledged and move nothing",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "PaymentIntent": [
              {
                "owner": 1,
                "ref": "pi_2",
                "usd_cents": 1000,
                "status": "pending",
                "created": 1
              }
            ]
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_3",
            "event_type": "payment_intent.payment_failed",
            "intent": "pi_2"
          }
        },
        {
          "expect": "PaymentIntent(1).status",
          "equals": "failed"
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_4",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_2"
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_5",
            "event_type": "payment_intent.succeeded",
            "intent": "pi_unknown"
          }
        },
        {
          "webhook": "/hooks/payments",
          "body": {
            "event_id": "evt_6",
            "event_type": "charge.dispute.created",
            "intent": "pi_2"
          }
        },
        {
          "expect": "balanceOf(1) + balanceOf(2) + feePool",
          "equals": 0
        },
        {
          "expect": "count(PaymentEvent)",
          "equals": 4
        }
      ]
    },
    {
      "name": "an operator settles a stuck intent by hand, once; nobody else can",
      "steps": [
        {
          "seed": {
            "Account": [
              {
                "handle": "ada"
              },
              {
                "handle": "bob"
              }
            ]
          }
        },
        {
          "seed": {
            "PaymentIntent": [
              {
                "owner": 2,
                "ref": "pi_3",
                "usd_cents": 2000,
                "status": "pending",
                "created": 1
              }
            ]
          }
        },
        {
          "as": {
            "actor": "bob",
            "role": "member"
          },
          "run": "confirmIntent",
          "args": [
            "pi_3"
          ],
          "fails": "only an operator"
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "confirmIntent",
          "args": [
            "pi_3"
          ]
        },
        {
          "expect": "balanceOf(2)",
          "equals": 19500000
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "confirmIntent",
          "args": [
            "pi_3"
          ],
          "fails": "no pending intent"
        },
        {
          "seed": {
            "PaymentIntent": [
              {
                "owner": 2,
                "ref": "pi_4",
                "usd_cents": 500,
                "status": "pending",
                "created": 1
              }
            ]
          }
        },
        {
          "as": {
            "actor": "root",
            "role": "admin"
          },
          "run": "failIntent",
          "args": [
            "pi_4"
          ]
        },
        {
          "expect": "PaymentIntent(2).status",
          "equals": "failed"
        }
      ]
    }
  ]
}